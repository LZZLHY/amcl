{
  "$doc": "日志域注册表 —— 每个 tag 必须归属到一个已声明的域。scripts/check-log-domains.mjs 校验：源码里实际声明的 tag 全部登记，且登记表里没有已经不存在的死条目。",
  "$why": [
    "tag 此前是各调用点自由取的字符串，全仓 155 个，没有任何注册表。",
    "后果一：没法按模块设策略（级别、份额上限）—— 策略要有一个稳定的键才挂得上去。",
    "后果二：「谁在刷屏」只能靠正则事后统计，而不是查一次表。真机上一个 UI 页面占了启动器日志 72.9% 的字节，而没有任何机制能提前发现（施工记录 §S03.1）。"
  ],
  "$design": [
    "⭐ 刻意**不改调用点**。早先设想把 tag 换成 (domain, tag) 二元组，那要动 900+ 处。",
    "P2 已经教过一次同样的道理（合并根本不需要事件类别，§S05.1）：能用一张映射表解决的，不要做成一次全局重构。",
    "tag 字面量原样保留，本表负责 tag → domain 的映射。三条收益一条不少，改动面接近零。",
    "域的粒度按**子系统**切，不按目录切：UI 里的输入法组件归 input 而不是 ui，因为排障时问的是「输入出了什么问题」，不是「哪个文件夹」。"
  ],
  "version": 1,
  "domains": [
    { "id": "launch", "owner": "launch + entry/cpp/jvm", "purpose": "启动链：JVM 创建、MC 启动、profile 组装、JDK 选择、会话标记" },
    { "id": "download", "owner": "feature_core/download + entry/cpp/download", "purpose": "下载引擎与各下载阶段" },
    { "id": "render", "owner": "entry/cpp/glfw + entry/cpp/platform", "purpose": "渲染后端、GLFW 兼容层、EGL/Vulkan、窗口与帧率" },
    { "id": "input", "owner": "entry/cpp/input + gamecontrol", "purpose": "三端输入（触控/手柄/物理键鼠）、输入法与指针" },
    { "id": "account", "owner": "account", "purpose": "账户体系：离线/微软/外置登录与凭据存储" },
    { "id": "mods", "owner": "mods + feature_core/modloader", "purpose": "模组与整合包的检索、安装、依赖解析、加载器安装" },
    { "id": "version", "owner": "feature_core/version", "purpose": "版本元数据、合并、校验与修复" },
    { "id": "diagnostics", "owner": "commons + entry/components", "purpose": "日志系统自身：账本、导出、上传、崩溃与栈采样" },
    { "id": "storage", "owner": "feature_system", "purpose": "游戏目录、存档、相册与存储探测" },
    { "id": "platform", "owner": "commons + feature_system", "purpose": "设备能力、偏好、字体、网络图片等平台侧基础设施" },
    { "id": "runtime", "owner": "entry/cpp/{jvm,napi,glfw}", "purpose": "native 运行时基础设施：ELF 加载、JNI 注册、NAPI 桥、fork" },
    { "id": "update", "owner": "update + entry/components", "purpose": "应用自更新、更新日志与站内消息" },
    { "id": "ui", "owner": "entry/pages + entry/components", "purpose": "纯展示型页面与组件（不承载子系统逻辑的那些）" },
    { "id": "app", "owner": "entry/entryability + entry/gameability", "purpose": "应用生命周期：Ability 宿主、窗口装载、备份恢复" }
  ],
  "$staleExemptWhy": "这些 tag 声明在门禁扫描面之外（tests/ 只在诊断构建里编译），但它们**确实会出现在真机日志里** —— 真机 amcl_launcher.log 里 MG_RENDER_PROBE 占 2.6%。不登记的话按域聚合时它会变成「未登记」噪声；登记了又会被死条目检查判成过期。所以单列一个豁免名单，而不是放宽任一侧的判据。",
  "staleExempt": ["MG_RENDER_PROBE"],
