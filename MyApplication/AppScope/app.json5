{
  "app": {
    "bundleName": "com.amcl.launcher",
    "vendor": "dhao",
    "versionCode": 1000671,
    "versionName": "1.0.4",
    // 系统先按设备能力启用GL/GLES提供者；Minecraft后端仍由本局profile选择。
    // 必须在进程首次EGL调用前生效，不能在游戏启动后动态改写。
    "appEnvironments": [
      { "name": "NEED_OPENGL", "value": "1" }
    ],
    "icon": "$media:layered_image",
    "label": "$string:app_name"
  }
}
