FROM ubuntu:22.04

ENV DEBIAN_FRONTEND=noninteractive

# ============================================================
# AMCL openjdk-ohos-builder image
#
# 镜像只保存工具链；配方、stub 和补丁由 launch-builder.ps1 的只读挂载提供。
# 不再 COPY 编排脚本进 /build，避免实际执行与主仓不同的旧脚本。
# /build 使用本次独立 Linux 卷，输出映射到外部 .workspace/build/<id>/out。
# 镜像只安装 boot JDK 17；其他 JDK 仍需各自 boot JDK/compiler-rt 前提。
# 镜像构建成功不代表全部线上 JDK 已可复建。
# ============================================================

# 安装编译依赖 + clang-15 (与 OHOS NDK clang 15.0.4 版本匹配)
RUN apt-get update && apt-get install -y \
    build-essential autoconf automake libtool make cmake ninja-build \
    unzip zip curl wget git python3 pkg-config \
    libx11-dev libxext-dev libxrender-dev libxrandr-dev libxtst-dev libxt-dev \
    libcups2-dev libfontconfig1-dev libasound2-dev libfreetype6-dev \
    openjdk-17-jdk \
    file patchelf \
    clang-15 lld-15 llvm-15 \
    libc++-15-dev libc++abi-15-dev \
    && rm -rf /var/lib/apt/lists/*

# 创建 clang/llvm 工具的无版本后缀符号链接
RUN ln -sf /usr/bin/clang-15 /usr/bin/ohos-clang && \
    ln -sf /usr/bin/clang++-15 /usr/bin/ohos-clang++ && \
    ln -sf /usr/bin/lld-15 /usr/bin/ohos-lld && \
    ln -sf /usr/bin/ld.lld-15 /usr/bin/ld.lld && \
    ln -sf /usr/bin/llvm-ar-15 /usr/bin/ohos-ar && \
    ln -sf /usr/bin/llvm-ranlib-15 /usr/bin/ohos-ranlib && \
    ln -sf /usr/bin/llvm-strip-15 /usr/bin/ohos-strip && \
    ln -sf /usr/bin/llvm-objcopy-15 /usr/bin/ohos-objcopy && \
    ln -sf /usr/bin/llvm-nm-15 /usr/bin/ohos-nm && \
    ln -sf /usr/bin/llvm-objdump-15 /usr/bin/ohos-objdump && \
    ln -sf /usr/bin/llvm-readelf-15 /usr/bin/ohos-readelf

ENV JAVA_HOME=/usr/lib/jvm/java-17-openjdk-amd64
ENV OHOS_SYSROOT=/ohos-sysroot
ENV TOOLCHAIN_DIR=/ohos-toolchain

WORKDIR /build

CMD ["/bin/bash"]
