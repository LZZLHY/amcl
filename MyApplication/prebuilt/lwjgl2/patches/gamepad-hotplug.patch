+	/** 由 JInput 的连接对象身份判定插拔，同一设备保留校准/死区与未消费事件。 */
+	private static void refresh() {
+		net.java.games.input.Controller[] online = ControllerEnvironment.getDefaultEnvironment().getControllers();
+		boolean same = controllers.size() == online.length;
+		for (int i = 0; same && i < online.length; i++)
+			same = controllers.get(i).target == online[i];
+		if (same) return;
+		ArrayList<JInputController> next = new ArrayList<JInputController>();
+		for (net.java.games.input.Controller device : online) {
+			JInputController match = null;
+			for (JInputController active : controllers)
+				if (active.target == device) { match = active; break; }
+			if (match == null) match = new JInputController(next.size(), device);
+			match.index = next.size();
+			next.add(match);
+		}
+		// 旧连接最后轮询一次，释放已持有的轴与按钮；同槽新连接有独立的 JInput 对象。
+		for (JInputController previous : controllers)
+			if (!next.contains(previous)) previous.poll();
+		controllers = next;
 	}
 
