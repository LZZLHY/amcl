+++ b/src/java/org/lwjgl/opengl/EventQueue.java
@@ -80,4 +80,19 @@
 		} else
 			return false;
 	}
+	/**
+	 * AMCL字符pair的包内批量出口；不改变既有单条event_size或公开Keyboard ABI。
+	 * 在同一monitor中先验证完整记录与总剩余预算，再一次ByteBuffer bulk复制。
+	 * 拒绝时queue及源buffer的position/limit/内容均不变；成功才推进完整批次。
+	 * queue的私有存储不可充作源，避免自拷贝在容量判断前改变内部游标。
+	 */
+	synchronized boolean putEvents(ByteBuffer events) {
+		if (events == null || events == queue) return false;
+		final int bytes = events.remaining();
+		if (bytes == 0 || bytes % event_size != 0) return false;
+		if (queue.remaining() < bytes) return false;
+		queue.put(events);
+		return true;
+	}
