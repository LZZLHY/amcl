 {
     const AMCL_GraphicsObserverV1 *observer = data->role == OPENHARMONY_WINDOW_PRESENTED ? AMCL_GraphicsObserver() : NULL;
-    const Uint64 before = observer ? SDL_GetTicksNS() : 0;
+    const bool sample = AMCL_GraphicsSamplingEnabled(observer);
+    const Uint64 before = sample ? SDL_GetTicksNS() : 0;
     const bool result = SDL_EGL_SwapBuffersWithError(_this, data->egl_surface, error);
-    if (observer) observer->swapped("SDL3", SDL_GetTicksNS() - before, result ? 1 : 0, (uint32_t)*error);
+    if (observer) observer->swapped("SDL3", sample ? SDL_GetTicksNS() - before : 0, result ? 1 : 0, (uint32_t)*error);
     return result;
 }
 
@@ -75,6 +77,11 @@ static bool OPENHARMONY_AMCL_ObservedSwap(SDL_VideoDevice *_this, SDL_WindowData
 //   reporting an error of EGL_SUCCESS)
 static bool OPENHARMONY_GLES_NativeGlRequired(void)
 {
+    /* 宿主模式按冻结context协议选API；环境变更不改变MobileGL/系统GL的桌面语义。 */
+    if (AMCL_GraphicsRuntimeRequired()) {
+        const AmclGraphicsRuntimeV1 *runtime = AMCL_GraphicsRuntime();
+        return runtime && SDL_strcmp(runtime->contextApi, "desktop-gl") == 0;
