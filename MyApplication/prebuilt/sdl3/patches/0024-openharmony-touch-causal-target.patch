 #define AMCL_SDL_BRIDGE_ENV "AMCL_SDL_INPUT_BRIDGE"
 #define AMCL_SDL_BRIDGE_PREFIX "AMCLSDLV:3:"
 // 新宿主通过 NativeWindow broker 尾部发布前台资格，不再读可变环境快照。
+/* 旧AMCLSDLV/ORDER前缀不变；新增能力整体协商，存在但损坏必须拒绝，不能猜符号地址。 */
+static bool OPENHARMONY_ResolveTouchBridge(OPENHARMONY_HostBridge *bridge)
+{
+    const char *desc = SDL_getenv_unsafe("AMCL_SDL_TOUCH_BRIDGE");
+    const char *prefix = "AMCLSDLTOUCH:1:";
+    if (!desc) return true; /* 只有明确缺少尾协议时沿用旧宿主行为。 */
+    if (SDL_strncmp(desc, prefix, SDL_strlen(prefix)) != 0) return false;
+    const char *cursor = desc + SDL_strlen(prefix);
+    uintptr_t slots[2] = {0};
+    for (int i = 0; i < 2; ++i) {
+        char *end = NULL;
+        if (*cursor < '0' || *cursor > '9') return false;
+        const unsigned long long value = SDL_strtoull(cursor, &end, 10);
+        if (end == cursor || value == 0 || value >= UINTPTR_MAX) return false;
+        slots[i] = (uintptr_t)value;
+        cursor = end;
+        if (i == 0 && *cursor++ != ',') return false;
+    }
+    if (*cursor != '\0') return false;
+    bridge->SetInputTarget = (void (*)(Uint64, Uint64, Uint64))slots[0];
+    bridge->NotifyFramePresentedForTarget = (void (*)(Uint64, Uint64))slots[1];
+    return true;
+}
+
+/* 只发布已被窗口owner采纳的事实：SDL逻辑窗口ID与Native发布代次不是NativeWindow指针。
+ * neutral入口不执行游戏回调；重复当前身份幂等，同窗geometry变更也会退休旧菜单事务。
+ */
+static void OPENHARMONY_AMCL_PublishTouchInputTarget(OPENHARMONY_HostBridge *bridge,
+                                                    SDL_Window *window)
+{
+    if (!bridge || !bridge->SetInputTarget) return;
+    if (window && window->internal &&
+        window->internal->role == OPENHARMONY_WINDOW_PRESENTED &&
+        !window->internal->native_xcomponent && window->internal->amcl_generation) {
+        /* WSI创建入口实际使用nativeWindow高位身份域，SDL_WindowID与它不能相互替代。
+         * 此公式与neutral Vulkan createOhosSurface一致，只使用本窗口已取得的真实NativeWindow。 */
+        const bool vulkan = (window->flags & SDL_WINDOW_VULKAN) != 0;
+        const Uint64 wsi_identity = vulkan && window->internal->native_window
+            ? (Uint64)(uintptr_t)window->internal->native_window | (UINT64_C(1) << 63) : 0;
+        if (vulkan && !wsi_identity) {
+            bridge->SetInputTarget(0, 0, 0);
+            return;
+        }
+        bridge->SetInputTarget((Uint64)window->id, window->internal->amcl_generation, wsi_identity);
+    } else {
+        bridge->SetInputTarget(0, 0, 0);
+    }
+}
