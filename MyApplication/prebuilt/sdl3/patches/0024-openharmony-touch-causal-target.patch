+/* 环境解析失败以后，symbol fallback不能把损坏的新touch/legacy描述符当成旧宿主。
+ * 用临时表完成整体协商后才复制两个尾槽；失败零正式写入，不遗留一半能力。
+ * 新tail明确缺失保留旧行为；新tail完整但legacy env尚未发布，才允许已有符号路径。
+ */
+static bool OPENHARMONY_ValidateTouchFallback(OPENHARMONY_HostBridge *bridge)
+{
+    if (!SDL_getenv_unsafe("AMCL_SDL_TOUCH_BRIDGE")) {
+        bridge->SetInputTarget = NULL;
+        bridge->NotifyFramePresentedForTarget = NULL;
+        return true;
+    }
+    OPENHARMONY_HostBridge candidate;
+    SDL_zero(candidate);
+    if (!OPENHARMONY_ResolveTouchBridge(&candidate) ||
+        !OPENHARMONY_ResolveOrderBridge(&candidate) ||
+        SDL_getenv_unsafe(AMCL_SDL_BRIDGE_ENV)) return false;
+    bridge->SetInputTarget = candidate.SetInputTarget;
+    bridge->NotifyFramePresentedForTarget = candidate.NotifyFramePresentedForTarget;
+    bridge->InteractionFence = candidate.InteractionFence;
+    bridge->TypedNextThrough = candidate.TypedNextThrough;
+    bridge->LegacyPeekOrder = candidate.LegacyPeekOrder;
+    bridge->LegacyNextThrough = candidate.LegacyNextThrough;
+    bridge->pump_order_limit = UINT64_MAX;
+    return true;
+}
