 {
 #ifdef SDL_VIDEO_DRIVER_ANDROID
     EGLint format_wanted;
     EGLint format_got;
 #endif
     // max 16 key+value pairs, plus terminator.
     EGLint attribs[33];
     int attr = 0;
 
     EGLSurface surface;
 
     if (!SDL_EGL_ChooseConfig(_this)) {
         return EGL_NO_SURFACE;
     }
 
