     if (AMCL_GraphicsRuntimeRequired()) {
         const AmclGraphicsRuntimeV1 *runtime = AMCL_GraphicsRuntime();
         return runtime && SDL_strcmp(runtime->contextApi, "desktop-gl") == 0;
     }
     const char *native_gl = SDL_getenv("AMCL_NATIVE_GL_ACTIVE");
     return native_gl && SDL_strcmp(native_gl, "1") == 0;
