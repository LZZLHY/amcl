 bool SDL_EGL_SwapBuffersWithError(SDL_VideoDevice *_this,
                                   EGLSurface egl_surface,
                                   EGLint *egl_error)
 {
     if (egl_error) {
         *egl_error = EGL_SUCCESS;
     }
     if (!_this->egl_data->eglSwapBuffers(_this->egl_data->egl_display, egl_surface)) {
         const EGLint error = _this->egl_data->eglGetError();
         if (egl_error) {
             *egl_error = error;
         }
         return SDL_EGL_SetErrorEx("unable to show color buffer in an OS-native window",
                                   "eglSwapBuffers", error);
     }
     return true;
 }
 
