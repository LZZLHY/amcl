 void OPENHARMONY_SetWindowSize(SDL_VideoDevice *_this, SDL_Window *window)
 {
     if (window && OPENHARMONY_DesktopCommand(window,1,window->pending.w,window->pending.h,0,0,NULL)) return;
     if (!window || !window->internal) {
         return;
     }
 
     SDL_WindowData *data = window->internal;
     if (data->role == OPENHARMONY_WINDOW_AUXILIARY_PBUFFER) {
         data->pending_width = window->pending.w;
         data->pending_height = window->pending.h;
         if (data->is_current && data->owner_thread &&
             data->owner_thread != SDL_GetCurrentThreadID()) {
             return;
         }
         OPENHARMONY_ApplyPendingAuxiliaryResize(
             _this, window, SDL_GL_GetCurrentContext());
         return;
     }
 
     // The size is whatever the surface is. Prefer the value the host published
     // for the surface currently in use; fall back to what the window already
     // believes when there is no host-injected size (SDL owns the XComponent).
     int actual_w = window->internal->surface_width;
     int actual_h = window->internal->surface_height;
     if ((actual_w <= 0) || (actual_h <= 0)) {
         actual_w = window->w;
         actual_h = window->h;
     }
 
     if ((actual_w > 0) && (actual_h > 0)) {
         data->surface_width = actual_w;
         data->surface_height = actual_h;
         // Sent unconditionally, not only when it differs from the request: SDL
         // has already recorded pending.w/h from the caller, and this event is
         // what clears that pending state. Skipping it when the numbers happen
         // to match would leave the request outstanding.
         OPENHARMONY_SendGeometryEvents(window, actual_w, actual_h);
     }
 }
 
