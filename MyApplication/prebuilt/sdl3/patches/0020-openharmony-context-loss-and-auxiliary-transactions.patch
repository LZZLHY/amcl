 bool SDL_GL_MakeCurrent(SDL_Window *window, SDL_GLContext context)
 {
     bool result;
 
     if (!_this) {
         return SDL_UninitializedVideo();
     }
 
+#if defined(SDL_VIDEO_DRIVER_OPENHARMONY) && defined(SDL_VIDEO_OPENGL_EGL)
+    /* AMCL：同一绑定的快速返回不能绕过 OpenHarmony 的进程终局。只核对实际驱动，
+     * 不影响 dummy/offscreen 等其他后端，也不阻止 null context 的真实释放。 */
+    if (context && _this->GL_MakeCurrent == OPENHARMONY_GLES_MakeCurrent &&
+        !OPENHARMONY_GLES_ContextBindingAllowed(_this)) {
+        return false;
+    }
+#endif
     if (window == SDL_GL_GetCurrentWindow() &&
         context == SDL_GL_GetCurrentContext()) {
         // We're already current.
         return true;
     }
 
     if (!context) {
         window = NULL;
     } else if (window) {
         CHECK_WINDOW_MAGIC(window, false);
 
         if (!(window->flags & SDL_WINDOW_OPENGL)) {
             return SDL_SetError(NOT_AN_OPENGL_WINDOW);
         }
     } else if (!_this->gl_allow_no_surface) {
         return SDL_SetError("Use of OpenGL without a window is not supported on this platform");
     }
 
     result = _this->GL_MakeCurrent(_this, window, context);
     if (result) {
         _this->current_glwin = window;
         _this->current_glctx = context;
         SDL_SetTLS(&_this->current_glwin_tls, window, NULL);
         SDL_SetTLS(&_this->current_glctx_tls, context, NULL);
     }
     return result;
 }
 
