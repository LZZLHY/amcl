+/* 只在取得额外引用的同一宿主事务中读取身份；读完归还该引用，调用者本身的窗口租约
+ * 仍在。缺尾部返回未知 0，旧宿主保守重建；有尾部但竞态/失败也不能制造连续性。 */
+static inline bool AMCL_PresentationHasIdentity(const AMCL_NativeWindowLeaseBrokerV2 *broker)
+{
+    return broker && broker->structSize >= offsetof(AMCL_NativeWindowLeaseBrokerV2, movePresentationGeometry) +
+        sizeof(broker->movePresentationGeometry) && broker->acquireIdentity && broker->movePresentationGeometry && broker->release;
+}
+static inline uint64_t AMCL_PresentationResourceEpoch(const AMCL_NativeWindowLeaseBrokerV2 *broker,
+                                                    void *window, uint64_t generation)
+{
+    if (!AMCL_PresentationHasIdentity(broker)) return 0;
+    AMCL_NativeWindowIdentityV1 identity = { sizeof(identity), 1u, NULL, 0, 0, 0, 0, 0 };
+    const int acquired = broker->acquireIdentity(NULL, 0, &identity);
+    const uint64_t epoch = acquired == 1 && identity.nativeWindow == window &&
+        identity.generation == generation ? identity.resourceEpoch : 0;
+    if (acquired == 1 && identity.nativeWindow) broker->release(identity.nativeWindow);
+    return epoch;
+}
+static inline bool AMCL_PresentationCanPreserve(const AMCL_PresentationOwner *owner,
+                                               void *window, uint64_t generation)
+{
