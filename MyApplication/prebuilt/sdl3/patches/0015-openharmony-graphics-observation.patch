+/* AMCL 新增的只读图形观测接缝，按 SDL zlib 许可分发。没有宿主描述符时不改变 SDL 行为。 */
+#ifndef SDL_amclgraphicsobservation_h_
+#define SDL_amclgraphicsobservation_h_
+#include <stdint.h>
+#include <unistd.h>
+typedef struct AMCL_GraphicsObserverV1 {
+    uint32_t structSize, abiVersion;
+    uint64_t processId;
+    void (*presented)(const char *);
+    void (*swapped)(const char *, uint64_t, int, uint32_t);
+    void (*fatal)(const char *, uint32_t, uint64_t);
+    void (*foreground)(int);
+    const char *(*snapshot)(int);
+} AMCL_GraphicsObserverV1;
+
+/* 只解析一次同 PID 的只读描述符；fork 先比较 PID，不解引用父进程指针。成功帧计数
+ * 仍走已有 NotifyFramePresented，本接缝只补真实 swap 调用耗时与明确致命错误。 */
+static const AMCL_GraphicsObserverV1 *AMCL_GraphicsObserver(void)
+{
+    static void *cached;
+    const AMCL_GraphicsObserverV1 *value = (const AMCL_GraphicsObserverV1 *)SDL_GetAtomicPointer(&cached);
+    const uint64_t pid = (uint64_t)getpid();
+    if (value && value->processId == pid) return value;
+    const char *encoded = SDL_getenv_unsafe("AMCL_GRAPHICS_OBSERVER_V1");
+    unsigned long long owner_pid = 0;
+    void *address = NULL;
+    int consumed = 0;
+    if (!encoded || SDL_sscanf(encoded, "1:%llu:%p%n", &owner_pid, &address, &consumed) != 2 ||
+        encoded[consumed] || owner_pid != pid || !address) return NULL;
+    value = (const AMCL_GraphicsObserverV1 *)address;
+    if (value->abiVersion != 1u || value->structSize < sizeof(*value) || value->processId != pid ||
+        !value->swapped || !value->fatal) return NULL;
+    SDL_SetAtomicPointer(&cached, address);
+    return value;
+}
+#endif
