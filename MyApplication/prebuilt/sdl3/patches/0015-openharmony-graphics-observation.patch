+/* 观测真实驱动调用本身，辅助 pbuffer 不进入游戏呈现样本。该耗时不是 GPU 执行时间。 */
+static bool OPENHARMONY_AMCL_ObservedSwap(SDL_VideoDevice *_this, SDL_WindowData *data, EGLint *error)
+{
+    const AMCL_GraphicsObserverV1 *observer = data->role == OPENHARMONY_WINDOW_PRESENTED ? AMCL_GraphicsObserver() : NULL;
+    const Uint64 before = observer ? SDL_GetTicksNS() : 0;
+    const bool result = SDL_EGL_SwapBuffersWithError(_this, data->egl_surface, error);
+    if (observer) observer->swapped("SDL3", SDL_GetTicksNS() - before, result ? 1 : 0, (uint32_t)*error);
+    return result;
+}
 
