+// 单帧有界归并：所有外部回调后重新确认目标，未来事件留到下一帧。
+static void OPENHARMONY_PumpOrderedEvents(OPENHARMONY_HostBridge *bridge,
+                                         SDL_WindowID presented_id)
+{
+    const bool typed_relative_owner = OPENHARMONY_GetTypedNext(bridge) != NULL;
+        const Uint64 fence = bridge->InteractionFence();
+        bridge->pump_budget = 1;
+        for (int budget = 0; budget < AMCL_PUMP_BUDGET; ++budget) {
+            if (!OPENHARMONY_AMCL_IsPresentedActive() ||
+                !OPENHARMONY_AMCL_GetLiveInputWindow(presented_id)) break;
+            const Uint64 legacy_order = bridge->LegacyPeekOrder();
+            bridge->pump_order_limit = legacy_order < fence ? legacy_order : fence;
+            bridge->pump_did_read = false;
+            if (OPENHARMONY_GetTypedNext(bridge)) OPENHARMONY_PumpTypedEvents(bridge);
+            if (bridge->pump_did_read) continue;
+            if (legacy_order > fence && legacy_order != UINT64_MAX) break;
+            bridge->pump_order_limit = legacy_order <= fence ? legacy_order : fence;
+            OPENHARMONY_PumpHostEvents(bridge);
+            // MENU_POINTER 可能只推进坐标且无按钮输出；先送出位置，再选择下一条 typed 点击。
+            OPENHARMONY_PumpHostCursor(bridge, typed_relative_owner);
+            if (!bridge->pump_did_read && bridge->LegacyPeekOrder() == legacy_order) break;
+        }
+        bridge->pump_budget = 0;
+        bridge->pump_order_limit = UINT64_MAX;
+
 }
 
