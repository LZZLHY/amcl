+// 新宿主通过 NativeWindow broker 尾部发布前台资格，不再读可变环境快照。
+static bool OPENHARMONY_ResolveOrderBridge(OPENHARMONY_HostBridge *bridge)
+{
+    const char *desc = SDL_getenv_unsafe("AMCL_INPUT_ORDER_BRIDGE");
+    const char *prefix = "AMCLORDER:1:";
+    if (!desc) return true; /* 明确的旧宿主路径；存在但坏格式不能当作旧版本。 */
+    if (SDL_strncmp(desc, prefix, SDL_strlen(prefix)) != 0) return false;
+    const char *cursor = desc + SDL_strlen(prefix);
+    uintptr_t slots[4] = {0};
+    for (int i = 0; i < 4; ++i) {
+        char *end = NULL;
+        if (*cursor < '0' || *cursor > '9') return false;
+        const unsigned long long value = SDL_strtoull(cursor, &end, 10);
+        if (end == cursor || value == 0 || value > UINTPTR_MAX) return false;
+        slots[i] = (uintptr_t)value;
+        cursor = end;
+        if (i < 3) { if (*cursor++ != ',') return false; }
+    }
+    if (*cursor != '\0') return false;
+    bridge->InteractionFence = (Uint64 (*)(void))slots[0];
+    bridge->TypedNextThrough = (int (*)(Uint32, AMCL_BackendInputEvent *, Uint64))slots[1];
+    bridge->LegacyPeekOrder = (Uint64 (*)(void))slots[2];
+    bridge->LegacyNextThrough = (int (*)(int *, int *, int *, int *, int *, Uint64))slots[3];
+    bridge->pump_order_limit = UINT64_MAX;
+    return true;
+}
 
