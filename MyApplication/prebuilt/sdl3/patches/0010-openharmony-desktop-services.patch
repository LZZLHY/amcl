@@ -655,6 +659,8 @@ void OPENHARMONY_SetWindowSize(SDL_VideoDevice *_this, SDL_Window *window)
 
 bool OPENHARMONY_SetWindowPosition(SDL_VideoDevice *_this, SDL_Window *window)
 {
+    const int desktop = window ? OPENHARMONY_DesktopCommand(window,2,window->pending.x,window->pending.y,0,0,NULL) : 0;
+    if (desktop) return desktop > 0;
