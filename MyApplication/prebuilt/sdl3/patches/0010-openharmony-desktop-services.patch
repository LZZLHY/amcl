diff --git a/src/video/openharmony/SDL_amcldesktop.c b/src/video/openharmony/SDL_amcldesktop.c
new file mode 100644
index 000000000..00d6ed0b7
--- /dev/null
+++ b/src/video/openharmony/SDL_amcldesktop.c
@@ -0,0 +1,241 @@
+/* AMCL desktop embedding services; standalone/mobile SDL retains its original backend. */
+#include "SDL_internal.h"
+#include "SDL_amcldesktop.h"
+#ifdef SDL_AMCL_DESKTOP_HOST
+#include "desktop_host_api.h"
+#include "desktop_drop_packet.h"
+#include "../../events/SDL_dropevents_c.h"
+#include "SDL_openharmonywindow.h"
+#include "SDL_openharmonyvideo.h"
+#include "../../events/SDL_windowevents_c.h"
+#include "../../events/SDL_displayevents_c.h"
+#include <SDL3/SDL_joystick.h>
+#include <SDL3/SDL_gamepad.h>
+#include <SDL3/SDL_loadso.h>
+
+struct SDL_DisplayData { Sint64 native_id; };
+static SDL_DisplayID displays[AMCL_DESKTOP_MAX_DISPLAYS];
+static Sint64 native_displays[AMCL_DESKTOP_MAX_DISPLAYS];
+static SDL_JoystickID virtual_ids[16];
+static SDL_Joystick *virtual_handles[16];
+static Uint64 virtual_generations[16];
+static Uint64 fullscreen_sequence;
+static Uint64 last_event_epoch;
+static int fullscreen_status;
+static bool close_notified;
+static const AmclDesktopHostV1 *DesktopHost(void)
+{
+    typedef const AmclDesktopHostV1 *(*Resolve)(void);
+    static SDL_SharedObject *module;
+    static Resolve resolve;
+    if (!module) {
+        module = SDL_LoadObject("libglfw.so");
+        if (!module) { SDL_ClearError(); return NULL; }
+        resolve = (Resolve)SDL_LoadFunction(module, "amclDesktopHostResolve");
+        if (!resolve) SDL_ClearError();
+    }
+    const AmclDesktopHostV1 *api = resolve ? resolve() : NULL;
+    if (!api || api->magic != AMCL_DESKTOP_HOST_MAGIC || api->size != sizeof(*api)) return NULL;
+    return api;
+}
+bool OPENHARMONY_DesktopAvailable(void) { return DesktopHost() != NULL; }
+static bool Presented(SDL_Window *window)
+{
+    return window && window->internal && window->internal->role == OPENHARMONY_WINDOW_PRESENTED;
+}
+int OPENHARMONY_DesktopCommand(SDL_Window *window, int kind, int a, int b, int c, int d, const char *text)
+{
+    const AmclDesktopHostV1 *api = DesktopHost();
+    if (!api || !Presented(window)) return 0;
+    const Uint64 sequence = api->submit(kind,a,b,c,d,text);
+    if (!sequence) { SDL_SetError("Desktop window command rejected (kind=%d)",kind); return -1; }
+    if (kind == AMCL_DESKTOP_FULLSCREEN) { fullscreen_sequence=sequence; fullscreen_status=a?1:0; }
+    return 1;
+}
+int OPENHARMONY_DesktopFullscreen(SDL_Window *window, SDL_VideoDisplay *display, bool enabled)
+{
+    const int id=display && display->internal ? (int)display->internal->native_id : -1;
+    return OPENHARMONY_DesktopCommand(window,AMCL_DESKTOP_FULLSCREEN,enabled,id,0,0,NULL);
+}
+static SDL_DisplayMode DisplayMode(const AmclDesktopDisplay *info)
+{
+    SDL_DisplayMode mode; SDL_zero(mode);
+    mode.format=SDL_PIXELFORMAT_BGRA8888; mode.w=info->width; mode.h=info->height;
+    mode.refresh_rate=info->refreshRate; mode.pixel_density=1.0f;
+    return mode;
+}
+static bool DisplayInfo(SDL_VideoDisplay *display, AmclDesktopDisplay *result)
+{
+    const AmclDesktopHostV1 *api=DesktopHost(); if (!api || !display || !display->internal) return false;
+    AmclDesktopSnapshot facts; api->snapshot(&facts);
+    for (int i=0;i<facts.displayCount;++i) if(facts.displays[i].id==display->internal->native_id) { *result=facts.displays[i]; return true; }
+    return false;
+}
+static bool DisplayBounds(SDL_VideoDevice *device, SDL_VideoDisplay *display, SDL_Rect *rect)
+{
+    (void)device; AmclDesktopDisplay info;
+    if(!DisplayInfo(display,&info)) return SDL_SetError("Desktop display disconnected");
+    rect->x=info.x;rect->y=info.y;rect->w=info.width;rect->h=info.height;return true;
+}
+static bool DisplayWorkArea(SDL_VideoDevice *device, SDL_VideoDisplay *display, SDL_Rect *rect)
+{
+    (void)device; AmclDesktopDisplay info;
+    if(!DisplayInfo(display,&info)) return SDL_SetError("Desktop display disconnected");
+    rect->x=info.workX;rect->y=info.workY;rect->w=info.workWidth;rect->h=info.workHeight;return true;
+}
+static void SyncDisplays(bool notify)
+{
+    const AmclDesktopHostV1 *api=DesktopHost(); if(!api)return;
+    AmclDesktopSnapshot facts;api->snapshot(&facts);
+    for(int slot=0;slot<AMCL_DESKTOP_MAX_DISPLAYS;++slot) {
+        if(!displays[slot])continue;bool found=false;
+        for(int i=0;i<facts.displayCount;++i)if(native_displays[slot]==facts.displays[i].id)found=true;
+        if(!found){SDL_DelVideoDisplay(displays[slot],notify);displays[slot]=0;}
+    }
+    for(int i=0;i<facts.displayCount;++i) {
+        int slot=-1;
+        for(int j=0;j<AMCL_DESKTOP_MAX_DISPLAYS;++j)if(displays[j] && native_displays[j]==facts.displays[i].id){slot=j;break;}
+        SDL_DisplayMode mode=DisplayMode(&facts.displays[i]);
+        if(slot<0) {
+            for(int j=0;j<AMCL_DESKTOP_MAX_DISPLAYS;++j)if(!displays[j]){slot=j;break;}
+            if(slot<0)continue;
+            SDL_VideoDisplay display;SDL_zero(display);
+            display.name=facts.displays[i].name;display.desktop_mode=mode;display.content_scale=facts.displays[i].scale;
+            display.internal=(SDL_DisplayData*)SDL_calloc(1,sizeof(SDL_DisplayData));
+            if(!display.internal)continue;
+            display.internal->native_id=facts.displays[i].id;
+            SDL_DisplayID id=SDL_AddVideoDisplay(&display,notify);
+            if(!id){SDL_free(display.internal);continue;}
+            displays[slot]=id;native_displays[slot]=facts.displays[i].id;
+        } else {
+            SDL_VideoDisplay *display=SDL_GetVideoDisplay(displays[slot]);
+            if(display){
+                if(display->desktop_mode.w!=mode.w || display->desktop_mode.h!=mode.h || display->desktop_mode.refresh_rate!=mode.refresh_rate){
+                    SDL_ResetFullscreenDisplayModes(display);SDL_SetDesktopDisplayMode(display,&mode);
+                }
+                SDL_SetDisplayContentScale(display,facts.displays[i].scale);
+            }
+        }
+    }
+}
+bool OPENHARMONY_DesktopVideoInit(SDL_VideoDevice *device)
+{
+    (void)device;SDL_zeroa(displays);SDL_zeroa(native_displays);SyncDisplays(false);
+    return displays[0] != 0;
+}
+static void Maximize(SDL_VideoDevice *device,SDL_Window *window){(void)device;OPENHARMONY_DesktopCommand(window,AMCL_DESKTOP_MAXIMIZE,0,0,0,0,NULL);}
+static void Restore(SDL_VideoDevice *device,SDL_Window *window){(void)device;OPENHARMONY_DesktopCommand(window,AMCL_DESKTOP_RESTORE,0,0,0,0,NULL);}
+static void Raise(SDL_VideoDevice *device,SDL_Window *window){(void)device;OPENHARMONY_DesktopCommand(window,AMCL_DESKTOP_SHOW,0,0,0,0,NULL);}
+static void Bordered(SDL_VideoDevice *device,SDL_Window *window,bool value){(void)device;OPENHARMONY_DesktopCommand(window,AMCL_DESKTOP_DECORATED,value,0,0,0,NULL);}
+static void Limits(SDL_VideoDevice *device,SDL_Window *window){(void)device;OPENHARMONY_DesktopCommand(window,AMCL_DESKTOP_LIMITS,window->min_w,window->min_h,window->max_w,window->max_h,NULL);}
+static bool Borders(SDL_VideoDevice *device,SDL_Window *window,int *top,int *left,int *bottom,int *right)
+{
+    (void)device;const AmclDesktopHostV1 *api=DesktopHost();if(!api||!Presented(window))return false;
+    AmclDesktopSnapshot f;api->snapshot(&f);*top=f.frameTop;*left=f.frameLeft;*bottom=f.frameBottom;*right=f.frameRight;return true;
+}
+static bool SetClipboard(SDL_VideoDevice *device,const char *text)
+{
+    (void)device;const AmclDesktopHostV1 *api=DesktopHost();
+    return api && api->clipboardWrite(text)==0 ? true : SDL_SetError("System clipboard write failed");
+}
+static char *GetClipboard(SDL_VideoDevice *device)
+{
+    (void)device;const AmclDesktopHostV1 *api=DesktopHost();if(!api)return NULL;
+    char *text=(char*)SDL_malloc(4*1024*1024+1);if(!text)return NULL;
+    if(api->clipboardRead(text,4*1024*1024+1)<0){SDL_free(text);SDL_SetError("System clipboard read failed or permission denied");return NULL;}
+    return text;
+}
+static void DropVirtual(int i)
+{
+    if(SDL_WasInit(SDL_INIT_JOYSTICK)){
+        if(virtual_handles[i] && SDL_GetJoystickFromID(virtual_ids[i])==virtual_handles[i])SDL_CloseJoystick(virtual_handles[i]);
+        if(virtual_ids[i] && SDL_IsJoystickVirtual(virtual_ids[i]))SDL_DetachVirtualJoystick(virtual_ids[i]);
+    }
+    virtual_handles[i]=NULL;virtual_ids[i]=0;virtual_generations[i]=0;
+}
+static void PumpGamepads(const AmclDesktopHostV1 *api)
+{
+    if(!SDL_WasInit(SDL_INIT_JOYSTICK))return;
+    static const int buttons[18]={0,1,2,3,6,8,7,9,10,4,5,11,13,14,12,15,16,17};
+    for(int i=0;i<16;++i){
+        AmclDesktopGamepad pad;SDL_zero(pad);const bool connected=api->gamepadRead(i,&pad)!=0;
+        if(virtual_ids[i] && (!connected || pad.generation!=virtual_generations[i]))DropVirtual(i);
+        if(virtual_ids[i] && SDL_GetJoystickFromID(virtual_ids[i])!=virtual_handles[i]) {virtual_ids[i]=0;virtual_handles[i]=NULL;SDL_ClearError();}
+        if(!connected)continue;
+        if(!virtual_ids[i]){
+            SDL_VirtualJoystickDesc desc;SDL_INIT_INTERFACE(&desc);
+            desc.type=SDL_JOYSTICK_TYPE_GAMEPAD;desc.naxes=6;desc.nbuttons=18;desc.nhats=1;
+            desc.axis_mask=0x3f;desc.button_mask=0x3ffff;desc.name=pad.name;
+            virtual_ids[i]=SDL_AttachVirtualJoystick(&desc);
+            if(!virtual_ids[i])continue;
+            virtual_handles[i]=SDL_OpenJoystick(virtual_ids[i]);virtual_generations[i]=pad.generation;
+            if(!virtual_handles[i]){DropVirtual(i);continue;}
+        }
+        for(int axis=0;axis<6;++axis){const float v=SDL_clamp(pad.axes[axis],-1.0f,1.0f);SDL_SetJoystickVirtualAxis(virtual_handles[i],axis,(Sint16)(v<0?v*32768.0f:v*32767.0f));}
+        for(int button=0;button<18;++button)SDL_SetJoystickVirtualButton(virtual_handles[i],button,pad.buttons[buttons[button]]!=0);
+        SDL_SetJoystickVirtualHat(virtual_handles[i],0,pad.hats[0]);
+    }
+}
+void OPENHARMONY_DesktopPump(SDL_VideoDevice *device)
+{
+    const AmclDesktopHostV1 *api=DesktopHost();if(!api)return;
+    last_event_epoch=api->eventEpoch();
+    SyncDisplays(true);PumpGamepads(api);
+    SDL_Window *window=OPENHARMONY_GetPresentedWindow(device);if(!window)return;
+    AmclDesktopSnapshot f;api->snapshot(&f);
+    if(!f.active)return;
+    char packet[65536]; const char *paths[32];
+    for(int batch=0;batch<8;++batch){
+        const int bytes=api->takeDrop(packet,sizeof(packet));if(bytes<=0)break;
+        const int count=amclDecodeDesktopDrop(packet,(size_t)bytes,paths,32);
+        if(count>0){for(int i=0;i<count;++i)SDL_SendDropFile(window,"AMCL",paths[i]);SDL_SendDropComplete(window);}
+    }
+    SDL_SendWindowEvent(window,SDL_EVENT_WINDOW_MOVED,f.x,f.y);
+    if(fullscreen_sequence && f.completed>=fullscreen_sequence){
+        if((f.status==1)!=(fullscreen_status!=0)) SDL_SetError("System rejected fullscreen transition (code=%d)",f.lastError);
+        fullscreen_sequence=0;
+    }
+    // Reconcile both application requests and title-bar transitions from system facts.
+    // A rejected request must not leave SDL advertising a pending fullscreen mode.
+    if(!fullscreen_sequence) {
+        window->pending_flags=(window->pending_flags & ~SDL_WINDOW_FULLSCREEN) | (f.status==1?SDL_WINDOW_FULLSCREEN:0);
+        SDL_SendWindowEvent(window,f.status==1?SDL_EVENT_WINDOW_ENTER_FULLSCREEN:SDL_EVENT_WINDOW_LEAVE_FULLSCREEN,0,0);
+        for(int i=0;i<AMCL_DESKTOP_MAX_DISPLAYS;++i) {
+            SDL_VideoDisplay *display=displays[i]?SDL_GetVideoDisplay(displays[i]):NULL;
+            if(!display)continue;
+            if(f.status==1 && native_displays[i]==f.displayId)display->fullscreen_window=window;
+            else if(display->fullscreen_window==window){display->fullscreen_window=NULL;display->fullscreen_active=false;}
+        }
+    }
+    if(f.status==2 && !(window->flags&SDL_WINDOW_MAXIMIZED))SDL_SendWindowEvent(window,SDL_EVENT_WINDOW_MAXIMIZED,0,0);
+    else if(f.status!=2 && f.status!=3 && (window->flags&SDL_WINDOW_MAXIMIZED))SDL_SendWindowEvent(window,SDL_EVENT_WINDOW_RESTORED,0,0);
+    if(f.status==3 && !(window->flags&SDL_WINDOW_MINIMIZED))SDL_SendWindowEvent(window,SDL_EVENT_WINDOW_MINIMIZED,0,0);
+    else if(f.status!=3 && (window->flags&SDL_WINDOW_MINIMIZED))SDL_SendWindowEvent(window,SDL_EVENT_WINDOW_RESTORED,0,0);
+    for(int i=0;i<AMCL_DESKTOP_MAX_DISPLAYS;++i)if(displays[i] && native_displays[i]==f.displayId){
+        SDL_SendWindowEvent(window,SDL_EVENT_WINDOW_DISPLAY_CHANGED,(int)displays[i],0);break;
+    }
+    if(f.closeRequested && !close_notified){close_notified=true;SDL_SendWindowEvent(window,SDL_EVENT_WINDOW_CLOSE_REQUESTED,0,0);}
+    if(!f.closeRequested)close_notified=false;
+}
+void OPENHARMONY_DesktopQuit(void)
+{
+    for(int i=0;i<16;++i)DropVirtual(i);
+    SDL_zeroa(displays);SDL_zeroa(native_displays);fullscreen_sequence=0;close_notified=false;
+}
+static int WaitDesktopEvents(SDL_VideoDevice *device, Sint64 timeoutNS) {
+    (void)device; const AmclDesktopHostV1 *api=DesktopHost();
+    return api?api->waitEvents(last_event_epoch,timeoutNS):0;
+}
+static void WakeDesktopEvents(SDL_VideoDevice *device, SDL_Window *window) {
+    (void)device;(void)window;const AmclDesktopHostV1 *api=DesktopHost();if(api)api->wakeEvents();
+}
+void OPENHARMONY_DesktopInstall(SDL_VideoDevice *device)
+{
+    if(!OPENHARMONY_DesktopAvailable())return;
+    device->WaitEventTimeout=WaitDesktopEvents;device->SendWakeupEvent=WakeDesktopEvents;
+    device->GetDisplayBounds=DisplayBounds;device->GetDisplayUsableBounds=DisplayWorkArea;
+    device->MaximizeWindow=Maximize;device->RestoreWindow=Restore;device->RaiseWindow=Raise;
+    device->SetWindowBordered=Bordered;device->SetWindowMinimumSize=Limits;device->SetWindowMaximumSize=Limits;
+    device->GetWindowBordersSize=Borders;device->SetClipboardText=SetClipboard;device->GetClipboardText=GetClipboard;
+}
+#endif
