diff --git a/src/video/openharmony/SDL_openharmonyopengl.c b/src/video/openharmony/SDL_openharmonyopengl.c
index 278c69423..29b8650f8 100644
--- a/src/video/openharmony/SDL_openharmonyopengl.c
+++ b/src/video/openharmony/SDL_openharmonyopengl.c
@@ -31,6 +31,81 @@
 #include "SDL_openharmonyevents.h"
 #include "SDL_openharmonyopengl.h"
 #include "../../core/openharmony/SDL_openharmony.h"
+#include "SDL_openharmonyamcl.h"
+
+// ===========================================================================
+// Desktop-GL requests on a platform that only has EGL/GLES
+// ===========================================================================
+// OpenHarmony's EGL implementation exposes no desktop-GL-renderable config: it
+// is a GLES-only EGL. SDL's common EGL layer honours the requested profile
+// literally -- for anything other than SDL_GL_CONTEXT_PROFILE_ES it asks
+// eglChooseConfig for EGL_OPENGL_BIT and calls eglBindAPI(EGL_OPENGL_API)
+// (SDL_egl.c, "attribs[i++] = EGL_OPENGL_BIT"). On this platform that request
+// matches zero configs, so window creation fails with
+// "Couldn't find matching EGL config", even though the caller could have been
+// served perfectly well.
+//
+// That failure is what an application which drives desktop GL through a
+// translation layer (GL -> GLES) runs into: the translator is itself a GLES
+// client, so the EGL surface and context it needs are GLES ones, while the API
+// it presents upwards is desktop GL. The profile the application asked for
+// describes the API it wants to *call*, not the client type EGL must create.
+//
+// So: try the request as written, and only if the platform cannot satisfy it,
+// retry as GLES. This is a fallback, not a substitution -- if some future
+// OpenHarmony device does advertise desktop-GL configs, the literal request
+// wins and nothing here changes behaviour.
+//
+// 2026-08-04 device evidence (MatePad Pro, OpenHarmony 6.1.1.120), Minecraft
+// 26.3 requesting GL 3.3 core + forward-compatible:
+//   BackendCreationException: Failed to create window with OpenGL context:
+//   Couldn't find matching EGL config (call to eglChooseConfig failed,
+//   reporting an error of EGL_SUCCESS)
+void OPENHARMONY_GLES_EnsureUsableProfile(SDL_VideoDevice *_this)
+{
+    if (!_this || !_this->egl_data) {
+        return;  // nothing loaded yet; nothing to reconcile.
+    }
+
+    if (_this->gl_config.profile_mask == SDL_GL_CONTEXT_PROFILE_ES) {
+        return;  // already asking for what this platform has.
+    }
+
+    // Ask the driver, do not assume. SDL_EGL_ChooseConfig() leaves the chosen
+    // config in egl_data on success, so a successful probe is also the work the
+    // surface creation path would have done anyway.
+    if (SDL_EGL_ChooseConfig(_this)) {
+        return;  // the platform really does have a desktop-GL config.
+    }
+
+    // The probe failed and set an error string describing the desktop-GL
+    // attempt. Clear it: we are about to succeed, and a stale message here
