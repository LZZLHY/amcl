 void OPENHARMONY_PumpEvents(SDL_VideoDevice *_this)
 {
+    (void)_this;
+
+    // Input normally arrives asynchronously through the XComponent callbacks
+    // above, so there is nothing to poll for in the standalone case.
+    //
+    // When SDL is embedded in a host that owns the XComponent, those callbacks
+    // are never registered and this is the only place input can enter: drain
