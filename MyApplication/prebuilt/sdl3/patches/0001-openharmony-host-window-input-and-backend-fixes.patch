+#ifndef SDL_openharmonyamcl_h_
+#define SDL_openharmonyamcl_h_
+
+// Host-driven input for embedded use (see SDL_openharmonyamcl.c for rationale).
+//
+// When SDL is loaded by a host application that owns the XComponent itself,
+// SDL never registers the XComponent callbacks, so the Dispatch*Event()
+// entry points in SDL_openharmonyevents.c are never reached. These helpers
+// let the OpenHarmony backend pull input from the host's event ring instead.
+//
+// All of them are safe no-ops when no host bridge is present, so a plain
+// (non-embedded) SDL application is unaffected.
+
+// Pull whatever the host has queued and inject it into SDL. Called from
+// OPENHARMONY_PumpEvents(), i.e. on the thread that calls SDL_PollEvent().
+extern void OPENHARMONY_AMCL_PumpEvents(void);
+extern void OPENHARMONY_AMCL_NotifyFramePresented(void);
+
+// Wire up the mouse driver hooks that map onto the host's grab state.
+extern void OPENHARMONY_AMCL_InitMouse(void);
+extern void OPENHARMONY_AMCL_QuitMouse(void);
