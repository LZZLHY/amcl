diff --git a/src/video/openharmony/SDL_amclphoneclipboard.c b/src/video/openharmony/SDL_amclphoneclipboard.c
new file mode 100644
index 000000000..5fcdc7d2d
--- /dev/null
+++ b/src/video/openharmony/SDL_amclphoneclipboard.c
@@ -0,0 +1,46 @@
+/* 在 SDL 保存游戏剪贴板数据后，尽力同步手机系统的纯文本剪贴板。 */
+#include "SDL_internal.h"
+#include "SDL_amclphoneclipboard.h"
+
+#include <database/pasteboard/oh_pasteboard.h>
+#include <database/udmf/udmf.h>
+#include <database/udmf/uds.h>
+
+#define AMCL_PHONE_CLIPBOARD_MAX_BYTES (4u * 1024u * 1024u)
+
+bool OPENHARMONY_AMCL_MirrorPhoneClipboardText(struct SDL_VideoDevice *device, const char *text)
+{
+    (void)device;
+    if (!text || !*text || SDL_strnlen(text, AMCL_PHONE_CLIPBOARD_MAX_BYTES + 1u) > AMCL_PHONE_CLIPBOARD_MAX_BYTES) {
+        return true;
+    }
+
+    OH_Pasteboard *board = OH_Pasteboard_Create();
+    OH_UdmfData *data = OH_UdmfData_Create();
+    OH_UdmfRecord *record = OH_UdmfRecord_Create();
+    OH_UdsPlainText *plain = OH_UdsPlainText_Create();
+    int result = -1;
+    if (board && data && record && plain &&
+        OH_UdsPlainText_SetContent(plain, text) == 0 &&
+        OH_UdmfRecord_AddPlainText(record, plain) == 0 &&
+        OH_UdmfData_AddRecord(data, record) == 0) {
+        result = OH_Pasteboard_SetData(board, data);
+    }
+    if (plain) {
+        OH_UdsPlainText_Destroy(plain);
+    }
+    if (record) {
+        OH_UdmfRecord_Destroy(record);
+    }
+    if (data) {
+        OH_UdmfData_Destroy(data);
+    }
+    if (board) {
+        OH_Pasteboard_Destroy(board);
+    }
+    if (result != 0) {
+        SDL_LogWarn(SDL_LOG_CATEGORY_SYSTEM, "AMCL phone system clipboard write failed");
+    }
+    // SDL 内存剪贴板已保存。系统写失败不改变游戏的剪贴板返回语义。
+    return true;
+}
