 static bool SDL_bInMainQuit = false;
 static Uint8 SDL_SubsystemRefCount[32];
 
+#ifdef SDL_PLATFORM_OPENHARMONY
+/*
+ * 每份实际 SDL 映像保存自己的 main-ready；宿主不 dlopen 另一份对象做旁路准备。
+ * 自旋锁只覆盖描述符消费和 SetMainReady，不跨越子系统递归、日志或外部回调。
+ * 原子 mode/pump 标记供事件泵低成本检查，避免逐帧 getenv/解析或 gettid 系统调用。
+ */
+static AMCL_SdlHostRuntime SDL_amclHostRuntime;
+static SDL_SpinLock SDL_amclHostLock;
+static SDL_AtomicInt SDL_amclHostMode;
+static SDL_AtomicInt SDL_amclHostPumpObserved;
+
+/* 返回错误保留阶段和数值原因，调用方不得吞掉错误继续初始化子系统。 */
+static bool SDL_AMCL_HostError(const char *phase, int result)
+{
+    return SDL_SetError("AMCL SDL host-runtime %s rejected (%d): ABI/PID/thread/session mismatch or process restart required", phase, result);
+}
+
+/*
+ * 真实 InitSubSystem 的第一步：先严格验证，再在同一实例、允许线程上设置 main-ready。
+ * SDL 的线程 ID 是 pthread 身份，不能与描述符 Linux TID 混比；两者分别记录。
+ * 前人通过 SetMainReady 或 InitMainThread 已绑定其他线程时明确失败，不覆盖事实。
+ */
+static bool SDL_AMCL_PrepareHostRuntime(void)
+{
+    const uint64_t pid = (uint64_t)getpid();
+    const uint64_t tid = (uint64_t)syscall(SYS_gettid);
+    const SDL_ThreadID thread = SDL_GetCurrentThreadID();
+    int result;
+    uint64_t session;
+    SDL_LockSpinlock(&SDL_amclHostLock);
+    result = AMCL_SdlHostPrepare(&SDL_amclHostRuntime,
+        SDL_getenv_unsafe("AMCL_SDL_HOST_RUNTIME"), pid, tid);
+    session = SDL_amclHostRuntime.session;
+    if (result > 0 && SDL_MainThreadID && SDL_MainThreadID != thread) {
+        /* 本实例已被其他主线程占用，永久退休；不容许外部改写后通过 READY 重试。 */
+        SDL_amclHostRuntime.state = 3;
+        SDL_SetAtomicInt(&SDL_amclHostMode, -1);
+        result = AMCL_SDL_HOST_WRONG_THREAD;
+    }
+    if (result == AMCL_SDL_HOST_FIRST) {
+        SDL_SetMainReady();
+        SDL_SetAtomicInt(&SDL_amclHostMode, 1);
+    }
+    SDL_UnlockSpinlock(&SDL_amclHostLock);
+    if (result < 0) {
+        return SDL_AMCL_HostError("prepare", result);
+    }
+    if (result == AMCL_SDL_HOST_FIRST) {
+        SDL_LogInfo(SDL_LOG_CATEGORY_SYSTEM,
+            "[AMCL-SDL-HOST] phase=main-ready instance=%p pid=%llu tid=%llu session=%llu main=%llu",
+            (void *)&SDL_amclHostRuntime, (unsigned long long)pid, (unsigned long long)tid,
+            (unsigned long long)session, (unsigned long long)SDL_MainThreadID);
+    }
+    return true;
+}
+
+/* SDL_Quit 是整局终点；不能靠保留的 SDL_MainIsReady 复活已退休游戏会话。 */
+static bool SDL_AMCL_RetireHostRuntime(void)
+{
+    int result;
+    SDL_LockSpinlock(&SDL_amclHostLock);
+    result = AMCL_SdlHostRetire(&SDL_amclHostRuntime,
+        SDL_getenv_unsafe("AMCL_SDL_HOST_RUNTIME"), (uint64_t)getpid(), (uint64_t)syscall(SYS_gettid));
+    if (result > 0) {
+        SDL_SetAtomicInt(&SDL_amclHostMode, -1);
+    }
+    SDL_UnlockSpinlock(&SDL_amclHostLock);
+    return result < 0 ? SDL_AMCL_HostError("quit", result) : true;
+}
+
+/*
+ * 主线程约束也作用于 release 事件泵，不依赖可能被编译移除的 SDL_assert。
+ * 模式通过原子发布，main 身份在整局内不变；首次合法泵记录三类线程供设备对账。
+ */
+bool SDL_AMCL_ValidateEventThread(bool observe_pump)
+{
+    const int mode = SDL_GetAtomicInt(&SDL_amclHostMode);
+    if (!mode) {
+        return true;
+    }
+    if (mode < 0 || SDL_GetCurrentThreadID() != SDL_MainThreadID) {
+        return SDL_AMCL_HostError("event-pump", mode < 0 ? AMCL_SDL_HOST_RETIRED : AMCL_SDL_HOST_WRONG_THREAD);
+    }
+    if (observe_pump && SDL_CompareAndSwapAtomicInt(&SDL_amclHostPumpObserved, 0, 1)) {
+        SDL_LogInfo(SDL_LOG_CATEGORY_SYSTEM,
+            "[AMCL-SDL-HOST] phase=event-pump instance=%p tid=%llu main=%llu events=%llu video=%llu",
+            (void *)&SDL_amclHostRuntime, (unsigned long long)syscall(SYS_gettid),
+            (unsigned long long)SDL_MainThreadID, (unsigned long long)SDL_EventsThreadID,
+            (unsigned long long)SDL_VideoThreadID);
+    }
+    return true;
+}
