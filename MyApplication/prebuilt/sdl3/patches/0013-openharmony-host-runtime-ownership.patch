--- /dev/null
+++ b/src/core/openharmony/SDL_amclhostruntime.h
@@ -0,0 +1,140 @@
+/*
+ * AMCL 下游宿主初始化契约，不属于 SDL 上游实现。
+ * 只处理十进制身份和本实例生命周期，不读取指针、不加载 Java 类或外部库。
+ * 调用者必须在短临界区内串行访问状态；不能把整个 SDL_InitSubSystem 加锁，
+ * 因为 video/audio 初始化可以合法地递归请求 events 子系统。
+ */
+#ifndef SDL_amclhostruntime_h_
+#define SDL_amclhostruntime_h_
+
+#include <stdint.h>
+#include <stdbool.h>
+
+typedef struct AMCL_SdlHostRuntime
+{
+    uint64_t pid;
+    uint64_t tid;
+    uint64_t session;
+    /* 0 未消费，1 已选择 standalone，2 宿主 main-ready，3 已退休。 */
+    unsigned int state;
+} AMCL_SdlHostRuntime;
+
+enum AMCL_SdlHostResult
+{
+    AMCL_SDL_HOST_STANDALONE = 0,
+    AMCL_SDL_HOST_FIRST = 1,
+    AMCL_SDL_HOST_READY = 2,
+    AMCL_SDL_HOST_MALFORMED = -1,
+    AMCL_SDL_HOST_WRONG_PID = -2,
+    AMCL_SDL_HOST_WRONG_THREAD = -3,
+    AMCL_SDL_HOST_CHANGED = -4,
+    AMCL_SDL_HOST_RETIRED = -5
+};
+
+/*
+ * 严格消费一个正十进制字段及其分隔符；拒绝符号、空白、零、前导零和溢出。
+ * 每次最多读取 20 个数字，故畸形超长环境变量不会导致无界扫描。
+ * 失败时不提交游标或输出值；最后字段必须直接以 NUL 结束。
+ */
+static inline int AMCL_SdlHostReadNumber(const char **cursor, char delimiter, uint64_t *value)
+{
+    const char *p = *cursor;
+    uint64_t result = 0;
+    unsigned int digits = 0;
+    if (*p < '1' || *p > '9') {
+        return 0;
+    }
+    while (*p >= '0' && *p <= '9') {
+        const uint64_t digit = (uint64_t)(*p - '0');
+        if (++digits > 20 || result > (UINT64_MAX - digit) / 10) {
+            return 0;
+        }
+        result = result * 10 + digit;
+        ++p;
+    }
+    if (*p != delimiter) {
+        return 0;
+    }
+    *cursor = delimiter ? p + 1 : p;
+    *value = result;
+    return 1;
+}
+
+/*
+ * 描述符 ABI 固定为 1:<pid>:<Linux gettid>:<session>；各身份均为正整数。
+ * 首次接受之前同时核对进程和实际调用线程，不把第一个调用者自动认作 owner。
+ * 无描述符仅在尚未进入 host 模式时保留 SDL 原生行为；一旦绑定不得撤回、
+ * 换 session、从 standalone 中途升级，或在 SDL_Quit 后用新身份复活同一实例。
+ * 返回 FIRST 只代表调用方应在本实例执行 SetMainReady，不代表 events/video 成功。
+ */
+static inline int AMCL_SdlHostPrepare(AMCL_SdlHostRuntime *runtime, const char *descriptor,
+                               uint64_t current_pid, uint64_t current_tid)
+{
+    uint64_t abi, pid, tid, session;
+    const char *cursor = descriptor;
+    if (!descriptor) {
+        if (runtime->state >= 2) {
+            return runtime->state == 3 ? AMCL_SDL_HOST_RETIRED : AMCL_SDL_HOST_CHANGED;
+        }
+        runtime->state = 1;
+        return AMCL_SDL_HOST_STANDALONE;
+    }
+    if (!AMCL_SdlHostReadNumber(&cursor, ':', &abi) || abi != 1 ||
+        !AMCL_SdlHostReadNumber(&cursor, ':', &pid) ||
+        !AMCL_SdlHostReadNumber(&cursor, ':', &tid) ||
+        !AMCL_SdlHostReadNumber(&cursor, '\0', &session)) {
+        return AMCL_SDL_HOST_MALFORMED;
+    }
+    if (pid != current_pid || current_pid == 0) {
+        return AMCL_SDL_HOST_WRONG_PID;
+    }
+    if (tid != current_tid || current_tid == 0) {
+        return AMCL_SDL_HOST_WRONG_THREAD;
+    }
+    if (runtime->state == 3) {
+        return AMCL_SDL_HOST_RETIRED;
+    }
+    if (runtime->state == 1 || (runtime->state == 2 &&
+        (runtime->pid != pid || runtime->tid != tid || runtime->session != session))) {
+        return AMCL_SDL_HOST_CHANGED;
+    }
+    if (runtime->state == 2) {
+        return AMCL_SDL_HOST_READY;
+    }
+    runtime->pid = pid;
+    runtime->tid = tid;
+    runtime->session = session;
+    runtime->state = 2;
+    return AMCL_SDL_HOST_FIRST;
+}
+
+/*
+ * 退休只改变宿主模式；standalone 仍可按 SDL 上游约定 Quit 后重新 Init。
+ * 只允许相同进程/线程/session 发起退休；外部调用不得越过此检查清空资源。
+ * 重复合法 Quit 保持幂等，但之后任何 Init 必须要求新游戏进程。
+ */
+static inline int AMCL_SdlHostRetire(AMCL_SdlHostRuntime *runtime, const char *descriptor,
+                              uint64_t current_pid, uint64_t current_tid)
+{
+    AMCL_SdlHostRuntime probe = *runtime;
+    int result;
+    if (probe.state == 3) {
+        probe.state = 2;
+    }
+    result = AMCL_SdlHostPrepare(&probe, descriptor, current_pid, current_tid);
+    if (result < 0) {
+        return result;
+    }
+    if (result != AMCL_SDL_HOST_STANDALONE) {
+        *runtime = probe;
+        runtime->state = 3;
+    }
+    return result;
+}
+
+/* 仅 SDL 内部调用，未新增 public/dynapi ABI；发布构建同样执行事件泵线程约束。 */
+#ifdef SDL_PLATFORM_OPENHARMONY
+extern bool SDL_AMCL_ValidateEventThread(bool observe_pump);
+#endif
+
+#endif
