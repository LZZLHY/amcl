diff --git a/src/joystick/SDL_amclgamepad_c.h b/src/joystick/SDL_amclgamepad_c.h
new file mode 100644
--- /dev/null
+++ b/src/joystick/SDL_amclgamepad_c.h
@@ -0,0 +1,164 @@
+/* AMCL 游戏手柄到当前 SDL joystick 实例的投影。调用点持 SDL 的 joystick 锁；
+ * 平台只提供连接代次与当前标准状态，此处不注册系统回调、不取得窗口或输入所有权。 */
+#ifndef SDL_amclgamepad_c_h_
+#define SDL_amclgamepad_c_h_
+#include "../video/openharmony/desktop_host_api.h"
+
+#ifdef AMCL_SDL_GAMEPAD_HOST_TEST
+/* 宿主测试只替代已验证的进程 reader 和角色资格，SDL 的设备与事件仍走生产逻辑。 */
+typedef int32_t (*AmclGamepadReadFn)(int32_t, AmclDesktopGamepad *);
+extern AmclGamepadReadFn amclResolveGamepadReader(void);
+#else
+#include "../video/openharmony/gamepad_reader.h"
+#endif
+extern bool SDL_AMCL_GamepadSessionActive(void);
+static bool SDL_PrivateJoystickShouldIgnoreEvent(void);
+
+typedef struct AMCL_GamepadSlot
+{
+    SDL_JoystickID instance;
+    SDL_Joystick *handle;
+    Uint64 generation;
+    Uint64 events;
+    Sint16 axes[6];
+    bool buttons[18];
+    Uint8 hat;
+    bool pendingFocusReplay;
+} AMCL_GamepadSlot;
+
+static AMCL_GamepadSlot amcl_gamepads[16];
+static AmclGamepadReadFn amcl_gamepad_reader;
+static bool amcl_gamepad_syncing;
+static Uint64 amcl_gamepad_resolve_at;
+
+/* 先撤本地槽再关闭句柄。Remove 事件过滤器可重入，旧代次不能清除后来的连接。 */
+static void AMCL_DropGamepad(int index)
+{
+    const AMCL_GamepadSlot old = amcl_gamepads[index];
+    SDL_zero(amcl_gamepads[index]);
+    if (old.instance) {
+        if (old.handle && SDL_GetJoystickFromID(old.instance) == old.handle) {
+            SDL_CloseJoystick(old.handle);
+        }
+        if (SDL_IsJoystickVirtual(old.instance)) {
+            SDL_DetachVirtualJoystick(old.instance);
+        }
+    }
+}
+
+/* 同一实体在一份 SDL 实例只占一个 ID，插回同槽须换 ID。重排前十五个标准键，
+ * 三个额外数字键仅供 raw joystick 查询；不把数字扳机虚报为手柄背键。 */
+static bool AMCL_OpenGamepad(AMCL_GamepadSlot *slot, const AmclDesktopGamepad *pad)
+{
+    SDL_VirtualJoystickDesc desc;
+    SDL_INIT_INTERFACE(&desc);
+    desc.type = SDL_JOYSTICK_TYPE_GAMEPAD;
+    desc.naxes = 6;
+    desc.nbuttons = 18;
+    desc.nhats = 1;
+    desc.axis_mask = 0x3f;
+    desc.button_mask = 0x7fff;
+    desc.name = pad->name[0] ? pad->name : "Game Controller";
+    slot->instance = SDL_AttachVirtualJoystick(&desc);
+    if (!slot->instance) {
+        return false;
+    }
+    slot->handle = SDL_OpenJoystick(slot->instance);
+    if (!slot->handle) {
+        SDL_DetachVirtualJoystick(slot->instance);
+        SDL_zero(*slot);
+        return false;
+    }
+    slot->generation = pad->generation;
+    return true;
+}
+
+/* 首次连接提交完整初态，后续按 SDL 实际可见的定点轴、键和方向帽提交差异。
+ * 系统可在同一帧上报多个轴；同值或量化后相同的报告不重写 virtual driver。 */
+static void AMCL_WriteGamepad(AMCL_GamepadSlot *slot, const AmclDesktopGamepad *pad, bool fullRefresh)
+{
+    static const Uint8 buttons[] = {0, 1, 2, 3, 6, 8, 7, 9, 10, 4, 5, 11, 13, 14, 12, 15, 16, 17};
+    for (int axis = 0; axis < (int)SDL_arraysize(slot->axes); ++axis) {
+        const float v = SDL_clamp(pad->axes[axis], -1.0f, 1.0f);
+        const Sint16 value = (Sint16)(v * (v < 0 ? 32768.0f : 32767.0f));
+        if (fullRefresh || value != slot->axes[axis]) {
+            SDL_SetJoystickVirtualAxis(slot->handle, axis, value);
+            slot->axes[axis] = value;
+        }
+    }
+    for (int button = 0; button < (int)SDL_arraysize(buttons); ++button) {
+        const bool down = pad->buttons[buttons[button]] != 0;
+        if (fullRefresh || down != slot->buttons[button]) {
+            SDL_SetJoystickVirtualButton(slot->handle, button, down);
+            slot->buttons[button] = down;
+        }
+    }
+    if (fullRefresh || pad->hats[0] != slot->hat) {
+        SDL_SetJoystickVirtualHat(slot->handle, 0, pad->hats[0]);
+        slot->hat = pad->hats[0];
+    }
+}
+
+/* Init 时先完成初始枚举，随后由标准 joystick 更新入口同步。SDL_PollEvent 和
+ * SDL_UpdateGamepads 都走此处；不依赖 VIDEO。空设备或关闭路由只读一次在线位图。 */
+static void AMCL_SyncGamepads(void)
+{
+    if (amcl_gamepad_syncing) {
+        return;
+    }
+    amcl_gamepad_syncing = true;
+    const bool active = SDL_AMCL_GamepadSessionActive();
+    if (active && !amcl_gamepad_reader && SDL_GetTicks() >= amcl_gamepad_resolve_at) {
+        /* 旧系统、晚注册或缺描述符时避免每次 Poll 打开文件；仅由实际消费方低频重试。 */
+        amcl_gamepad_reader = amclResolveGamepadReader();
+        amcl_gamepad_resolve_at = SDL_GetTicks() + 1000;
+    }
+    const int mask = active && amcl_gamepad_reader ? amcl_gamepad_reader(-1, NULL) : -1;
+    for (int i = 0; i < (int)SDL_arraysize(amcl_gamepads); ++i) {
+        AMCL_GamepadSlot *slot = &amcl_gamepads[i];
+        AmclDesktopGamepad pad;
+        const int state = mask > 0 && (mask & (1 << i)) ? amcl_gamepad_reader(i, &pad) : 0;
+        if (slot->instance && (state <= 0 || slot->generation != pad.generation ||
+                               SDL_GetJoystickFromID(slot->instance) != slot->handle)) {
+            AMCL_DropGamepad(i);
+        }
+        if (state <= 0) {
+            continue;
+        }
+        const bool opening = !slot->instance;
+        const bool changed = opening || slot->events != pad.events;
+        if (!changed && !slot->pendingFocusReplay) {
+            continue;
+        }
+        /* 主 SDL 窗口的焦点恢复可能晚于 Native。后台仍交付归中与松开；
+         * 如果 SDL 拒收了按下或偏轴，恢复时以当前快照完整重放一次。 */
+        const bool ignoresInput = SDL_PrivateJoystickShouldIgnoreEvent();
+        if (!changed && ignoresInput) {
+            continue;
+        }
+        if (opening && !AMCL_OpenGamepad(slot, &pad)) {
+            continue;
+        }
+        /* 失焦推进 events 高 32 位。两次轮询间已复焦也须收回外部 virtual API 写入。 */
+        const bool fullRefresh = opening || (!ignoresInput && slot->pendingFocusReplay) ||
+                                 (slot->events >> 32) != (pad.events >> 32);
+        AMCL_WriteGamepad(slot, &pad, fullRefresh);
+        slot->pendingFocusReplay = ignoresInput;
+        slot->events = pad.events;
+        if (opening) {
+            /* 第一次 GetGamepads 后立即读轴，也应见到已连接设备的实际位置。 */
+            slot->handle->driver->Update(slot->handle);
+        }
+    }
+    amcl_gamepad_syncing = false;
+}
+
+/* 上游 QuitJoysticks 随后逐个移除设备、强制关闭句柄并退休 virtual driver。
+ * 此处只遗忘借用引用，保留 SDL 原有单次 remove 顺序，允许子系统重新初始化。 */
+static void AMCL_ForgetGamepads(void)
+{
+    SDL_zeroa(amcl_gamepads);
+    amcl_gamepad_reader = NULL;
+    amcl_gamepad_resolve_at = 0;
+}
+#endif
diff --git a/src/video/openharmony/gamepad_reader.h b/src/video/openharmony/gamepad_reader.h
new file mode 100644
--- /dev/null
+++ b/src/video/openharmony/gamepad_reader.h
@@ -0,0 +1,46 @@
+#pragma once
+// GLFW 与 SDL 共用的 C ABI。前缀沿用原桌面宿主文件，尾部只授予手柄快照读取能力。
+#include "desktop_host_api.h"
+#include <dlfcn.h>
+#include <fcntl.h>
+#include <stdio.h>
+#include <string.h>
+#include <sys/file.h>
+#include <unistd.h>
+
+typedef int32_t (*AmclGamepadReadFn)(int32_t, AmclDesktopGamepad*);
+typedef struct AmclGamepadReaderDescriptor {
+    uintptr_t desktopGetter;
+    uint32_t version, snapshotSize, pid;
+    uintptr_t reader;
+} AmclGamepadReaderDescriptor;
+
+// 跨 DSO 的 libc 环境不可作为权威源。同 PID 下用已有私有文件的 flock 线性读写。
+static inline void amclGamepadReaderPath(char* path, size_t capacity) {
+    snprintf(path, capacity, "/data/storage/el2/base/files/.amcl_desktop_host_%d.lock", (int)getpid());
+}
+
+// 只接受实际 libentry 的精确导出和当前快照大小。应用进程常驻该 NAPI 映像，调用方可缓存成功结果。
+// 负返回表示原生路由不可用。(-1,NULL) 返回在线槽位 bitmask，其余合法槽正返回才是有效快照。
+static inline AmclGamepadReadFn amclResolveGamepadReader(void) {
+    char path[160];
+    amclGamepadReaderPath(path, sizeof(path));
+    const int fd = open(path, O_RDONLY | O_CLOEXEC | O_NOFOLLOW);
+    if (fd < 0) return NULL;
+    AmclGamepadReaderDescriptor descriptor = {0};
+    int complete = 0;
+    if (flock(fd, LOCK_SH) == 0) {
+        complete = pread(fd, &descriptor, sizeof(descriptor), 0) == (ssize_t)sizeof(descriptor);
+        flock(fd, LOCK_UN);
+    }
+    close(fd);
+    if (!complete || descriptor.version != 1 || descriptor.snapshotSize != sizeof(AmclDesktopGamepad) ||
+        descriptor.pid != (uint32_t)getpid() || !descriptor.reader) return NULL;
+    void* address = (void*)descriptor.reader;
+    Dl_info owner;
+    if (!dladdr(address, &owner) || !owner.dli_fname || !owner.dli_fbase || owner.dli_saddr != address ||
+        !owner.dli_sname || strcmp(owner.dli_sname, "amclGamepadRead") != 0) return NULL;
+    const char* name = strrchr(owner.dli_fname, '/');
+    if (strcmp(name ? name + 1 : owner.dli_fname, "libentry.so") != 0) return NULL;
+    return (AmclGamepadReadFn)address;
+}
