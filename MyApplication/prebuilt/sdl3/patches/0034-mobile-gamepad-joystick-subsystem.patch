+bool SDL_AMCL_GamepadSessionActive(void)
+{
+    const uint64_t pid = (uint64_t)getpid();
+    if (SDL_GetAtomicInt(&SDL_amclHostMode) != 1 ||
+        (uint64_t)SDL_GetAtomicInt(&SDL_amclHostPid) != pid) {
+        return false;
+    }
+    SDL_LockSpinlock(&SDL_amclHostLock);
+    const AMCL_SdlHostRuntime host = SDL_amclHostRuntime;
+    SDL_UnlockSpinlock(&SDL_amclHostLock);
+    if (host.state != 2 || host.pid != pid) {
+        return false;
+    }
+    if (host.abi == 1) {
+        return true;
+    }
+    if (host.abi == 2) {
+        const AMCL_SdlHostDescriptor identity = {2, pid, host.launch_tid, host.session, 1};
+        return SDL_AMCL_AuxOperation(&identity, AMCL_SDL_AUX_PEEK_ACTIVE, pid, host.tid) > 0;
+    }
+    return false;
 }
 
