+/* 稳定帧仅做宿主原子flags读取，不查询EGL、不改变尺寸或呈现owner。 */
+static inline uint32_t AMCL_PresentationGeometryFlags(const AMCL_PresentationOwner *owner)
+{
+    const AMCL_NativeWindowLeaseBrokerV2 *broker = owner ? owner->broker : NULL;
+    return owner && owner->token && broker &&
+        broker->structSize >= offsetof(AMCL_NativeWindowLeaseBrokerV2, observeDrawable) + sizeof(broker->observeDrawable) &&
+        broker->geometryWorkFlags && broker->geometryCheckpoint && broker->observeDrawable
+        ? broker->geometryWorkFlags() : 0u;
+}
+
+/* 只能在真实呈现线程、驱动调用之间执行，不能由PumpEvents猜测另一个线程的current。 */
+static inline void AMCL_PresentationGeometryCheckpoint(const AMCL_PresentationOwner *owner)
+{
+    if (AMCL_PresentationGeometryFlags(owner) & 1u)
+        owner->broker->geometryCheckpoint(owner->native_window, owner->generation, owner->token);
+}
+
+/* 成功查询的实际EGL尺寸与请求分别表达，auxiliary pbuffer不调用本入口。 */
+static inline void AMCL_PresentationObserveDrawable(const AMCL_PresentationOwner *owner, int width, int height, uint32_t source)
+{
+    if (AMCL_PresentationGeometryFlags(owner) & 2u)
+        owner->broker->observeDrawable(owner->native_window, owner->generation, owner->token, width, height, source);
+}
+
 typedef void *(*AMCL_PresentationCreateFn)(void *context, void *native_window);
 typedef bool (*AMCL_PresentationDestroyFn)(void *context, void *surface);
 
