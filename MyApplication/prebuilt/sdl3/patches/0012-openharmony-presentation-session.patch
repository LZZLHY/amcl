+static bool OPENHARMONY_AMCL_PresentationFailure(SDL_WindowData *data, const char *operation)
+{
+    SDL_setenv_unsafe("AMCL_RENDERER_REQUIRES_PROCESS_RESTART", "1", 1);
+    SDL_VideoData *videodata = OPENHARMONY_AMCL_GetVideoData();
+    if (videodata) {
+        videodata->renderer_fatal = true;
+    }
+    SDL_LogError(SDL_LOG_CATEGORY_VIDEO,
+                 "OPENHARMONY_PRESENTATION event=fatal operation=%s token=%" SDL_PRIu64 " live=%u",
+                 operation, data ? data->presentation.token : 0,
+                 data ? AMCL_PresentationLive(&data->presentation) : 0);
+    return SDL_SetError("OpenHarmony presentation ownership failure: %s", operation);
+}
+
+#ifdef SDL_VIDEO_OPENGL_EGL
+typedef struct OPENHARMONY_PresentationCreateContext
+{
+    SDL_VideoDevice *device;
+    SDL_Window *window;
+} OPENHARMONY_PresentationCreateContext;
+
+static void *OPENHARMONY_AMCL_CreateSurfaceCallback(void *context, void *native_window)
+{
+    OPENHARMONY_PresentationCreateContext *create = context;
+    return SDL_EGL_CreateSurface(create->device, create->window, (NativeWindowType)native_window);
+}
+
+static bool OPENHARMONY_AMCL_DestroySurfaceCallback(void *context, void *surface)
+{
+    SDL_VideoDevice *_this = context;
+    if (!_this || !_this->egl_data || !_this->egl_data->eglDestroySurface) {
+        return SDL_SetError("OpenHarmony: EGL provider disappeared before surface retirement");
+    }
+    if (_this->egl_data->eglDestroySurface(_this->egl_data->egl_display, (EGLSurface)surface) != EGL_TRUE) {
+        const EGLint error = _this->egl_data->eglGetError();
+        return SDL_EGL_SetErrorEx("OpenHarmony: presented surface retirement failed", "eglDestroySurface", error);
+    }
+    return true;
+}
+#endif
+
+SDL_EGLSurface OPENHARMONY_AMCL_CreatePresentedSurface(SDL_VideoDevice *_this,
+    SDL_Window *window, SDL_WindowData *data, const SDL_WindowData *candidate)
+{
+#ifdef SDL_VIDEO_OPENGL_EGL
+    if (!data || !candidate || data->role != OPENHARMONY_WINDOW_PRESENTED) {
+        SDL_SetError("OpenHarmony: only presented OpenGL windows can claim presentation");
+        return NULL;
+    }
+    if (data->native_xcomponent) {
+        /* Standalone SDL owns its XComponent; it has no AMCL host broker. */
+        return SDL_EGL_CreateSurface(_this, window, (NativeWindowType)candidate->native_window);
+    }
+    OPENHARMONY_PresentationCreateContext context = { _this, window };
+    const AMCL_NativeWindowLeaseBrokerV2 *broker = candidate->native_window_lease_broker;
+    const SDL_EGLSurface surface = AMCL_PresentationCreate(&data->presentation, broker,
+        candidate->native_window, candidate->native_window_lease_generation,
+        &context, OPENHARMONY_AMCL_CreateSurfaceCallback);
+    if (!surface) {
+        SDL_SetError("OpenHarmony: presented GL surface creation or ownership claim failed");
+    }
+    return surface;
+#else
+    (void)_this;
+    (void)window;
+    (void)data;
+    (void)candidate;
+    return NULL;
+#endif
+}
+
+bool OPENHARMONY_AMCL_RetirePresentedSurface(SDL_VideoDevice *_this,
+    SDL_WindowData *data, SDL_EGLSurface surface)
+{
+#ifdef SDL_VIDEO_OPENGL_EGL
+    if (!surface) return true;
+    const bool retired = data->native_xcomponent
+        ? OPENHARMONY_AMCL_DestroySurfaceCallback(_this, surface)
+        : AMCL_PresentationRetire(&data->presentation, surface, _this,
+                                  OPENHARMONY_AMCL_DestroySurfaceCallback);
+    return retired ? true : OPENHARMONY_AMCL_PresentationFailure(data, "surface-retirement");
+#else
+    (void)_this;
+    (void)data;
+    return surface == NULL;
+#endif
+}
+
+bool OPENHARMONY_AMCL_MovePresentation(SDL_WindowData *data, void *native_window, Uint64 generation)
+{
+    if (data->native_xcomponent) return true;
+    /* The same session can retain old and candidate resources while preparing
+     * a transaction, but cannot move its token until old resources retire. */
+    if (!AMCL_PresentationMove(&data->presentation, native_window, generation)) {
+        return SDL_SetError("OpenHarmony: presentation generation changed during recovery");
+    }
+    return true;
+}
+
+bool OPENHARMONY_AMCL_ReleasePresentation(SDL_WindowData *data)
+{
+    if (!data || !data->presentation.token) return true;
+    const Uint64 token = data->presentation.token;
+    if (!AMCL_PresentationRelease(&data->presentation)) {
+        return OPENHARMONY_AMCL_PresentationFailure(data, "token-release-before-retirement");
+    }
+    SDL_LogInfo(SDL_LOG_CATEGORY_VIDEO,
+                "OPENHARMONY_PRESENTATION event=release token=%" SDL_PRIu64
+                " created=%" SDL_PRIu64 " destroyed=%" SDL_PRIu64 " rejected=%" SDL_PRIu64 " live=0",
+                token, data->presentation.created, data->presentation.destroyed, data->presentation.rejected);
+    return true;
+}
