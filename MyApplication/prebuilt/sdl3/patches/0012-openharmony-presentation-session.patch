@@ -0,0 +1,191 @@
+/*
+ * AMCL embedded OpenHarmony presentation ownership.
+ * This is an AMCL addition, not an upstream SDL implementation.
+ *
+ * Copyright (c) AMCL contributors. Distributed under SDL's zlib license.
+ */
+#ifndef SDL_amclpresentation_h_
+#define SDL_amclpresentation_h_
+
+#include <stdbool.h>
+#include <stddef.h>
+#include <stdint.h>
+
+typedef uint32_t AMCL_NativeWindowPublicationState;
+typedef struct AMCL_NativeWindowLeaseBrokerV2
+{
+    uint32_t abiVersion;
+    uint32_t structSize;
+    int (*acquire)(void *, uint64_t, void **, int *, int *, uint64_t *);
+    void (*release)(void *);
+    int (*beginInputPublication)(int *, int *, uint64_t *);
+    void (*endInputPublication)(void);
+    uint64_t (*peekGeneration)(void);
+    AMCL_NativeWindowPublicationState (*peekState)(void);
+    int (*claimPresentation)(void *, uint64_t, uint32_t, uint64_t *);
+    int (*movePresentation)(uint64_t, void *, uint64_t);
+    int (*releasePresentation)(uint64_t);
+} AMCL_NativeWindowLeaseBrokerV2;
+
+#define AMCL_PRESENTATION_BROKER_SIZE \
+    ((uint32_t)(offsetof(AMCL_NativeWindowLeaseBrokerV2, releasePresentation) + \
+                sizeof(((AMCL_NativeWindowLeaseBrokerV2 *)0)->releasePresentation)))
+
+typedef struct AMCL_PresentationSurface
+{
+    void *surface;
+    void *native_window;
+    uint64_t generation;
+} AMCL_PresentationSurface;
+
+typedef struct AMCL_PresentationOwner
+{
+    const AMCL_NativeWindowLeaseBrokerV2 *broker;
+    uint64_t token;
+    void *native_window;
+    uint64_t generation;
+    /* A recovery transaction may build one candidate while retaining the old
+     * surface. Both belong to the same exclusive session. Token movement is
+     * forbidden until every old-native-window surface has really retired. */
+    AMCL_PresentationSurface surfaces[2];
+    bool retirement_failed;
+    uint64_t created;
+    uint64_t destroyed;
+    uint64_t rejected;
+} AMCL_PresentationOwner;
+
+typedef void *(*AMCL_PresentationCreateFn)(void *context, void *native_window);
+typedef bool (*AMCL_PresentationDestroyFn)(void *context, void *surface);
+
+static inline bool AMCL_PresentationBrokerValid(const AMCL_NativeWindowLeaseBrokerV2 *broker)
+{
+    return broker && broker->abiVersion == 2u &&
+           broker->structSize >= AMCL_PRESENTATION_BROKER_SIZE &&
+           broker->peekGeneration && broker->peekState &&
+           broker->claimPresentation && broker->movePresentation && broker->releasePresentation;
+}
+
+static inline unsigned int AMCL_PresentationLive(const AMCL_PresentationOwner *owner)
+{
+    return (owner->surfaces[0].surface != NULL ? 1u : 0u) +
+           (owner->surfaces[1].surface != NULL ? 1u : 0u);
+}
+
+static inline bool AMCL_PresentationRelease(AMCL_PresentationOwner *owner)
+{
+    if (AMCL_PresentationLive(owner) != 0u) {
+        owner->rejected++;
+        return false;
+    }
+    if (!owner->token) {
+        return true;
+    }
+    if (!AMCL_PresentationBrokerValid(owner->broker) ||
+        !owner->broker->releasePresentation(owner->token)) {
+        owner->rejected++;
+        return false;
+    }
+    owner->broker = NULL;
+    owner->token = 0;
+    owner->native_window = NULL;
+    owner->generation = 0;
+    owner->retirement_failed = false;
+    return true;
+}
+
+static inline void *AMCL_PresentationCreate(AMCL_PresentationOwner *owner,
+    const AMCL_NativeWindowLeaseBrokerV2 *broker, void *native_window,
+    uint64_t generation, void *context, AMCL_PresentationCreateFn create)
+{
+    if (!owner || !create || !native_window || !generation ||
+        !AMCL_PresentationBrokerValid(broker) || owner->retirement_failed ||
+        AMCL_PresentationLive(owner) >= 2u ||
+        broker->peekGeneration() != generation || broker->peekState() != 1u) {
+        if (owner) owner->rejected++;
+        return NULL;
+    }
+    for (unsigned int i = 0; i < 2u; ++i) {
+        if (owner->surfaces[i].surface && owner->surfaces[i].native_window == native_window) {
+            owner->rejected++;
+            return NULL;
+        }
+    }
+    bool claimed_here = false;
+    if (!owner->token) {
+        uint64_t token = 0;
+        if (!broker->claimPresentation(native_window, generation, 1u, &token) || !token) {
+            owner->rejected++;
+            return NULL;
+        }
+        owner->broker = broker;
+        owner->token = token;
+        owner->native_window = native_window;
+        owner->generation = generation;
+        claimed_here = true;
+    } else if (owner->broker != broker) {
+        owner->rejected++;
+        return NULL;
+    }
+    void *surface = create(context, native_window);
+    if (!surface) {
+        if (claimed_here) {
+            /* No resource escaped the failed first create. A refused release
+             * remains owned so another API cannot silently acquire it. */
+            AMCL_PresentationRelease(owner);
+        }
+        return NULL;
+    }
+    const unsigned int slot = owner->surfaces[0].surface ? 1u : 0u;
+    owner->surfaces[slot].surface = surface;
+    owner->surfaces[slot].native_window = native_window;
+    owner->surfaces[slot].generation = generation;
+    owner->created++;
+    return surface;
+}
+
+static inline bool AMCL_PresentationRetire(AMCL_PresentationOwner *owner,
+    void *surface, void *context, AMCL_PresentationDestroyFn destroy)
+{
+    if (!surface) return true;
+    if (!owner || !owner->token || !destroy) return false;
+    for (unsigned int i = 0; i < 2u; ++i) {
+        if (owner->surfaces[i].surface != surface) continue;
+        if (!destroy(context, surface)) {
+            owner->retirement_failed = true;
+            owner->rejected++;
+            return false;
+        }
+        owner->surfaces[i].surface = NULL;
+        owner->surfaces[i].native_window = NULL;
+        owner->surfaces[i].generation = 0;
+        owner->destroyed++;
+        return true;
+    }
+    owner->rejected++;
+    return false;
+}
+
+static inline bool AMCL_PresentationMove(AMCL_PresentationOwner *owner,
+    void *native_window, uint64_t generation)
+{
+    if (!owner || !owner->token || !native_window || !generation ||
+        !AMCL_PresentationBrokerValid(owner->broker) || owner->retirement_failed) return false;
+    for (unsigned int i = 0; i < 2u; ++i) {
+        if (owner->surfaces[i].surface && owner->surfaces[i].native_window != native_window) {
+            owner->rejected++;
+            return false;
+        }
+    }
+    if (!owner->broker->movePresentation(owner->token, native_window, generation)) {
+        owner->rejected++;
+        return false;
+    }
+    owner->native_window = native_window;
+    owner->generation = generation;
+    for (unsigned int i = 0; i < 2u; ++i) {
+        if (owner->surfaces[i].surface) owner->surfaces[i].generation = generation;
+    }
+    return true;
+}
+
+#endif
