diff --git a/CMakeLists.txt b/CMakeLists.txt
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -4207,8 +4207,12 @@
 endif()
 
 if(SDL_SHARED)
+  # 独立无窗口 SDK：符号内部绑定本映像，同进程主 SDL 的全局状态不得被抢占。
+  if(OHOS)
+    target_link_options(SDL3-shared PRIVATE "-Wl,-Bsymbolic")
+  endif()
   set_target_properties(SDL3-shared PROPERTIES
-    OUTPUT_NAME "SDL3"
+    OUTPUT_NAME "amcl_sdl_controller"
     POSITION_INDEPENDENT_CODE TRUE
     LINK_DEPENDS "${CMAKE_CURRENT_SOURCE_DIR}/src/dynapi/SDL_dynapi.sym"
     INTERFACE_LINK_DEPENDS "$<BUILD_INTERFACE:${CMAKE_CURRENT_SOURCE_DIR}/src/dynapi/SDL_dynapi.sym>"
diff --git a/src/core/openharmony/SDL_amclhostruntime.h b/src/core/openharmony/SDL_amclhostruntime.h
--- a/src/core/openharmony/SDL_amclhostruntime.h
+++ b/src/core/openharmony/SDL_amclhostruntime.h
@@ -72,13 +72,17 @@
 {
     AMCL_SdlHostDescriptor value = { 0 };
     const char *cursor=descriptor;
-    if(!descriptor)return AMCL_SDL_HOST_STANDALONE;
+    if(!descriptor)return AMCL_SDL_HOST_MALFORMED;
     if(!out || !AMCL_SdlHostReadNumber(&cursor,':',&value.abi) || (value.abi!=1 && value.abi!=2) ||
        !AMCL_SdlHostReadNumber(&cursor,':',&value.pid) || !AMCL_SdlHostReadNumber(&cursor,':',&value.launch_tid) ||
        !AMCL_SdlHostReadNumber(&cursor,value.abi==1?'\0':':',&value.session) ||
        (value.abi==2 && (!AMCL_SdlHostReadNumber(&cursor,'\0',&value.role) || value.role!=1 || value.launch_tid>INT32_MAX)))
         return AMCL_SDL_HOST_MALFORMED;
     if(!current_pid || value.pid!=current_pid)return AMCL_SDL_HOST_WRONG_PID;
+    /* 只消费已经冻结的主 SDL 会话。实际无窗口映像在 graphics owner 通过设备/inode
+     * 及实例 cookie 验证后，沿原 ABI2 准入；不改进程环境或主实例身份。 */
+    if(value.launch_tid>INT32_MAX)return AMCL_SDL_HOST_MALFORMED;
+    value.abi=2;value.role=1;
     *out=value;return AMCL_SDL_HOST_READY;
 }
 
