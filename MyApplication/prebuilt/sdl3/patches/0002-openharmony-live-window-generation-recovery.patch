+// --- Live-window surface recovery -----------------------------------------
+// A host-injected window used to keep presenting into whatever OHNativeWindow
+// it was created on: once the host destroyed/recreated its XComponent surface
+// the EGL surface pointed at a retired window forever. These entry points let
+// the backend track the host's surface publications (the single-value
+// AMCL_NATIVE_WINDOW_SNAPSHOT environment channel) and rebuild the EGL
+// surface of a *live* window. All three are safe no-ops when SDL owns its own
+// XComponent, or when the host publishes no snapshot channel.
+//
+// Forward tags only: this header is included before ../SDL_sysvideo.h in some
+// translation units, so the sysvideo typedefs may not exist yet here.
+struct SDL_VideoDevice;
+struct SDL_WindowData;
+
+// Record which host publication the window's native_window was adopted under.
+// Call once from OPENHARMONY_CreateWindow after SDL_WindowData is filled in.
+extern void OPENHARMONY_AMCL_NoteWindowAdopted(struct SDL_WindowData *data);
+
+// Compare the live window against the host's snapshot; recover from surface
+// loss / replacement / resize. Called once per event pump, on the thread that
+// called SDL_PollEvent().
+extern void OPENHARMONY_AMCL_SyncLiveWindow(struct SDL_VideoDevice *_this);
+
+// Release the OH_NativeWindow reference the recovery path may hold. Call from
+// OPENHARMONY_DestroyWindow before SDL_WindowData is freed.
+extern void OPENHARMONY_AMCL_ReleaseWindowRef(struct SDL_WindowData *data);
+
 #endif // SDL_openharmonyamcl_h_
