+        const int saved_surface_type = _this->egl_data->egl_surfacetype;
+        const EGLenum saved_apitype = _this->egl_data->apitype;
+        if (auxiliary &&
+            videodata->egl_policy != OPENHARMONY_EGL_POLICY_HYBRID_PINNED) {
+            return SDL_SetError("OpenHarmony: auxiliary pbuffer requested after a window-only EGLConfig was pinned");
+        }
+        if (!_this->egl_data->egl_config_locked) {
