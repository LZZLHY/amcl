+                                    _this, window, context);
+                                ((SDL_VideoData *)_this->internal)->makecurrent_ok++;
+                                return true;
+                            } else {
+                                retry_interval_failed = true;
+                                OPENHARMONY_GLES_RestorePreviousBinding(
+                                    _this, previous_id, context);
+                            }
+                        } else {
+                            makecurrent_error = retry_error;
+                        }
+                    }
+            }
+        }
+            SDL_Window *retry_live_window = SDL_GetWindowFromID(window_id);
+            if (!retry_live_window || !retry_live_window->internal) {
+                return false;
+            }
+            if (OPENHARMONY_GLES_IsRecoveryDeferred(retry_live_window)) {
+                return false;
+            }
+            if (retry_interval_failed ||
+                OPENHARMONY_GLES_IsFatalContextError(makecurrent_error) ||
+                !OPENHARMONY_GLES_IsRecoverableSurfaceError(makecurrent_error) ||
+                !was_current) {
+                SDL_Window *fatal_window = SDL_GetWindowFromID(window_id);
+                if (!fatal_window || !fatal_window->internal) {
+                    return false;
+                }
+                return OPENHARMONY_GLES_MarkRendererFatal(
+                    fatal_window,
+                    OPENHARMONY_GLES_IsFatalContextError(makecurrent_error)
+                        ? "eglMakeCurrent-context-lost" : "eglMakeCurrent");
+            }
+        }
+        return false;
+    }
+    data->owner_thread = SDL_GetCurrentThreadID();
+    data->last_context = context;
+    SDL_Window *previous_live = previous_id ? SDL_GetWindowFromID(previous_id) : NULL;
+    if (previous_live && previous_live != window && previous_live->internal) {
+        previous_live->internal->is_current = false;
+    }
+    data->is_current = true;
+    if (!OPENHARMONY_GLES_ReplaySwapInterval(
+            _this, window,
+            data->role == OPENHARMONY_WINDOW_PRESENTED)) {
+        OPENHARMONY_GLES_RestorePreviousBinding(_this, previous_id,
+                                                 context);
+        ((SDL_VideoData *)_this->internal)->makecurrent_fail++;
+        if (data->role == OPENHARMONY_WINDOW_PRESENTED) {
+            return OPENHARMONY_GLES_MarkRendererFatal(
+                window, "swap-interval-replay");
+        }
+        return false;
+    }
+    ((SDL_VideoData *)_this->internal)->makecurrent_ok++;
+    return true;
+}
