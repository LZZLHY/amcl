+    OPENHARMONY_GLSelectionKey requested;
+    OPENHARMONY_GLES_CaptureSelection(_this, &requested);
+    /* Keep the pre-probe key visible to every failure cleanup path.  The
+     * desktop→GLES fallback mutates gl_config before ChooseConfig returns, so
+     * a failed first auxiliary probe must still be able to restore the exact
+     * caller request. */
+    videodata->requested_gl_selection = requested;
+    videodata->requested_gl_selection_valid = true;
