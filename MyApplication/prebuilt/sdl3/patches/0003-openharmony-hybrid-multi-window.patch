+        videodata->auxiliary_window_count != 0) {
+        return SDL_SetError("OpenHarmony: cannot re-probe EGLConfig with an active window or context");
+    }
+    const EGLConfig old_config = _this->egl_data->egl_config;
+    const int old_surface_type = _this->egl_data->egl_surfacetype;
+    const EGLenum old_apitype = _this->egl_data->apitype;
+    const bool old_locked = _this->egl_data->egl_config_locked;
+
+    if (videodata->auxiliary_mode_pbuffer &&
+        OPENHARMONY_GLES_TryPinConfig(
+            _this, videodata, &requested,
+            EGL_WINDOW_BIT | EGL_PBUFFER_BIT,
+            OPENHARMONY_EGL_POLICY_HYBRID_PINNED)) {
+        return true;
+    }
+
+    if (auxiliary) {
+        const char *hybrid_error = SDL_GetError();
+        char error_copy[256];
+        SDL_strlcpy(error_copy, hybrid_error ? hybrid_error : "unknown error",
+                    sizeof(error_copy));
+        if (!OPENHARMONY_GLES_RestoreProbeState(
+                _this, &requested, old_config, old_surface_type, old_apitype,
+                old_locked)) {
+            return SDL_SetError("OpenHarmony: failed to restore EGL probe state");
+        }
+        return SDL_SetError("OpenHarmony: auxiliary pbuffer requires a WINDOW|PBUFFER EGLConfig (%s)",
+                            error_copy);
+    }
+
+    /* A presented-first/single-window application remains valid on a device
+     * without a combined config. Restore the complete requested probe state
+     * before selecting an explicit WINDOW-only config. */
+    SDL_ClearError();
+    if (!OPENHARMONY_GLES_RestoreProbeState(
+            _this, &requested, old_config, old_surface_type, old_apitype,
+            old_locked)) {
+        return SDL_SetError("OpenHarmony: failed to restore EGL probe state");
+    }
+    if (OPENHARMONY_GLES_TryPinConfig(
+            _this, videodata, &requested, EGL_WINDOW_BIT,
+            OPENHARMONY_EGL_POLICY_WINDOW_ONLY_PINNED)) {
+        return true;
+    }
+    const char *window_error = SDL_GetError();
+    char error_copy[256];
+    SDL_strlcpy(error_copy, window_error ? window_error : "unknown error",
+                sizeof(error_copy));
+    if (!OPENHARMONY_GLES_RestoreProbeState(
+            _this, &requested, old_config, old_surface_type, old_apitype,
+            old_locked)) {
+        return SDL_SetError("OpenHarmony: failed to restore EGL probe state");
+    }
+    return SDL_SetError("OpenHarmony: no compatible window EGLConfig (%s)",
+                        error_copy);
+}
