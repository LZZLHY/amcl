+/* SDL core clears its TLS current pair before calling the platform destroy
+ * hook, but WindowData also carries ownership metadata used by resize and
+ * surface recovery.  Clear every reference to the context before handing the
+ * actual EGL object to the generic destroyer; otherwise a later recovery can
+ * try to bind a context that no longer exists (or incorrectly reject an
+ * owner-thread operation). */
+bool OPENHARMONY_GLES_DestroyContext(SDL_VideoDevice *_this,
+                                     SDL_GLContext context)
+{
+    if (!_this) {
+        return SDL_SetError("OpenHarmony: cannot destroy a context without a video device");
+    }
+    for (SDL_Window *window = _this->windows; window; window = window->next) {
+        SDL_WindowData *data = window->internal;
+        if (!data) {
+            continue;
+        }
+        if (data->last_context == context) {
+            data->last_context = NULL;
+            data->owner_thread = 0;
+            data->is_current = false;
+        }
+        if (data->amcl_resume_context == context) {
+            data->amcl_resume_context = NULL;
+            data->amcl_resume_thread = 0;
+            if (data->surface_state == OPENHARMONY_SURFACE_RECREATE_PENDING) {
+                data->surface_state = OPENHARMONY_SURFACE_LOST;
+            }
+        }
+    }
+    return SDL_EGL_DestroyContext(_this, context);
