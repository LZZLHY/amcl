+bool OPENHARMONY_GLES_ValidatePbufferSize(SDL_VideoDevice *_this,
+                                          int width, int height)
+{
+    if (!_this || !_this->egl_data || !_this->egl_data->egl_config) {
+        return SDL_SetError("OpenHarmony: no pinned EGLConfig for pbuffer size validation");
+    }
+    if (width <= 0 || height <= 0) {
+        return SDL_SetError("OpenHarmony: invalid pbuffer size %dx%d", width, height);
+    }
+    EGLint max_width = 0;
+    EGLint max_height = 0;
+    EGLint max_pixels = 0;
+    if (!OPENHARMONY_GLES_QueryConfig(_this, _this->egl_data->egl_config,
+                                      EGL_MAX_PBUFFER_WIDTH, &max_width) ||
+        !OPENHARMONY_GLES_QueryConfig(_this, _this->egl_data->egl_config,
+                                      EGL_MAX_PBUFFER_HEIGHT, &max_height) ||
+        !OPENHARMONY_GLES_QueryConfig(_this, _this->egl_data->egl_config,
+                                      EGL_MAX_PBUFFER_PIXELS, &max_pixels)) {
+        return false;
+    }
+    const Sint64 pixels = (Sint64)width * (Sint64)height;
+    if (width > max_width || height > max_height || pixels > (Sint64)max_pixels) {
+        return SDL_SetError("OpenHarmony: pbuffer %dx%d exceeds config limits %dx%d/%d pixels",
+                            width, height, (int)max_width, (int)max_height,
+                            (int)max_pixels);
+    }
+    return true;
+}
+
+bool OPENHARMONY_GLES_ValidatePbufferSurface(SDL_VideoDevice *_this,
+                                             EGLSurface surface,
+                                             int requested_width,
+                                             int requested_height,
+                                             int *actual_width,
+                                             int *actual_height)
+{
+    if (actual_width) {
+        *actual_width = 0;
+    }
+    if (actual_height) {
+        *actual_height = 0;
+    }
+    if (!_this || !_this->egl_data || surface == EGL_NO_SURFACE ||
+        !_this->egl_data->eglQuerySurface) {
+        return SDL_SetError("OpenHarmony: cannot query the created pbuffer surface");
+    }
+    EGLint width = 0;
+    EGLint height = 0;
+    EGLint config_id = 0;
+    SDL_VideoData *videodata = (SDL_VideoData *)_this->internal;
+    if (!videodata || !OPENHARMONY_GLES_QueryConfig(
+            _this, _this->egl_data->egl_config, EGL_CONFIG_ID, &config_id) ||
+        config_id != videodata->pinned_egl_config_id) {
+        return SDL_SetError("OpenHarmony: created pbuffer does not use the pinned EGLConfig");
+    }
+    if (!_this->egl_data->eglQuerySurface(_this->egl_data->egl_display, surface,
+                                          EGL_WIDTH, &width) ||
+        !_this->egl_data->eglQuerySurface(_this->egl_data->egl_display, surface,
+                                          EGL_HEIGHT, &height)) {
+        return SDL_EGL_SetError("OpenHarmony: unable to query pbuffer dimensions",
+                                "eglQuerySurface");
+    }
+    if (actual_width) {
+        *actual_width = (int)width;
+    }
+    if (actual_height) {
+        *actual_height = (int)height;
+    }
+    if (width <= 0 || height <= 0 ||
+        (requested_width > 0 && width != requested_width) ||
+        (requested_height > 0 && height != requested_height)) {
+        return SDL_SetError("OpenHarmony: pbuffer dimensions are %dx%d, requested %dx%d",
+                            (int)width, (int)height, requested_width,
+                            requested_height);
+    }
+    return true;
+}
+
+void OPENHARMONY_GLES_ResetPolicyIfUnused(SDL_VideoDevice *_this)
+{
+    if (!_this || !_this->internal || !_this->egl_data) {
+        return;
+    }
+    SDL_VideoData *videodata = (SDL_VideoData *)_this->internal;
+    if (videodata->presented_window || videodata->auxiliary_window_count != 0) {
+        return;
+    }
+    /* A failed first-surface transaction may have applied the effective GLES
+     * fallback before its surface allocation failed.  Restore the caller's
+     * requested selection before dropping the policy so a retry starts from
+     * the same attributes, rather than silently inheriting the probe state. */
+    if (videodata->requested_gl_selection_valid) {
+        OPENHARMONY_GLES_ApplySelection(_this,
+                                        &videodata->requested_gl_selection);
+    }
+    SDL_EGL_UnlockConfig(_this);
+    _this->egl_data->egl_config = NULL;
+    _this->egl_data->egl_surfacetype = 0;
+    _this->egl_data->apitype = (_this->gl_config.profile_mask ==
+                                SDL_GL_CONTEXT_PROFILE_ES)
+                                   ? EGL_OPENGL_ES_API : EGL_OPENGL_API;
+    videodata->egl_policy = OPENHARMONY_EGL_POLICY_UNDECIDED;
+    videodata->pinned_egl_config_id = 0;
+    videodata->pinned_surface_type = 0;
+    videodata->pinned_native_visual_id = 0;
+    videodata->requested_gl_selection_valid = false;
+    videodata->effective_gl_selection_valid = false;
+}
