+static void OPENHARMONY_GLES_SetCurrentCache(SDL_VideoDevice *_this,
+                                             SDL_Window *window,
+                                             SDL_GLContext context)
+{
+    SDL_Window *old = SDL_GL_GetCurrentWindow();
+    if (old && old != window && old->internal) {
+        old->internal->is_current = false;
+    }
+    if (window && window->internal) {
+        window->internal->is_current = true;
+    }
+    _this->current_glwin = window;
+    _this->current_glctx = context;
+    SDL_SetTLS(&_this->current_glwin_tls, window, NULL);
+    SDL_SetTLS(&_this->current_glctx_tls, context, NULL);
+}
+
+static bool OPENHARMONY_GLES_IsRecoverableSurfaceError(EGLint error)
+{
+    return error == EGL_BAD_SURFACE || error == EGL_BAD_NATIVE_WINDOW;
+}
+
+static bool OPENHARMONY_GLES_IsFatalContextError(EGLint error)
+{
+#ifdef EGL_CONTEXT_LOST
+    if (error == EGL_CONTEXT_LOST) {
+        return true;
+    }
+#endif
+    return error == EGL_BAD_CONTEXT;
+}
+
+static bool OPENHARMONY_GLES_IsRecoveryDeferred(SDL_Window *window)
+{
+    if (!window || !window->internal) {
+        return false;
+    }
+    const SDL_WindowData *data = window->internal;
+    return data->amcl_surface_suspended &&
+           (data->surface_state == OPENHARMONY_SURFACE_LOST ||
+            data->surface_state == OPENHARMONY_SURFACE_RECREATE_PENDING);
+}
