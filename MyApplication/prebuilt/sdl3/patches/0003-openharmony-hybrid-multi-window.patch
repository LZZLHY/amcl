+        ((SDL_VideoData *)_this->internal)->renderer_fatal) {
+        return SDL_SetError("OpenHarmony: renderer is fatally unavailable; process restart required");
+    }
+    if (!window->internal) {
+        return SDL_SetError("OpenHarmony: window has no backend data");
+    }
+    const SDL_WindowID window_id = window->id;
+    SDL_Window *previous_window = SDL_GL_GetCurrentWindow();
+    const SDL_WindowID previous_id = previous_window ? previous_window->id : 0;
+    const bool was_current = previous_id != 0 && previous_id == window_id;
+    SDL_WindowData *data = window->internal;
+    if (data->role == OPENHARMONY_WINDOW_AUXILIARY_PBUFFER &&
+        data->pending_width > 0) {
+        if (!OPENHARMONY_ApplyPendingAuxiliaryResize(_this, window, context)) {
+            ((SDL_VideoData *)_this->internal)->makecurrent_fail++;
+            return false;
+        }
+        window = SDL_GetWindowFromID(window_id);
+        if (!window || !window->internal) {
+            return false;
+        }
+        data = window->internal;
+        if (!data || data->pending_width > 0) {
+            ((SDL_VideoData *)_this->internal)->makecurrent_fail++;
+            return SDL_SetError("OpenHarmony: auxiliary resize is pending on its owner thread");
+        }
+    }
+    if (data->role == OPENHARMONY_WINDOW_PRESENTED) {
+        /* Recovery is intentionally attempted at the same boundary as the
+         * context bind. PumpEvents remains a low-cost observer, while a
+         * render thread that alternates pbuffer/window surfaces cannot miss a
+         * publication just because it did not pump on that iteration. */
+        if (!OPENHARMONY_AMCL_PreparePresentedWindow(
+                _this, window, context, false)) {
+            ((SDL_VideoData *)_this->internal)->makecurrent_fail++;
+            SDL_Window *live_window = SDL_GetWindowFromID(window_id);
+            if (OPENHARMONY_GLES_IsRecoveryDeferred(live_window)) {
+                return false;
+            }
+            if (!was_current) {
+                live_window = SDL_GetWindowFromID(window_id);
+                return live_window
+                           ? OPENHARMONY_GLES_MarkRendererFatal(
+                                 live_window,
+                                 "presented-recovery-before-makecurrent")
+                           : false;
+            }
+            return false;
+        }
+        window = SDL_GetWindowFromID(window_id);
+        if (!window || !window->internal) {
+            return false;
+        }
+        data = window->internal;
+    }
+    if (!data || data->surface_state != OPENHARMONY_SURFACE_READY ||
+        data->amcl_surface_suspended || data->egl_surface == EGL_NO_SURFACE) {
+        return SDL_SetError("OpenHarmony: requested window surface is unavailable");
+    }
+    EGLint makecurrent_error = EGL_SUCCESS;
+    bool retry_interval_failed = false;
+    if (!SDL_EGL_MakeCurrentWithError(_this, data->egl_surface, context,
+                                      &makecurrent_error)) {
+        ((SDL_VideoData *)_this->internal)->makecurrent_fail++;
+        if (data->role == OPENHARMONY_WINDOW_PRESENTED) {
+            if (OPENHARMONY_GLES_IsRecoverableSurfaceError(makecurrent_error)) {
+                /* A host BufferQueue can retire between the generation peek and
+                 * this bind.  Revalidate/rebuild once at the same boundary as
+                 * swap, then retry the bind against the fresh surface. */
+                if (OPENHARMONY_AMCL_PreparePresentedWindow(
+                        _this, window, context, true)) {
+                    window = SDL_GetWindowFromID(window_id);
+                    if (window && window->internal) {
+                        data = window->internal;
+                        EGLint retry_error = EGL_SUCCESS;
+                        if (data->egl_surface != EGL_NO_SURFACE &&
+                            SDL_EGL_MakeCurrentWithError(
+                                _this, data->egl_surface, context,
+                                &retry_error)) {
+                            data->owner_thread = SDL_GetCurrentThreadID();
+                            data->last_context = context;
+                            data->is_current = true;
