+static void OPENHARMONY_GLES_MarkRendererRestartRequired(
+    SDL_Window *window, const char *operation)
+{
+    SDL_VideoDevice *device = SDL_GetVideoDevice();
+    if (device && device->internal) {
+        ((SDL_VideoData *)device->internal)->renderer_fatal = true;
+    }
+    SDL_setenv_unsafe("AMCL_RENDERER_REQUIRES_PROCESS_RESTART", "1", 1);
+    SDL_LogError(SDL_LOG_CATEGORY_VIDEO,
+                 "OPENHARMONY_WINDOW schema=1 event=renderer_fatal operation=%s role=%s id=%u error=%s",
+                 operation,
+                 window && window->internal &&
+                         window->internal->role == OPENHARMONY_WINDOW_AUXILIARY_PBUFFER
+                     ? "auxiliary" : "presented",
+                 window ? (unsigned int)window->id : 0,
+                 SDL_GetError());
+}
+
+bool OPENHARMONY_GLES_MarkRendererFatal(SDL_Window *window,
+                                         const char *operation)
+{
+    OPENHARMONY_GLES_MarkRendererRestartRequired(window, operation);
+    if (window) {
+        SDL_SendWindowEvent(window, SDL_EVENT_WINDOW_CLOSE_REQUESTED, 0, 0);
+    }
+    return false;
+}
