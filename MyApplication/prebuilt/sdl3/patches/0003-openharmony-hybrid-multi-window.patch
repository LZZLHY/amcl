+bool OPENHARMONY_GLES_MakeCurrent(SDL_VideoDevice *_this, SDL_Window *window, SDL_GLContext context)
+{
+    const SDL_WindowID requested_window_id = window ? window->id : 0;
+    OPENHARMONY_AMCL_UpdatePresentedForeground();
+    if (requested_window_id) {
+        /* Foreground reconciliation may release input synchronously; a user
+         * watcher can destroy the target window while that event is pushed. */
+        window = SDL_GetWindowFromID(requested_window_id);
+        if (!window || !window->internal) {
+            return SDL_SetError("OpenHarmony: requested window was destroyed during lifecycle update");
+        }
+    }
+    if (!window || !context) {
+        SDL_Window *current_window = SDL_GL_GetCurrentWindow();
+        const bool result = SDL_EGL_MakeCurrent(_this, NULL, NULL);
