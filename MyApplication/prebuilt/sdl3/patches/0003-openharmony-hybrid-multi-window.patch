+SDL_EGLSurface OPENHARMONY_GLES_GetEGLSurface(SDL_VideoDevice *_this,
+                                               SDL_Window *window)
+{
+    (void)_this;
+    if (!window || !window->internal) {
+        return EGL_NO_SURFACE;
+    }
+    if (window->internal->surface_state != OPENHARMONY_SURFACE_READY ||
+        window->internal->amcl_surface_suspended) {
+        return EGL_NO_SURFACE;
+    }
+    return (SDL_EGLSurface)window->internal->egl_surface;
+}
