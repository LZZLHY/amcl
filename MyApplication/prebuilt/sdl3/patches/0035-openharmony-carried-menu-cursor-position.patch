+/* 程序设位在启动后的已验证neutral映像中执行。不依赖两个加载命名空间能按名称互相dlopen。 */
+static bool OPENHARMONY_VerifyMenuAddress(uintptr_t address, const char *name)
+{
+#ifdef _WIN32
+    HMODULE module = NULL;
+    return GetModuleHandleExA(GET_MODULE_HANDLE_EX_FLAG_FROM_ADDRESS | GET_MODULE_HANDLE_EX_FLAG_UNCHANGED_REFCOUNT,
+        (LPCSTR)(uintptr_t)host_look_port->verifyOwner, &module) &&
+        (uintptr_t)GetProcAddress(module, name) == address && amclControlAddressInOwner(address, (uintptr_t)module);
+#else
+    Dl_info owner = {0}, symbol = {0};
+    return dladdr((const void *)host_look_port->verifyOwner, &owner) && dladdr((const void *)address, &symbol) &&
+        owner.dli_fbase == symbol.dli_fbase && (uintptr_t)symbol.dli_saddr == address && symbol.dli_sname &&
+        SDL_strcmp(symbol.dli_sname, name) == 0 && amclControlAddressInOwner(address, (uintptr_t)owner.dli_fbase);
+#endif
+}
