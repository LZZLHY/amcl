+static bool OPENHARMONY_TryWarpMenuCursor(SDL_Window *window, float x, float y)
+{
+    const SDL_WindowID target = window->id;
+    if (window != SDL_GetMouseFocus() || !OPENHARMONY_ControlReady(target) ||
+        window != OPENHARMONY_AMCL_GetLiveInputWindow(target) || window != SDL_GetMouseFocus()) return false;
+    if (host_menu_warp_dispatching && host_control_target == window->id && host_last_x == x && host_last_y == y) return true;
+    OPENHARMONY_HostBridge *bridge = OPENHARMONY_GetHostBridge();
+    if (!bridge || !bridge->InteractionFence || bridge->IsGrabbing()) return false;
+    OPENHARMONY_MenuWarpRequest request = OPENHARMONY_GetMenuWarpRequest(bridge);
+    const Uint64 order = request ? request(AMCL_BACKEND_ID_SDL3, window->id, x, y) : 0;
+    if (!order) return false;
+    if (bridge->pump_budget || host_control_dispatch_depth) {
+        bridge->pending_menu_warp_order = order;
+        bridge->pending_menu_warp_target = target;
+    } else {
+        /* 窗口初始化返回前交付有限前缀；回调内新请求在外层交付完成后按序消费。 */
+        bridge->pump_order_limit = order;
+        OPENHARMONY_PumpOrderedEvents(bridge, target);
+        bridge->pump_order_limit = UINT64_MAX;
+    }
+    return true;
+}
