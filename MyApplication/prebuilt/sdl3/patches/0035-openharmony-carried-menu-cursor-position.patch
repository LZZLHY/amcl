+static OPENHARMONY_MenuWarpRequest OPENHARMONY_GetMenuWarpRequest(OPENHARMONY_HostBridge *bridge)
+{
+    if (bridge->MenuWarp) return bridge->MenuWarp;
+    const char *desc = SDL_getenv_unsafe("AMCL_SDL_MENU_WARP_V1");
+    const char prefix[] = "AMCLSDLW:2:";
+    if (!desc || SDL_strncmp(desc, prefix, sizeof(prefix) - 1) != 0 ||
+        !host_look_port || !host_control_port || host_look_port->ownerHost != host_control_port->ownerHost) return NULL;
+    const char *p = desc + sizeof(prefix) - 1;
+    char *end = NULL;
+    if (*p < '0' || *p > '9' || SDL_strtoull(p, &end, 10) != (Uint64)getpid() || *end != ':') return NULL;
+    p = end + 1;
+    if (*p < '0' || *p > '9') return NULL;
+    const Uint64 request = SDL_strtoull(p, &end, 10);
+    if (!request || request >= UINTPTR_MAX || *end != ':') return NULL;
+    p = end + 1;
+    if (*p < '0' || *p > '9') return NULL;
+    const Uint64 next = SDL_strtoull(p, &end, 10);
+    if (*end || !next || next >= UINTPTR_MAX ||
+        !OPENHARMONY_VerifyMenuAddress((uintptr_t)request, "inputBridge_requestCarriedMenuWarpV1") ||
+        !OPENHARMONY_VerifyMenuAddress((uintptr_t)next, "inputBridge_sdlNextCarriedThroughV1")) return NULL;
+    bridge->LegacyNextThrough = (int (*)(int *, int *, int *, int *, int *, Uint64))(uintptr_t)next;
+    bridge->MenuWarp = (OPENHARMONY_MenuWarpRequest)(uintptr_t)request;
+    return bridge->MenuWarp;
+}
