+static void OPENHARMONY_SendTypedCandidates(
+        OPENHARMONY_HostBridge *bridge,
+        const AMCL_BackendInputEvent *event) {
+    Uint8 *encoded = NULL;
+    if (!OPENHARMONY_ReadAndReleaseText(
+            bridge, event->deviceId, (Uint32)event->code, &encoded)) {
+        return;
+    }
+    if ((Uint32)event->code < 4u ||
+        OPENHARMONY_ReadLe32(encoded) > AMCL_TEXT_MAX_ITEMS) {
+        SDL_free(encoded);
+        OPENHARMONY_RecordTextDegradation(
+            "candidates-malformed", &amcl_typed_text_degraded_candidates);
+        return;
+    }
+    const Uint32 count = OPENHARMONY_ReadLe32(encoded);
+    Uint32 offset = 4u;
+    char **items = (char **)SDL_calloc(count, sizeof(*items));
+    if (count != 0u && !items) {
+        SDL_free(encoded);
+        return;
+    }
+    bool valid = true;
+    for (Uint32 index = 0u; index < count; ++index) {
+        if (offset > (Uint32)event->code - 4u ||
+            4u > (Uint32)event->code - offset) {
+            valid = false;
+            break;
+        }
+        const Uint32 length = OPENHARMONY_ReadLe32(encoded + offset);
+        offset += 4u;
+        if (length > (Uint32)event->code - offset ||
+            length > AMCL_TEXT_MAX_BLOB_BYTES ||
+            memchr(encoded + offset, 0, length) != NULL ||
+            !OPENHARMONY_ValidUtf8Bytes(encoded + offset, length)) {
+            valid = false;
+            break;
+        }
+        items[index] = (char *)SDL_malloc((size_t)length + 1u);
+        if (!items[index]) {
+            valid = false;
+            break;
+        }
+        if (length != 0u) SDL_memcpy(items[index], encoded + offset, length);
+        items[index][length] = '\0';
+        offset += length;
+    }
+    if (!valid || offset != (Uint32)event->code) {
+        OPENHARMONY_RecordTextDegradation(
+            "candidates-malformed", &amcl_typed_text_degraded_candidates);
+    } else {
+        if ((event->resetReason != 0u &&
+             (event->modifiers != 0u ||
+              event->lockState != count))) {
+            OPENHARMONY_RecordTextDegradation(
+                "candidates-page", &amcl_typed_text_degraded_candidates);
+        }
+        SDL_SendEditingTextCandidates(
+            items, (int)count, (int)event->action, false);
+    }
+    if (items) {
+        for (Uint32 index = 0u; index < count; ++index) {
+            SDL_free(items[index]);
+        }
+        SDL_free(items);
+    }
+    SDL_free(encoded);
+}
