+static bool OPENHARMONY_ValidUtf8Bytes(const Uint8 *bytes, Uint32 length) {
+    Uint32 offset = 0u;
+    while (offset < length) {
+        const Uint8 first = bytes[offset++];
+        Uint32 need = 0u;
+        Uint32 value = 0u;
+        Uint32 minimum = 0u;
+        if (first <= 0x7fu) {
+            continue;
+        } else if (first >= 0xc2u && first <= 0xdfu) {
+            need = 1u; value = first & 0x1fu; minimum = 0x80u;
+        } else if (first >= 0xe0u && first <= 0xefu) {
+            need = 2u; value = first & 0x0fu; minimum = 0x800u;
+        } else if (first >= 0xf0u && first <= 0xf4u) {
+            need = 3u; value = first & 0x07u; minimum = 0x10000u;
+        } else {
+            return false;
+        }
+        if (need > length - offset) return false;
+        for (Uint32 i = 0u; i < need; ++i) {
+            const Uint8 continuation = bytes[offset++];
+            if ((continuation & 0xc0u) != 0x80u) return false;
+            value = (value << 6u) | (continuation & 0x3fu);
+        }
+        if (value < minimum || (value >= 0xd800u && value <= 0xdfffu) ||
+            value > 0x10ffffu) return false;
+    }
+    return true;
+}
