+#define AMCL_TEXT_BRIDGE_ENV "AMCL_BACKEND_TEXT_BRIDGE"
+#define AMCL_TEXT_BRIDGE_PREFIX "AMCLBETV:1:"
+
+/* Text blobs have their own descriptor so the frozen AMCLBEIV:1 two-slot
+ * descriptor remains source-compatible with existing SDL builds.  The middle
+ * scalar-reader slot is intentionally parsed and ignored by SDL; LWJGL2 uses
+ * it directly.  Exact whole-string matching keeps a truncated/shifted pointer
+ * list fail-closed. */
+static bool OPENHARMONY_ResolveTextBridgeFromEnvironment(
+        OPENHARMONY_HostBridge *bridge) {
+    if (!bridge) return false;
+    const char *desc = SDL_getenv_unsafe(AMCL_TEXT_BRIDGE_ENV);
+    if (!desc || SDL_strncmp(desc, AMCL_TEXT_BRIDGE_PREFIX,
+                             SDL_strlen(AMCL_TEXT_BRIDGE_PREFIX)) != 0) {
+        return false;
+    }
+    const char *cursor = desc + SDL_strlen(AMCL_TEXT_BRIDGE_PREFIX);
+    uintptr_t slots[3] = {0, 0, 0};
+    for (int i = 0; i < 3; ++i) {
+        char *end = NULL;
+        const unsigned long long value = SDL_strtoull(cursor, &end, 10);
+        if (!end || end == cursor || value == 0u) return false;
+        slots[i] = (uintptr_t)value;
+        cursor = end;
+        if (i != 2) {
+            if (*cursor != ',') return false;
+            ++cursor;
+        }
+    }
+    if (*cursor != '\0') return false;
+    bridge->TextRead = (int (*)(Uint32, Uint64, Uint8 *, Uint32, Uint32 *))
+        slots[0];
+    bridge->TextRelease = (int (*)(Uint32, Uint64))slots[2];
+    return true;
+}
