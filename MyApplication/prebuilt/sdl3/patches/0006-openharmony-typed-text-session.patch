+static bool OPENHARMONY_ReadAndReleaseText(
+        OPENHARMONY_HostBridge *bridge, Uint64 packet, Uint32 expected,
+        Uint8 **out_bytes) {
+    if (!out_bytes) return false;
+    *out_bytes = NULL;
+    OPENHARMONY_TextReadFn read = OPENHARMONY_GetTextRead(bridge);
+    OPENHARMONY_TextReleaseFn release = OPENHARMONY_GetTextRelease(bridge);
+    if (!read || !release || packet == 0u) return false;
+    Uint32 count = 0u;
+    int status = read(AMCL_BACKEND_ID_SDL3, packet, NULL, 0u, &count);
+    const int expected_status = expected == 0u
+        ? AMCL_BACKEND_RESULT_EVENT : AMCL_BACKEND_RESULT_BUFFER_TOO_SMALL;
+    if (status != expected_status || count != expected) {
+        (void)release(AMCL_BACKEND_ID_SDL3, packet);
+        return false;
+    }
+    Uint8 *bytes = (Uint8 *)SDL_malloc((size_t)expected + 1u);
+    if (!bytes) {
+        (void)release(AMCL_BACKEND_ID_SDL3, packet);
+        return false;
+    }
+    if (expected != 0u) {
+        status = read(AMCL_BACKEND_ID_SDL3, packet, bytes, expected, &count);
+    }
+    const int release_status = release(AMCL_BACKEND_ID_SDL3, packet);
+    if (status != AMCL_BACKEND_RESULT_EVENT || count != expected ||
+        (release_status != AMCL_BACKEND_RESULT_EVENT &&
+         release_status != AMCL_BACKEND_RESULT_NOT_FOUND)) {
+        SDL_free(bytes);
+        return false;
+    }
+    bytes[expected] = '\0';
+    *out_bytes = bytes;
+    return true;
+}
+
+static Uint32 OPENHARMONY_ReadLe32(const Uint8 *bytes) {
+    return (Uint32)bytes[0] | ((Uint32)bytes[1] << 8u) |
+           ((Uint32)bytes[2] << 16u) | ((Uint32)bytes[3] << 24u);
+}
