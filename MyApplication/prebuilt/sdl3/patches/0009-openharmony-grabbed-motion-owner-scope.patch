+/* A typed RELATIVE record may be injected only while a real pointer capture is
+ * granted.  This is the delivery gate for the RELATIVE case in
+ * OPENHARMONY_PumpTypedEvents, and one half of the ownership test below. */
+static bool OPENHARMONY_TypedRelativeCaptureGranted(void)
+{
+    return host_capture_requested && host_capture_active;
+}
+
+/* Who owns grabbed motion?  Only a channel that is *actually carrying* it.
+ *
+ * ⚠️ Two weaker proxies were tried and both measured wrong on a real device
+ * (MatePad, API 26); each left grabbed motion with **zero** owners, i.e. touch
+ * look silently dropped on every pump:
+ *
+ *   · "typed channel callable" (`typed_relative_owner`) -- true on 26.3 the
+ *     moment the backend descriptor resolves, while a finger-only session
+ *     produces no typed RELATIVE record at all.
+ *   · "pointer capture granted" -- true because the platform cursor lock
+ *     succeeds whenever the device merely *reports* a mouse capability
+ *     (`InputDeviceMonitor: capability changed: mouse=1` → `AMCL_CURSOR_LOCK:
+ *     cursor locked to window 89`), even with no mouse moving.  Device log:
+ *     `grabbed-motion site=typed-owner delivered=0 suppressed=8192` while the
+ *     host kept producing look samples (`AMCL_INSRC looks touch=266`).
+ *
+ * Touch look never becomes a typed RELATIVE record: the host look funnel
+ * accumulates it and it exists only in the cursor snapshot.  So ownership must
+ * transfer on evidence -- a delivered RELATIVE record -- and never on
+ * capability.  Both halves are required: `...CaptureGranted()` so a later
+ * capture loss hands ownership straight back, and `host_typed_relative_seen`
+ * so a channel that has never carried a sample cannot claim it. */
+static bool OPENHARMONY_TypedRelativeOwnsGrabbedMotion(bool typed_relative_owner)
+{
+    return typed_relative_owner && OPENHARMONY_TypedRelativeCaptureGranted() &&
+           host_typed_relative_seen;
+}
+
+static void OPENHARMONY_LogGrabbedMotion(const char *site, Uint64 count)
+{
+    if (count == 0u || (count & (count - 1u)) != 0u) {
+        return;  // first + powers of two only; steady state stays silent.
+    }
+    /* One line carries both numbers so a single grep is a complete snapshot:
+     * delivered climbing = the fallback owns look and it works; suppressed
+     * climbing while delivered stays 0 = the ownership predicate is wrong
+     * again, and grabbed motion is being dropped between the two owners. */
+    SDL_Log("openharmony: grabbed-motion site=%s delivered=%" SDL_PRIu64
+            " suppressed=%" SDL_PRIu64,
+            site, host_grabbed_motion_delivered, host_grabbed_motion_suppressed);
+}
+
 static void OPENHARMONY_PumpHostCursor(OPENHARMONY_HostBridge *bridge,
                                        bool typed_relative_owner)
