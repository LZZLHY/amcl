-         * twice. */
+    /* Grab flip is the ownership epoch boundary, and it has to be observed even
+     * on a pump that ends up suppressed: otherwise a session that once carried
+     * mouse motion would keep the accumulated cursor disowned forever, and the
+     * next finger-only grab would lose look again. */
+    if (grabbing != host_last_grabbing) {
+        host_last_grabbing = grabbing;
+        host_baseline_valid = false;
+        host_typed_relative_seen = false;
+    }
+    if (grabbing && OPENHARMONY_TypedRelativeOwnsGrabbedMotion(typed_relative_owner)) {
+        /* The typed RELATIVE record is carrying this grab. Keeping the
+         * accumulated cursor baseline live now would let a GLFW consumer in
