--- /dev/null
+++ b/src/video/openharmony/input/delivery/look_execution.h
@@ -0,0 +1,172 @@
+/**
+ * look_execution.h — 中立运行体拥有的视角执行与动作可见前缀私有端口。
+ *
+ * 此表不改变公共Core事件、GLFW/LWJGL2/SDL标准ABI，也不改变control-v1贡献合同。
+ * producer提交的设备事实、加工pending与consumer已经可用的cursor分别有权威；
+ * 不可变prefix将已接受的look与后续action连接，禁止再读未来的全局累计坐标。
+ * 三ABI只转换自己的坐标/记录格式及报告真实完成点，不能各自复制积分或尾量状态机。
+ */
+#ifndef AMCL_INPUT_LOOK_EXECUTION_H
+#define AMCL_INPUT_LOOK_EXECUTION_H
+#include <stdint.h>
+#include <stddef.h>
+#include "control_delivery.h"
+#include "../amcl_input_event.h"
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+#define AMCL_LOOK_EXECUTION_MAGIC UINT64_C(0x414d434c4c4f4f31)
+#define AMCL_LOOK_EXECUTION_VERSION 1u
+#define AMCL_LOOK_EXECUTION_ENV "AMCL_LOOK_EXECUTION_V1"
+#define AMCL_LOOK_EXECUTION_PREFIX "AMCLLOOK:1:"
+
+/** 结果区分来源事实接受、可交付前缀、暂缺资格与容量失败，不能转bool混淆负值。 */
+enum AmclLookResult {
+    AMCL_LOOK_REJECTED=-1,AMCL_LOOK_STALE=-2,AMCL_LOOK_PRESSURE=-3,
+    AMCL_LOOK_NOT_READY=-4,AMCL_LOOK_ACCEPTED_NO_MOTION=0,AMCL_LOOK_PREFIX_READY=1
+};
+/** 单位随流冻结。virtual counts没有物理长度/角度承诺，raw counts保持平台能力声明。 */
+enum AmclLookUnit {
+    AMCL_LOOK_SURFACE_PIXELS=1,AMCL_LOOK_VIRTUAL_COUNTS=2,
+    AMCL_LOOK_HARDWARE_COUNTS=3,AMCL_LOOK_VIRTUAL_COUNTS_PER_SECOND=4,
+    AMCL_LOOK_PLATFORM_RELATIVE_COUNTS=5
+};
+/** 仅显式同域时间能积分；同为ns不证明sensor startup与ACTIVE/Native monotonic同域。 */
+enum AmclLookClock {
+    AMCL_LOOK_OWNER_MONOTONIC=1,AMCL_LOOK_ACTIVE_UPTIME=2,
+    AMCL_LOOK_SENSOR_STARTUP=3,AMCL_LOOK_PLATFORM_SAMPLE=4
+};
+/** 已积分gyro保持独立无平滑时钟；手指与gyro共用触控政策但不是同一个运动流。 */
+enum AmclLookStreamKind {
+    AMCL_LOOK_TOUCH_DELTA=1,AMCL_LOOK_MAPPED_RATE=2,
+    AMCL_LOOK_PHYSICAL_DELTA=3,AMCL_LOOK_GYRO_DELTA=4,AMCL_LOOK_COMPAT_DELTA=5
+};
+/** 仅新gyro私有lease冻结policy；旧无lease符号明确弱兼容，不能假用跨域时间拒旧样本。 */
+#define AMCL_LOOK_STREAM_POLICY_LEASE 1u
+/**
+ * 真实资源事实由owner Core和模式公告核验。context比较沿既有完整身份规则，Hz仍只是
+ * 元数据；modeEpoch不能由物理captureActive替代，非物理world look使用实际逻辑grab。
+ */
+typedef struct AmclLookResourceV1 {
+    uint32_t size,grabbed;
+    uint64_t gameSession,sessionEpoch,surfaceEpoch,focusEpoch,modeEpoch;
+    AmclInputSurfaceContextPayload context;
+} AmclLookResourceV1;
+/**
+ * 来源流首次登记冻结device/connection、单位、时钟与资源，失败清零handle。设备0是
+ * 明确兼容桶而非已验证硬件身份；mapped兼容桶也拥有非零逻辑connection，其他0桶为0。
+ * source使用platform AmclInputSource，不能拿typed
+ * event的source枚举替换。handle不回绕/复用，迟到提交不能认领后来同编号设备。
+ */
+typedef struct AmclLookStreamV1 {
+    uint32_t size,source,kind,unit,clock,reserved;
+    uint64_t device,connection;
+    AmclLookResourceV1 resource;
+} AmclLookStreamV1;
+/** 完整兼容政策一次验证/应用；旧pending已经在输出单位中，不被新参数重新缩放。 */
+typedef struct AmclLookPolicyV1 {
+    uint32_t size,invertY;
+    double sensitivity,smoothing,acceleration;
+} AmclLookPolicyV1;
+/**
+ * producer只运输opaque prefix token和因果order。其数值/贡献/原资源存于唯一owner，
+ * immutable记录存在固定容量预算；排队接受、consumer cache可用、callback/ADD及
+ * 游戏实际读取是不同完成点，不能把prefix创建成功说成游戏已转动相机。
+ */
+typedef struct AmclLookPrefixV1 {
+    uint32_t size,reserved;
+    uint64_t token,order,gameSession;
+    AmclLookResourceV1 resource;
+} AmclLookPrefixV1;
+/**
+ * 本consumer一次执行票。current是按该consumer已应用前缀演化的cursor，delta仅含
+ * 本次尚未应用部分；ABI边缘不得改target/activation或重新从future desired计算delta。
+ */
+typedef struct AmclLookEmissionV1 {
+    uint32_t size,backend;
+    uint64_t consumer,activation,target,ticket,prefix,order;
+    double dx,dy,x,y;
+} AmclLookEmissionV1;
+/** 私有只读观测；cacheReady说明API数据可用，不声称Minecraft camera/attack已采纳。 */
+typedef struct AmclLookSnapshotV1 {
+    uint32_t size,backend;
+    uint64_t consumer,gameSession,activation,target,availablePrefix;
+    uint64_t accepted,cacheReady,callbackReturned,queueAccepted,legalPollReads;
+    uint64_t stale,discarded,uncertain;
+    double x,y;
+} AmclLookSnapshotV1;
+/**
+ * table/ownerHost/PID在预线程module发布后不可变，所有借用遵守Core descriptor与原
+ * 映像可执行地址检查。fork foreign PID在任何registry mutex/首次初始化之前拒绝。
+ */
+typedef struct AmclLookExecutionPortV1 {
+    uint64_t magic;
+    uint32_t version,size,pid,reserved;
+    uint64_t ownerHost;
+    int32_t (*verifyOwner)(uint64_t ownerHost);
+    /** 同一实际启动身份绑定一次；准备不创建worker、不装游戏类、不假宣布consumer Ready。 */
+    int32_t (*bindSession)(uint64_t gameSession);
+    /** 只接受实际bridge模式发布，模式退休丢旧未交付量，不把它补进新world基准。 */
+    int32_t (*publishMode)(uint64_t gameSession,uint64_t modeEpoch,uint32_t grabbed);
+    /** 保存完整兼容政策，source=-1全来源；拒绝任何字段时不应用半份参数。 */
+    int32_t (*applyPolicy)(int32_t source,const AmclLookPolicyV1* policy);
+    int32_t (*openStream)(const AmclLookStreamV1* stream,uint64_t* handle);
+    /** delta已经按该流单位给出；gyro不得再按dt积分，physical不得套映射gain。 */
+    int32_t (*submitDelta)(uint64_t stream,double dx,double dy,uint64_t sampleNs);
+    /** 先将旧速度推进到此样本边界，再安装新速度；重复时刻不双积分。 */
+    int32_t (*submitVelocity)(uint64_t stream,double xPerSecond,double yPerSecond,uint64_t sampleNs);
+    /** timer/事件只推进已有速率。长期间隔采用明确最多50ms政策，不补后台时间。 */
+    int32_t (*advance)(uint64_t gameSession,uint64_t ownerMonotonicNs);
+    /**
+     * action/tick封已知前缀；flushPending只取已接受旧尾量，不外推未来sensor样本。
+     * 与实际运输容量预留同批提交才可称接受，取消/Pressure不得发布假token。
+     */
+    int32_t (*sealPrefix)(uint64_t gameSession,uint64_t order,uint64_t ownerMonotonicNs,
+        uint32_t flushPending,AmclLookPrefixV1* prefix);
+    /** 仅源自己的未应用贡献退休；已写ABI的运动不逆向回滚，也不清同目标兄弟来源。 */
+    int32_t (*retireStream)(uint64_t stream);
+    /** producer运输确认或撤销原token；不得释放后来prefix，源退休仍可撤其尚未交付部分。 */
+    int32_t (*retirePrefix)(uint64_t token);
+    /**
+     * 借用实际control consumer身份，snapshot验证其kind/session/activation/target；不
+     * 再建控制owner。basis来自原ABI模式/合法warp基线，新target不继承历史look。
+     */
+    int32_t (*bindConsumer)(uint64_t controlConsumer,double basisX,double basisY);
+    int32_t (*prepare)(uint64_t controlConsumer,uint64_t prefix,AmclLookEmissionV1* emission);
+    int32_t (*claim)(const AmclLookEmissionV1* emission);
+    int32_t (*validate)(const AmclLookEmissionV1* emission);
+    /** completion沿control阶段名称，SDL queue只证明真实ADD，L2实际poll/next另观测。 */
+    int32_t (*complete)(const AmclLookEmissionV1* emission,uint32_t completion);
+    int32_t (*observePoll)(uint64_t controlConsumer,double actualX,double actualY);
+    int32_t (*snapshot)(uint64_t controlConsumer,AmclLookSnapshotV1* snapshot);
+    void (*closeConsumer)(uint64_t controlConsumer);
+    /** 有界重试最终放弃仅本consumer的此token运输。必须先撤原票，不终结在途SDK调用。 */
+    int32_t (*abandonPrefix)(uint64_t controlConsumer,uint64_t prefix);
+    /**
+     * typed relative原Core sequence关联一次接受时加工的独立physical prefix。
+     * 不重新加工raw、不合并虚拟prefix；SDL沿原record device映射MouseID，公开raw字段不变。
+     */
+    int32_t (*physicalPrefix)(uint64_t coreSequence,uint64_t* prefix);
+    /** ordered backend envelope的sequence是interactionOrder，必须显式选此索引，不能猜同值。 */
+    int32_t (*physicalPrefixByOrder)(uint64_t interactionOrder,uint64_t* prefix);
+    /** 实际look出口能力寿命，L2 Mouse独立于Keyboard；停止仅退出本backend，不关控制owner。 */
+    int32_t (*setBackendActive)(uint32_t backend,uint32_t active);
+} AmclLookExecutionPortV1;
+
+AMCL_CONTROL_PUBLIC const AmclLookExecutionPortV1* amclLookExecutionGetPortV1(void);
+AMCL_CONTROL_PUBLIC void amclLookExecutionPublishV1(void);
+/** 无外部查询的producer事务口；真实队列先预留容量，再原子提交数学和不可变token。 */
+AMCL_CONTROL_PUBLIC int32_t amclLookExecutionCommitV1(uint64_t stream,double dx,double dy,uint64_t sampleNs,
+    uint64_t gameSession,uint64_t order,uint64_t ownerNs,uint32_t flush,AmclLookPrefixV1* output);
+/** 明确旧processed兼容路径：不再次应用policy，仍与真实运输一批提交。 */
+AMCL_CONTROL_PUBLIC int32_t amclLookExecutionCommitProcessedV1(uint64_t stream,double dx,double dy,
+    uint64_t gameSession,uint64_t order,uint64_t ownerNs,AmclLookPrefixV1* output);
+/** ring当前实际接收者按位冻结；取得ring记录不等于完成，终结或明确退休才解除保留。 */
+AMCL_CONTROL_PUBLIC void amclLookExecutionSetRecipientsV1(uint64_t token,uint32_t backendMask);
+/** 只读完整source政策代次；参数相同幂等不推进，0表示不可用/非法source。 */
+AMCL_CONTROL_PUBLIC uint64_t amclLookPolicyEpochV1(int32_t source);
+#ifdef __cplusplus
+}
+#endif
+#endif
diff --git a/src/video/openharmony/input/delivery/look_execution_client.h b/src/video/openharmony/input/delivery/look_execution_client.h
new file mode 100644
--- /dev/null
+++ b/src/video/openharmony/input/delivery/look_execution_client.h
@@ -0,0 +1,47 @@
+/** 跨DSO look端口只读身份检查；复用control映像/可执行地址探针，不复制执行状态。 */
+#ifndef AMCL_LOOK_EXECUTION_CLIENT_H
+#define AMCL_LOOK_EXECUTION_CLIENT_H
+#include "look_execution.h"
+#include "control_delivery_client.h"
+static inline int32_t amclLookExecutionResolveV1(const AmclLookExecutionPortV1** output){
+    if(output)*output=NULL;if(!output)return AMCL_LOOK_REJECTED;
+    const char* text=getenv(AMCL_LOOK_EXECUTION_ENV);if(!text)return AMCL_LOOK_NOT_READY;
+    if(strncmp(text,AMCL_LOOK_EXECUTION_PREFIX,sizeof(AMCL_LOOK_EXECUTION_PREFIX)-1)!=0)return AMCL_LOOK_REJECTED;
+    const char* number=text+sizeof(AMCL_LOOK_EXECUTION_PREFIX)-1;if(*number<'0'||*number>'9')return AMCL_LOOK_REJECTED;
+    char* end=NULL;errno=0;const unsigned long long value=strtoull(number,&end,10);
+    if(errno||end==number||*end||!value||value>=UINTPTR_MAX)return AMCL_LOOK_REJECTED;
+    const uintptr_t address=(uintptr_t)value;uintptr_t base=0;uint32_t process=0;
+#ifdef _WIN32
+    HMODULE image=NULL;
+    if(!GetModuleHandleExA(GET_MODULE_HANDLE_EX_FLAG_FROM_ADDRESS|GET_MODULE_HANDLE_EX_FLAG_UNCHANGED_REFCOUNT,
+        (LPCSTR)address,&image)||(uintptr_t)GetProcAddress(image,"amclLookExecutionGetPortV1")!=address)return AMCL_LOOK_REJECTED;
+    base=(uintptr_t)image;process=(uint32_t)_getpid();
+#else
+    Dl_info info;if(!dladdr((const void*)address,&info)||info.dli_saddr!=(void*)address||!info.dli_sname||
+        strcmp(info.dli_sname,"amclLookExecutionGetPortV1")!=0)return AMCL_LOOK_REJECTED;
+    const char* leaf=info.dli_fname?strrchr(info.dli_fname,'/'):NULL;leaf=leaf?leaf+1:info.dli_fname;
+#ifndef AMCL_CONTROL_DELIVERY_HOST_TESTING
+    if(!leaf||strcmp(leaf,"libamcl_input_runtime.so")!=0)return AMCL_LOOK_REJECTED;
+#else
+    (void)leaf;
+#endif
+    base=(uintptr_t)info.dli_fbase;process=(uint32_t)getpid();
+#endif
+    if(!amclControlAddressInOwner(address,base))return AMCL_LOOK_REJECTED;
+    typedef const AmclLookExecutionPortV1*(*Getter)(void);const AmclLookExecutionPortV1* port=((Getter)address)();
+    if(!port||port->magic!=AMCL_LOOK_EXECUTION_MAGIC||port->version!=1||port->size!=sizeof(*port)||
+        port->pid!=process||!port->ownerHost)return AMCL_LOOK_REJECTED;
+#define AMCL_LOOK_CHECK(name) if(!amclControlAddressInOwner((uintptr_t)port->name,base))return AMCL_LOOK_REJECTED
+    AMCL_LOOK_CHECK(verifyOwner);AMCL_LOOK_CHECK(bindSession);AMCL_LOOK_CHECK(publishMode);AMCL_LOOK_CHECK(applyPolicy);
+    AMCL_LOOK_CHECK(openStream);AMCL_LOOK_CHECK(submitDelta);AMCL_LOOK_CHECK(submitVelocity);AMCL_LOOK_CHECK(advance);
+    AMCL_LOOK_CHECK(sealPrefix);AMCL_LOOK_CHECK(retireStream);AMCL_LOOK_CHECK(retirePrefix);AMCL_LOOK_CHECK(bindConsumer);
+    AMCL_LOOK_CHECK(prepare);AMCL_LOOK_CHECK(claim);AMCL_LOOK_CHECK(validate);AMCL_LOOK_CHECK(complete);
+    AMCL_LOOK_CHECK(observePoll);AMCL_LOOK_CHECK(snapshot);AMCL_LOOK_CHECK(closeConsumer);
+    AMCL_LOOK_CHECK(abandonPrefix);
+    AMCL_LOOK_CHECK(physicalPrefix);
+    AMCL_LOOK_CHECK(physicalPrefixByOrder);AMCL_LOOK_CHECK(setBackendActive);
+#undef AMCL_LOOK_CHECK
+    // 唯一Core descriptor核验是独立必要条件，另一个真实DSO也不能借同PID/合法代码骗owner。
+    const int32_t result=port->verifyOwner(port->ownerHost);if(result<0)return result;*output=port;return 0;
+}
+#endif
diff --git a/src/video/openharmony/input/delivery/control_delivery.h b/src/video/openharmony/input/delivery/control_delivery.h
new file mode 100644
--- /dev/null
+++ b/src/video/openharmony/input/delivery/control_delivery.h
@@ -0,0 +1,107 @@
+// 三种实际ABI共用的末级控制贡献端口。只有neutral owner持有归约状态；调用者只保存
+// 不复用consumer句柄、实际ABI缓存与回调。此私有C表不改变公共Core/旧事件的前缀语义。
+#ifndef AMCL_CONTROL_DELIVERY_H
+#define AMCL_CONTROL_DELIVERY_H
+#include <stdint.h>
+#include <stddef.h>
+#ifdef __cplusplus
+extern "C" {
+#endif
+#if defined(__GNUC__)
+#define AMCL_CONTROL_PUBLIC __attribute__((visibility("default")))
+#else
+#define AMCL_CONTROL_PUBLIC
+#endif
+#define AMCL_CONTROL_MAGIC UINT64_C(0x414d434c434f4e31)
+#define AMCL_CONTROL_VERSION 1u
+#define AMCL_CONTROL_ENV "AMCL_CONTROL_DELIVERY_V1"
+#define AMCL_CONTROL_PREFIX "AMCLCONTROL:1:"
+enum AmclControlResult { AMCL_CONTROL_REJECTED=-1, AMCL_CONTROL_STALE=-2,
+    AMCL_CONTROL_PRESSURE=-3, AMCL_CONTROL_NOT_READY=-4,
+    AMCL_CONTROL_ACCEPTED_NO_EDGE=0, AMCL_CONTROL_EDGE=1 };
+enum AmclControlKind { AMCL_CONTROL_KEY=1, AMCL_CONTROL_BUTTON=2 };
+// 与GLFW/L2既有action一致；SDL只在此边缘把UP/DOWN转换，不能再次解释来源持有。
+enum AmclControlAction { AMCL_CONTROL_UP=0, AMCL_CONTROL_DOWN=1, AMCL_CONTROL_REPEAT=2 };
+// Aggregate表示上游已经汇总的一份贡献；SDL设备按钮与未来contact保留独立owner。
+enum AmclControlClass { AMCL_CONTROL_LEGACY=1, AMCL_CONTROL_TYPED=2,
+    AMCL_CONTROL_TYPED_DEVICE=3, AMCL_CONTROL_CONTACT=4 };
+#define AMCL_CONTROL_MASK_LEGACY 1u
+#define AMCL_CONTROL_MASK_TYPED 6u
+#define AMCL_CONTROL_MASK_ALL 15u
+// STATE_ONLY仅证明ABI缓存已应用且保留ticket；L2 enqueue不属于PULL_COMMITTED，
+// 该端须直到真实Mouse/Keyboard next领取才终结。SDL的PULL_COMMITTED只证明其
+// SDL_Send*队列/ABI出口交接，不能宣传为游戏SDL_PollEvent已经处理。
+enum AmclControlCompletion { AMCL_CONTROL_STATE_ONLY=0, AMCL_CONTROL_CALLBACK_RETURNED=1,
+    AMCL_CONTROL_PULL_COMMITTED=2, AMCL_CONTROL_STATE_FINAL=3,
+    AMCL_CONTROL_UNCERTAIN=4, AMCL_CONTROL_DISCARDED=5 };
+typedef struct AmclControlEmissionV1 {
+    // ABI边缘只复制这份冻结记录，complete/validate不得换成current target/consumer。
+    // size须为完整V1，code/scanCode是本consumer后端命名空间，action为最终交付边沿。
+    uint32_t size,kind;
+    int32_t code,scanCode,action;
+    uint32_t reserved;
+    uint64_t consumer,activation,revision,ticket,target;
+} AmclControlEmissionV1;
+typedef struct AmclControlSnapshotV1 {
+    // 统计带原consumer/session/activation/target；计数分别表示cache、callback返回、
+    // 实际pull出口/队列交接及合法getter读取，任何一列均不代替“游戏业务已经处理”。
+    uint32_t size,backend;
+    uint64_t consumer,gameSession,activation,target;
+    uint64_t accepted,noEdge,edges,callbackReturned,pullCommitted,stateOnly;
+    uint64_t legalPollReads,pollMismatches,staleCompletions,lastCompletedActivation,uncertain,discarded;
+} AmclControlSnapshotV1;
+typedef struct AmclControlDeliveryPortV1 {
+    uint64_t magic;
+    uint32_t version,size,pid,reserved;
+    // 同一neutral owner的公共Core表身份；验证还必须经过既有owner descriptor，不能只核pid。
+    uint64_t ownerHost;
+    int32_t (*verifyOwner)(uint64_t ownerHost);
+    // target为调用方真实逻辑目标；生命周期、publication和执行线程仍在ABI边缘核对。
+    // open只登记consumer，不初始化SDK/设备或宣布Ready；失败清零输出，容量/身份耗尽为PRESSURE。
+    int32_t (*open)(uint32_t backend,uint64_t target,uint64_t* consumer);
+    // 关闭指定handle的内部上下文，不调用旧窗口或合成release；真实资源退休由边缘先处理。
+    void (*close)(uint64_t consumer);
+    // activation耗尽时返回PRESSURE且不改旧target；边缘必须停止向新目标交付。
+    int32_t (*bindTarget)(uint64_t consumer,uint64_t target);
+    // apply提交一份来源变化；Rejected不配对、NoEdge真实共持、Edge附须claim的冻结票。
+    // 候选分配/容量失败不建立假owner；此处成功不证明cache/callback/queue/游戏读取成功。
+    int32_t (*apply)(uint64_t consumer,uint32_t contributionClass,uint64_t owner,
+        uint32_t kind,int32_t code,int32_t scanCode,int32_t action,AmclControlEmissionV1* emission);
+    // retire先一次摘本批旧owner，nextRetired随后逐ticket核reentry新holder，不在锁内输出。
+    int32_t (*retire)(uint64_t consumer,uint32_t classMask,uint64_t owner,int32_t onlyOwner);
+    // L2 keyboard/mouse能力寿命独立：kind=0全部，1键盘，2鼠标；单kind不退休兄弟记录。
+    int32_t (*retireKind)(uint64_t consumer,uint32_t classMask,uint64_t owner,int32_t onlyOwner,uint32_t kind);
+    // 每次领取一张仍有效的退休计划；空为NoEdge，目标或贡献已变的旧计划在内部丢弃。
+    int32_t (*nextRetired)(uint64_t consumer,AmclControlEmissionV1* emission);
+    // 一次性执行围栏：完整记录/当前资格成立才Edge；重复claim拒绝，旧目标/activation为STALE。
+    int32_t (*claim)(const AmclControlEmissionV1* emission);
+    // 同步SDK hook可在缓存写回/Push之前再次只读核原ticket；不是重复领取或重新绑定。
+    int32_t (*validate)(const AmclControlEmissionV1* emission);
+    // 输入原票及真实完成阶段；phase0保票，终结阶段摘票。旧callback返回可记原事实，
+    // 但不能覆盖重入后的observed状态；失败/不确定不伪造cache或事件交接。
+    int32_t (*complete)(const AmclControlEmissionV1* emission,uint32_t phase);
+    // 只读accepted desired（0/1）；负值明确失败，不应以C布尔转换把STALE解释为按住。
+    int32_t (*query)(uint64_t consumer,uint32_t kind,int32_t code);
+    // query为接受贡献，queryDelivered仅为已获phase0证据的ABI缓存，两种口径不可混用。
+    int32_t (*queryDelivered)(uint64_t consumer,uint32_t kind,int32_t code);
+    // 观测只计实际调用方已经执行的poll读取，永不推进事件或改变owner。
+    int32_t (*observePoll)(uint64_t consumer,uint32_t kind,int32_t code,int32_t actualHeld);
+    // 完整Keyboard/Mouse状态getter一次调用一次锁；只核已登记control的实际0/1缓存。
+    // legalPollReads按getter调用计，mismatch按已登记control差异计，绝不推进owner或事件。
+    int32_t (*observePollView)(uint64_t consumer,uint32_t kind,const uint8_t* states,uint32_t count);
+    // 输出完整V1诊断快照，不消费任何队列或推进ticket；调用者须核返回结果，不用旧输出。
+    int32_t (*snapshot)(uint64_t consumer,AmclControlSnapshotV1* output);
+    // activation耗尽时永久关闭此handle；绝不回绕成旧activation。
+    void (*abandon)(uint64_t consumer);
+} AmclControlDeliveryPortV1;
+// 表与registry在module早期发布时初始化，进程内不可变；fork child明确拒绝继承，
+// Getter返回NULL，所有旧handle操作在任何继承mutex之前返回STALE/NOT_READY。
+AMCL_CONTROL_PUBLIC const AmclControlDeliveryPortV1* amclControlDeliveryGetPortV1(void);
+// 只由既有中立bridge的冻结游戏会话入口调用；重复同session幂等，不能换掉借出的owner。
+AMCL_CONTROL_PUBLIC int32_t amclControlDeliveryBindSessionV1(uint64_t gameSession);
+// module Init早于JVM线程的既有发布点调用；描述符只包含同owner getter地址，重复无写入。
+AMCL_CONTROL_PUBLIC void amclControlDeliveryPublishV1(void);
+#ifdef __cplusplus
+}
+#endif
+#endif
diff --git a/src/video/openharmony/input/delivery/control_delivery_client.h b/src/video/openharmony/input/delivery/control_delivery_client.h
new file mode 100644
--- /dev/null
+++ b/src/video/openharmony/input/delivery/control_delivery_client.h
@@ -0,0 +1,96 @@
+// 跨namespace的薄C身份检查层，仅发现/验证neutral生产端口，不复制任何owner或归约状态。
+// SDL/L2在自己的合法初始化点使用；缺席与损坏分开，坏描述符不能绕dlsym另开第二份owner。
+#ifndef AMCL_CONTROL_DELIVERY_CLIENT_H
+#define AMCL_CONTROL_DELIVERY_CLIENT_H
+#include "control_delivery.h"
+#include <stdlib.h>
+#include <string.h>
+#include <errno.h>
+#ifdef _WIN32
+#include <windows.h>
+#include <process.h>
+#else
+#include <dlfcn.h>
+#include <link.h>
+#include <unistd.h>
+#endif
+
+#ifndef _WIN32
+// dl_iterate_phdr的一次只读查询上下文：address为待调用函数地址，executable仅由
+// 实际PT_LOAD/PF_X覆盖事实置true。不持有DSO引用，调用方另负责进程期pin。
+typedef struct AmclControlAddressCheck {uintptr_t address;int executable;} AmclControlAddressCheck;
+// 输入为加载器枚举的单个映像及上述上下文；找到可执行段就停止枚举并返回1。
+// 段起点先防整数溢出，不按函数名/PID猜可执行资格，也不把未覆盖地址当成功。
+static int amclControlVisitExecutable(struct dl_phdr_info* info,size_t size,void* data){
+    AmclControlAddressCheck* check=(AmclControlAddressCheck*)data;(void)size;
+    for(size_t i=0;i<info->dlpi_phnum;++i){const ElfW(Phdr)* p=&info->dlpi_phdr[i];
+        if(p->p_type!=PT_LOAD||!(p->p_flags&PF_X)||p->p_vaddr>UINTPTR_MAX-(uintptr_t)info->dlpi_addr)continue;
+        const uintptr_t start=(uintptr_t)info->dlpi_addr+(uintptr_t)p->p_vaddr;
