+ * virtual counts 写成 public raw。队列过滤/disabled 不撤已应用运动，也不假称 ADD。 */
+static void OPENHARMONY_DeliverLookForMouse(Uint64 token, SDL_MouseID mouse_id, Uint64 timestamp)
+{
+    if (!token || !host_look_port || !host_control_consumer) return;
+    /* 停源可能发生在 prepare 与真实 cache 之间；最多一次重取同 token 的仍活动兄弟贡献。
+     * 已写 cache 的运动绝不重试/回滚；target/resource 退休则 prepare/current 仍然拒绝。 */
+    for (int attempt = 0; attempt < 2; ++attempt) {
+        AmclLookEmissionV1 emission;
+        if (host_look_port->prepare(host_control_consumer, token, &emission) != AMCL_LOOK_PREFIX_READY) break;
+        OPENHARMONY_LookContext context = { host_look_port, emission };
+        if (context.port->claim(&emission) != AMCL_LOOK_PREFIX_READY) {
+            (void)context.port->complete(&emission, AMCL_CONTROL_DISCARDED);
+            continue;
+        }
+        const float dx = (float)emission.dx, dy = (float)emission.dy;
+        if (!isfinite(dx) || !isfinite(dy)) {
+            (void)context.port->complete(&emission, AMCL_CONTROL_DISCARDED);
+            break;
+        }
+        if (!OPENHARMONY_LookCurrent(&context)) {
+            (void)context.port->complete(&emission, AMCL_CONTROL_DISCARDED);
+            continue;
+        }
