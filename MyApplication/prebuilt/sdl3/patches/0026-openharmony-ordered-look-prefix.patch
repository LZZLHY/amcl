+        if (window) SDL_SendMouseMotionWithReceipt(timestamp, window, mouse_id, true, dx, dy, &receipt);
+        --host_control_dispatch_depth;
+        (void)context.port->complete(&emission, receipt.posted ? AMCL_CONTROL_PULL_COMMITTED :
+            (receipt.cached ? AMCL_CONTROL_STATE_FINAL : AMCL_CONTROL_DISCARDED));
+        if (receipt.cached) return;
+    }
+    (void)host_look_port->abandonPrefix(host_control_consumer, token);
