+bool OPENHARMONY_DesktopFullscreen(SDL_Window *window, SDL_VideoDisplay *display,
+                                  SDL_FullscreenOp operation, SDL_FullscreenResult *result)
+{
+    if (!OPENHARMONY_IsDesktopDevice() || !Presented(window)) {
+        return false;
+    }
+    /* 桌面桥拥有实际窗口状态。拒绝目标屏或提交失败时，不让 SDL 再发一次相反的 LEAVE。 */
+    *result = SDL_FULLSCREEN_FAILED;
+    const AmclDesktopHostV1 *api = DesktopHost();
+    AmclDesktopSnapshot facts;
+    if (!api) {
+        SDL_SetError("Desktop fullscreen requires the system window bridge");
+        return true;
+    }
+    api->snapshot(&facts);
+    if (!facts.active || facts.width <= 0 || facts.height <= 0) {
+        SDL_SetError("Desktop fullscreen requires a live system window");
+        return true;
+    }
+
+    /* UPDATE 保持全屏，只有 LEAVE 可以还原宿主窗口。同屏换模式不请求物理切屏。 */
+    const bool enabled = operation != SDL_FULLSCREEN_OP_LEAVE;
+    const Sint64 display_id = enabled && display && display->internal ? display->internal->native_id : -1;
+    SDL_DisplayMode requested_mode;
+    SDL_zero(requested_mode);
+    if (enabled) requested_mode = window->requested_fullscreen_mode;
+    /* 请求快照只保留显示模式值，显示热拔插可以独立退休驱动私有模式数据。 */
+    requested_mode.internal = NULL;
+    ObserveFullscreenCompletion(window, &facts);
+    RestoreConfirmedFullscreenMode(window, &facts);
+    const bool actual_matches = FullscreenMatches(&facts, enabled, display_id);
+    const bool same_target = enabled == fullscreen_request.enabled && display_id == fullscreen_request.display;
+    if (fullscreen_request.rejected) {
+        const Sint32 error = fullscreen_request.error;
+        SDL_zero(fullscreen_request);
+        if (same_target && !actual_matches) {
+            /* 将一次异步拒绝交还调用者，避免按帧重复申请。之后的主动重试仍允许。 */
+            SDL_SetError("System rejected fullscreen transition (code=%d)", error);
+            return true;
+        }
+    }
+    if (fullscreen_request.sequence) {
+        if (same_target) {
+            if (fullscreen_request.timed_out && !fullscreen_request.timeout_reported) {
+                /* 下次同目标调用必须让上层回退期望值。旧命令仍可完成，不能把它当成新请求。 */
+                fullscreen_request.timeout_reported = true;
+                SDL_SetError("Timed out waiting for desktop fullscreen state");
+            } else {
+                *result = SDL_FULLSCREEN_PENDING;
+            }
+            return true;
+        }
+        /* 目标已改变。仍须排队抵消可能已经在执行的旧请求，即使当前窗口恰好符合新目标。 */
+    } else if (actual_matches) {
+        window->internal->desktop_confirmed_fullscreen_mode = requested_mode;
+        *result = SDL_FULLSCREEN_SUCCEEDED;
+        ReconcileFullscreen(window, &facts);
+        return true;
+    }
+
+    const Uint64 sequence = api->submit(AMCL_DESKTOP_FULLSCREEN, enabled, (Sint32)display_id, 0, 0, NULL);
+    if (!sequence) {
+        SDL_SetError("Desktop fullscreen command rejected");
+        return true;
+    }
+    fullscreen_request.sequence = sequence;
+    fullscreen_request.generation = facts.generation;
+    fullscreen_request.window = window->id;
+    fullscreen_request.host_window = facts.windowId;
+    fullscreen_request.display = display_id;
+    fullscreen_request.mode = requested_mode;
+    fullscreen_request.enabled = enabled;
+    fullscreen_request.timed_out = false;
+    fullscreen_request.timeout_reported = false;
+    *result = SDL_FULLSCREEN_PENDING;
+    return true;
+}
