+static bool SyncDesktopWindow(SDL_VideoDevice *device, SDL_Window *window)
+{
+    (void)device;
+    if (!fullscreen_request.sequence || fullscreen_request.window != window->id) {
+        return true;
+    }
+    const AmclDesktopHostV1 *api = DesktopHost();
+    if (!api) {
+        SDL_zero(fullscreen_request);
+        return SDL_SetError("Desktop fullscreen system window bridge disconnected");
+    }
+    const Uint64 deadline = SDL_GetTicksNS() + SDL_MS_TO_NS(1500);
+    const SDL_WindowID window_id = window->id;
+    for (;;) {
+        const Uint64 observed = api->eventEpoch();
+        AmclDesktopSnapshot facts;
+        api->snapshot(&facts);
+        if (!FullscreenRequestBelongsTo(window_id, &facts)) {
+            /* 旧宿主的确认不能借同一个 SDL 窗口继续有效。 */
+            SDL_zero(fullscreen_request);
+            SDL_zero(window->internal->desktop_confirmed_fullscreen_mode);
+            SDL_zero(window->current_fullscreen_mode);
+            window->fullscreen_exclusive = false;
+            return SDL_SetError("Desktop fullscreen system window was replaced");
+        }
+        if (facts.completed >= fullscreen_request.sequence) {
+            const Sint32 error = facts.completed == fullscreen_request.sequence ? facts.lastError : 0;
+            if (!ReconcileFullscreen(window, &facts)) {
+                return SDL_SetError("System rejected fullscreen transition (code=%d)", error);
+            }
+            return true;
+        }
+        const Uint64 now = SDL_GetTicksNS();
+        if (fullscreen_request.timed_out || now >= deadline) {
+            /* 仍接收迟到确认；重复同步既不重新提交，也不再次阻塞渲染线程。 */
+            fullscreen_request.timed_out = true;
+            return SDL_SetError("Timed out waiting for desktop fullscreen state");
+        }
+        /* ArkUI 完成命令后唤醒。短等待也能处理在确认前先发布窗口状态的旧宿主。 */
+        api->waitEvents(observed, (Sint64)SDL_min(deadline - now, SDL_MS_TO_NS(16)));
+    }
+}
