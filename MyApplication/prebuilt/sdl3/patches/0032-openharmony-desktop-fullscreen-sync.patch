+static void RestoreConfirmedFullscreenMode(SDL_Window *window, const AmclDesktopSnapshot *facts)
+{
+    /* 公共显示查询必须看到宿主仍在使用的屏和模式。SDL 的 requested mode 留给下一次显式请求。 */
+    const SDL_DisplayMode *mode = &window->internal->desktop_confirmed_fullscreen_mode;
+    if (facts->status == 1 && mode->displayID) {
+        for (int i = 0; i < AMCL_DESKTOP_MAX_DISPLAYS; ++i) {
+            if (displays[i] == mode->displayID && native_displays[i] == facts->displayId) {
+                window->current_fullscreen_mode = *mode;
+                window->fullscreen_exclusive = true;
+                return;
+            }
+        }
+    }
+    SDL_zero(window->current_fullscreen_mode);
+    window->fullscreen_exclusive = false;
+    /* 同一宿主事务可先恢复浮窗再补偿回原屏。公开模式反映中间态，旧确认仅保留到命令完成。 */
+    const bool awaiting_completion = fullscreen_request.sequence &&
+                                     facts->completed < fullscreen_request.sequence &&
+                                     FullscreenRequestBelongsTo(window->id, facts);
+    if (facts->status != 1 && !awaiting_completion) {
+        SDL_zero(window->internal->desktop_confirmed_fullscreen_mode);
+    }
+}
