+static bool ReconcileFullscreen(SDL_Window *window, const AmclDesktopSnapshot *facts)
+{
+    ObserveFullscreenCompletion(window, facts);
+    RestoreConfirmedFullscreenMode(window, facts);
+    const bool rejected = fullscreen_request.rejected;
+
+    /* 游戏请求和系统标题栏操作共用实际状态。先更新归属，再发可能引起应用回调的事件。 */
+    const bool fullscreen = facts->status == 1;
+    window->pending_flags = (window->pending_flags & ~SDL_WINDOW_FULLSCREEN) |
+                            (fullscreen ? SDL_WINDOW_FULLSCREEN : 0);
+    for (int i = 0; i < AMCL_DESKTOP_MAX_DISPLAYS; ++i) {
+        SDL_VideoDisplay *display = displays[i] ? SDL_GetVideoDisplay(displays[i]) : NULL;
+        if (!display) continue;
+        if (fullscreen && native_displays[i] == facts->displayId) {
+            display->fullscreen_window = window;
+            display->fullscreen_active = window->fullscreen_exclusive;
+        } else if (display->fullscreen_window == window) {
+            display->fullscreen_window = NULL;
+            display->fullscreen_active = false;
+        }
+    }
+    SDL_SendWindowEvent(window, fullscreen ? SDL_EVENT_WINDOW_ENTER_FULLSCREEN : SDL_EVENT_WINDOW_LEAVE_FULLSCREEN, 0, 0);
+    return !rejected;
+}
