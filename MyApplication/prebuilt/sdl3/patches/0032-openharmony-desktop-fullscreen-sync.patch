+static void ObserveFullscreenCompletion(SDL_Window *window, const AmclDesktopSnapshot *facts)
+{
+    SDL_WindowData *data = window->internal;
+    if (data->desktop_fullscreen_host_generation != facts->generation ||
+        data->desktop_fullscreen_host_window != facts->windowId) {
+        SDL_zero(data->desktop_confirmed_fullscreen_mode);
+        data->desktop_fullscreen_host_generation = facts->generation;
+        data->desktop_fullscreen_host_window = facts->windowId;
+    }
+    if (!fullscreen_request.sequence) return;
+    if (!FullscreenRequestBelongsTo(window->id, facts)) {
+        SDL_zero(fullscreen_request);
+        return;
+    }
+    if (fullscreen_request.rejected || facts->completed < fullscreen_request.sequence) return;
+
+    /* lastError 只属于最近一次完成的命令，其他命令抢先完成后只核同代系统确认态。 */
+    const Sint32 error = facts->completed == fullscreen_request.sequence ? facts->lastError : 0;
+    if (error || !FullscreenMatches(facts, fullscreen_request.enabled, fullscreen_request.display)) {
+        fullscreen_request.rejected = true;
+        fullscreen_request.error = error;
+    } else {
+        data->desktop_confirmed_fullscreen_mode = fullscreen_request.mode;
+        SDL_zero(fullscreen_request);
+    }
+}
