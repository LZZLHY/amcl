+/* 最终键盘owner的平面位：legacy=1，typed=2；同平面重复Down不制造repeat。
+ * 显式repeat只在原平面持有时投递，最后owner释放才改变SDL的公共键盘状态。 */
+static void OPENHARMONY_SendKeyFromPlane(Uint8 plane, Uint64 time, int raw,
+                                        SDL_Scancode key, int action)
+{
+    if (key <= SDL_SCANCODE_UNKNOWN || key >= SDL_SCANCODE_COUNT) return;
+    const Uint8 before = host_key_planes[key];
+    if (action == 0) {
+        if (!(before & plane)) return;
+        host_key_planes[key] = before & (Uint8)~plane;
+        if (host_key_planes[key]) return;
+    } else if (action == 2) {
+        if (!(before & plane)) return;
+    } else if (action == 1) {
+        if (before & plane) return;
+        host_key_planes[key] = before | plane;
+        if (before) return;
+    } else return;
+    SDL_SendKeyboardKey(time, SDL_DEFAULT_KEYBOARD_ID, raw, key, action != 0);
+}
+
+/* 局部RESET只撤销对应平面；全窗口失活用mask=3，由既有SDL销毁边界完成终局。 */
+static void OPENHARMONY_ResetKeyPlane(Uint8 mask)
+{
+    bool released[SDL_SCANCODE_COUNT] = { false };
+    SDL_Window *window = OPENHARMONY_AMCL_GetInputWindow();
+    const SDL_WindowID window_id = window ? window->id : 0;
+    // 先原子地摘掉本次旧owner集合；同步watcher不得让后续遍历误删新取得的owner。
+    for (int key = 1; key < SDL_SCANCODE_COUNT; ++key) {
+        const Uint8 before = host_key_planes[key];
+        host_key_planes[key] = before & (Uint8)~mask;
+        released[key] = before && !host_key_planes[key];
+    }
+    for (int key = 1; key < SDL_SCANCODE_COUNT; ++key) {
+        if (!released[key] || host_key_planes[key]) continue;
+        if (!window_id || !OPENHARMONY_AMCL_GetLiveInputWindow(window_id)) return;
+        SDL_SendKeyboardKey(0, SDL_DEFAULT_KEYBOARD_ID, 0, (SDL_Scancode)key, false);
+    }
+}
+
+/* SDL的设备source不提供跨source首按/末松语义。保存真实贡献者，向游戏只提交
+ * 默认逻辑指针的第一条Down/最后一条Up，避免某设备拔除抢走其他设备仍持有的按钮。 */
+static void OPENHARMONY_SendButtonFromPlane(Uint8 plane, Uint64 device, Uint64 time,
+                                           SDL_Window *window, Uint8 button, bool down)
+{
+    if (!window || button < SDL_BUTTON_LEFT || button > SDL_BUTTON_X2) return;
+    int found = -1, free_slot = -1;
+    for (int i = 0; i < AMCL_BUTTON_CONTRIBUTORS; ++i) {
+        AMCL_ButtonContributor *item = &host_button_contributors[i];
+        if (!item->used) { if (free_slot < 0) free_slot = i; continue; }
+        if (item->plane == plane && item->device == device && item->button == button) { found = i; break; }
+    }
+    if (down) {
+        if (found >= 0) return;
+        if (free_slot < 0) {
+            SDL_LogError(SDL_LOG_CATEGORY_INPUT, "openharmony: logical button contributors exhausted");
+            return; // 未取得owner，不制造以后无法配对的Down。
+        }
+        AMCL_ButtonContributor *item = &host_button_contributors[free_slot];
+        item->plane = plane; item->device = device; item->button = button; item->used = true;
+        if (host_button_counts[button]++ != 0) return;
+    } else {
+        if (found < 0) return;
+        host_button_contributors[found].used = false;
+        if (--host_button_counts[button] != 0) return;
+    }
+    SDL_SendMouseButton(time, window, SDL_DEFAULT_MOUSE_ID, button, down);
+}
+
+/* 先摘对应owner，再逐边沿重新取得活动窗口；同步事件观察者关闭窗口时不继续用旧指针。 */
+static void OPENHARMONY_ResetButtonContributors(Uint8 mask, Uint64 device, bool only_device)
+{
+    bool released[SDL_BUTTON_X2 + 1] = { false };
+    SDL_Window *window = OPENHARMONY_AMCL_GetInputWindow();
+    const SDL_WindowID window_id = window ? window->id : 0;
+    for (int i = 0; i < AMCL_BUTTON_CONTRIBUTORS; ++i) {
+        AMCL_ButtonContributor item = host_button_contributors[i];
+        if (!item.used || !(item.plane & mask) || (only_device && item.device != device)) continue;
+        host_button_contributors[i].used = false;
+        if (--host_button_counts[item.button] == 0) released[item.button] = true;
+    }
+    for (int button = SDL_BUTTON_LEFT; button <= SDL_BUTTON_X2; ++button) {
+        if (!released[button] || host_button_counts[button]) continue;
+        window = window_id ? OPENHARMONY_AMCL_GetLiveInputWindow(window_id) : NULL;
+        if (!window) return;
+        SDL_SendMouseButton(0, window, SDL_DEFAULT_MOUSE_ID, (Uint8)button, false);
+    }
+}
