+/* 只向宿主投影当前呈现窗口的文本需求；独立窗口、辅助pbuffer不接管系统IME。 */
+static void OPENHARMONY_PublishTextInputDemand(SDL_Window *window, bool wanted)
+{
+    SDL_WindowData *data = window ? window->internal : NULL;
+    if (!data || data->role != OPENHARMONY_WINDOW_PRESENTED || !data->native_window_lease_generation) {
+        return;
+    }
+    const AMCL_NativeWindowLeaseBrokerV2 *broker =
+        (const AMCL_NativeWindowLeaseBrokerV2 *)data->native_window_lease_broker;
+    if (!broker ||
+        broker->structSize < offsetof(AMCL_NativeWindowLeaseBrokerV2, setTextInputDemand) + sizeof(broker->setTextInputDemand) ||
+        !broker->setTextInputDemand ||
+        (data->amcl_text_input_generation == data->native_window_lease_generation &&
+         data->amcl_text_input_wanted == wanted)) {
+        return;
+    }
+    if (broker->setTextInputDemand(data->native_window, data->native_window_lease_generation, window->id, wanted)) {
+        data->amcl_text_input_generation = data->native_window_lease_generation;
+        data->amcl_text_input_wanted = wanted;
+    }
+}
+
+static bool OPENHARMONY_StartHostTextInput(SDL_VideoDevice *device, SDL_Window *window, SDL_PropertiesID props)
+{
+    (void)device;
+    (void)props;
+    if (SDL_GetKeyboardFocus() == window) {
+        OPENHARMONY_PublishTextInputDemand(window, true);
+    }
+    return true;
+}
+
+static bool OPENHARMONY_StopHostTextInput(SDL_VideoDevice *device, SDL_Window *window)
+{
+    (void)device;
+    OPENHARMONY_PublishTextInputDemand(window, false);
+    return true;
+}
+
+static void OPENHARMONY_PumpEventsWithHostTextInput(SDL_VideoDevice *device)
+{
+    OPENHARMONY_PumpEvents(device);
+    /* 跨窗口重配置后按SDL焦点与真实文本位补投影，不重放文本或借辅助窗口接管。 */
+    SDL_Window *focus = SDL_GetKeyboardFocus();
+    if (focus) {
+        OPENHARMONY_PublishTextInputDemand(focus, SDL_TextInputActive(focus));
+    }
+}
