     mouse->CreateCursor = OPENHARMONY_CreateCursor;
     mouse->CreateSystemCursor = OPENHARMONY_CreateSystemCursor;
     mouse->ShowCursor = OPENHARMONY_ShowCursor;
     mouse->FreeCursor = OPENHARMONY_FreeCursor;
     mouse->WarpMouse = OPENHARMONY_WarpMouse;
     mouse->SetRelativeMouseMode = OPENHARMONY_SetRelativeMouseMode;
 
     SDL_SetDefaultCursor(OPENHARMONY_CreateDefaultCursor());
 
     /* Activation is completed by the presented-window ShowWindow hook.  A
      * hidden utility pbuffer must not claim the host input stream while the
      * visible surface has not been created yet. */
     host_baseline_valid = false;
 }
 
 void OPENHARMONY_AMCL_QuitMouse(void)
 {
     // The SDL window still exists while the mouse driver quits, so release first. SetActive(0)
     // then discards every pending pre-present transaction and aligns the consumer to "now";
     // neither a held button nor an old token may cross into the next SDL window generation.
     OPENHARMONY_AMCL_SetPresentedActive(false);
+    OPENHARMONY_CloseControl();
     /* SDL_QuitMouse() skips the backend false hook when host loss already made
      * the global relative bit false.  Teardown nevertheless ends the retained
      * application request, so clear the process-wide bridge explicitly. */
     OPENHARMONY_HostBridge *bridge = OPENHARMONY_GetHostBridge();
     if (bridge && bridge->SetGrabState) {
         bridge->SetGrabState(0);
     }
     host_capture_requested = false;
     host_capture_active = false;
     host_relative_disable_authority = AMCL_RELATIVE_DISABLE_NONE;
     host_baseline_valid = false;
 }
 
 // ===========================================================================
 // Live-window surface recovery (host-injected windows only)
 // ===========================================================================
 // A host-injected window retains an ABI-v2 lease while its EGL surface is live.
 // When the host destroys/recreates its XComponent surface (background /
 // foreground cycle, rotation, fold), the broker publishes a new generation;
 // the render/pump owner compares the lock-free generation/state pair and
 // rebuilds only the presented window surface.  Auxiliary pbuffer windows and
 // SDL-owned XComponent callbacks are outside this recovery path.
 
 
 // ---------------------------------------------------------------------------
 // Versioned NativeWindow lease broker
 // ---------------------------------------------------------------------------
 // The host and SDL can be loaded in different OpenHarmony linker namespaces.
 // A raw NativeWindow pointer copied from getenv() is not an ownership proof:
 // the host may retire it immediately after publication.  The broker descriptor
 // is process-lifetime storage owned by the XComponent host and performs the
 // reference operation back in that owner image.
 #define AMCL_NATIVE_WINDOW_LEASE_BROKER_ENV "AMCL_NATIVE_WINDOW_LEASE_BROKER"
 #define AMCL_NATIVE_WINDOW_LEASE_BROKER_ABI_VERSION 2u
 
 #define AMCL_NATIVE_WINDOW_LEASE_BROKER_V2_CORE_SIZE \
     ((Uint32)(offsetof(AMCL_NativeWindowLeaseBrokerV2, endInputPublication) + \
               sizeof(((AMCL_NativeWindowLeaseBrokerV2 *)0)->endInputPublication)))
 #define AMCL_NATIVE_WINDOW_LEASE_BROKER_V2_PEEK_SIZE \
     ((Uint32)(offsetof(AMCL_NativeWindowLeaseBrokerV2, peekState) + \
               sizeof(((AMCL_NativeWindowLeaseBrokerV2 *)0)->peekState)))
 
 /* Keep the private SDL mirror mechanically self-consistent.  The host side
  * has the same C layout assertions in its shared ABI header; these checks do
  * not make a foreign pointer safe by themselves, but they prevent an SDL-only
  * field insertion/reordering from silently changing the wire contract. */
 SDL_COMPILE_TIME_ASSERT(amcl_lease_broker_acquire_offset,
                         offsetof(AMCL_NativeWindowLeaseBrokerV2, acquire) ==
                             sizeof(Uint32) * 2);
 SDL_COMPILE_TIME_ASSERT(amcl_lease_broker_release_offset,
                         offsetof(AMCL_NativeWindowLeaseBrokerV2, release) ==
                             offsetof(AMCL_NativeWindowLeaseBrokerV2, acquire) +
                                 sizeof(((AMCL_NativeWindowLeaseBrokerV2 *)0)->acquire));
 SDL_COMPILE_TIME_ASSERT(amcl_lease_broker_core_layout,
                         AMCL_NATIVE_WINDOW_LEASE_BROKER_V2_CORE_SIZE ==
                             offsetof(AMCL_NativeWindowLeaseBrokerV2, endInputPublication) +
                                 sizeof(((AMCL_NativeWindowLeaseBrokerV2 *)0)->endInputPublication));
 SDL_COMPILE_TIME_ASSERT(amcl_lease_broker_tail_layout,
                         AMCL_NATIVE_WINDOW_LEASE_BROKER_V2_PEEK_SIZE <=
                             sizeof(AMCL_NativeWindowLeaseBrokerV2));
 SDL_COMPILE_TIME_ASSERT(amcl_presentation_broker_tail_layout,
                         AMCL_PRESENTATION_BROKER_SIZE <= sizeof(AMCL_NativeWindowLeaseBrokerV2));
 
 static bool OPENHARMONY_AMCL_BrokerDescriptorValid(
     const AMCL_NativeWindowLeaseBrokerV2 *broker)
 {
     if (!broker || broker->abiVersion != AMCL_NATIVE_WINDOW_LEASE_BROKER_ABI_VERSION ||
         broker->structSize < AMCL_NATIVE_WINDOW_LEASE_BROKER_V2_CORE_SIZE ||
         !broker->acquire || !broker->release ||
         !broker->beginInputPublication || !broker->endInputPublication) {
         return false;
     }
 
     /* Hybrid recovery has no safe full-acquire operation on the steady path,
      * so the atomic generation/state pair is mandatory for this consumer.
      * Accepting a core-only v2 descriptor would make Peek return a permanent
      * zero epoch and silently disable surface recovery. */
     if (broker->structSize < AMCL_NATIVE_WINDOW_LEASE_BROKER_V2_PEEK_SIZE ||
         !broker->peekGeneration || !broker->peekState) {
         return false;
     }
     return true;
 }
 
 static bool OPENHARMONY_AMCL_BrokerHasPeek(
     const AMCL_NativeWindowLeaseBrokerV2 *broker)
 {
     return OPENHARMONY_AMCL_BrokerDescriptorValid(broker) &&
            broker->peekGeneration && broker->peekState;
 }
 
 static void *amcl_native_window_lease_broker_atomic;
 static SDL_AtomicInt amcl_native_window_lease_broker_rejected;
 static SDL_AtomicInt amcl_native_window_lease_broker_present;
 static SDL_AtomicInt amcl_native_window_lease_broker_pid;
 
 static SDL_VideoData *OPENHARMONY_AMCL_GetVideoData(void)
 {
     SDL_VideoDevice *device = SDL_GetVideoDevice();
     return device ? (SDL_VideoData *)device->internal : NULL;
 }
 
 static const AMCL_NativeWindowLeaseBrokerV2 *OPENHARMONY_AMCL_ResolveLeaseBroker(void)
 {
     const int current_pid = (int)getpid();
     const int cached_pid = SDL_GetAtomicInt(&amcl_native_window_lease_broker_pid);
     if (cached_pid != current_pid &&
         SDL_CompareAndSwapAtomicInt(&amcl_native_window_lease_broker_pid,
                                     cached_pid, current_pid)) {
         /* A forked launcher child inherits the parent's static address space,
          * but not necessarily the host publication. Force a fresh descriptor
          * parse in the child. */
         SDL_SetAtomicPointer(&amcl_native_window_lease_broker_atomic, NULL);
         SDL_SetAtomicInt(&amcl_native_window_lease_broker_rejected, 0);
         SDL_SetAtomicInt(&amcl_native_window_lease_broker_present, 0);
     }
     const AMCL_NativeWindowLeaseBrokerV2 *cached =
         (const AMCL_NativeWindowLeaseBrokerV2 *)SDL_GetAtomicPointer(
             &amcl_native_window_lease_broker_atomic);
     if (cached) {
         return cached;
     }
 
     const char *encoded = SDL_getenv_unsafe(AMCL_NATIVE_WINDOW_LEASE_BROKER_ENV);
     if (!encoded || !*encoded) {
         return NULL;
     }
     SDL_SetAtomicInt(&amcl_native_window_lease_broker_present, 1);
 
     char descriptor[128];
     SDL_strlcpy(descriptor, encoded, sizeof(descriptor));
     char *colon = SDL_strchr(descriptor, ':');
     if (!colon) {
         SDL_SetAtomicInt(&amcl_native_window_lease_broker_rejected, 1);
         return NULL;
     }
     *colon = '\0';
     char *end = NULL;
     const unsigned long abi = SDL_strtoul(descriptor, &end, 10);
     if (!end || end == descriptor || *end != '\0' ||
         abi != AMCL_NATIVE_WINDOW_LEASE_BROKER_ABI_VERSION) {
         SDL_SetAtomicInt(&amcl_native_window_lease_broker_rejected, 1);
         return NULL;
     }
     const unsigned long long raw = SDL_strtoull(colon + 1, &end, 0);
     if (!end || end == (colon + 1) || *end != '\0' || raw == 0) {
         SDL_SetAtomicInt(&amcl_native_window_lease_broker_rejected, 1);
         return NULL;
     }
 
     const AMCL_NativeWindowLeaseBrokerV2 *broker =
         (const AMCL_NativeWindowLeaseBrokerV2 *)(uintptr_t)raw;
     if (!OPENHARMONY_AMCL_BrokerDescriptorValid(broker)) {
         SDL_SetAtomicInt(&amcl_native_window_lease_broker_rejected, 1);
         return NULL;
     }
     SDL_SetAtomicInt(&amcl_native_window_lease_broker_rejected, 0);
     SDL_MemoryBarrierRelease();
     SDL_SetAtomicPointer(&amcl_native_window_lease_broker_atomic,
                          (void *)broker);
     return broker;
 }
 
