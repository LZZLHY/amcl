 static SDL_Window *OPENHARMONY_AMCL_GetLiveInputWindow(SDL_WindowID window_id)
 {
     SDL_Window *window = window_id ? SDL_GetWindowFromID(window_id) : NULL;
     if (!window || !window->internal ||
         window->internal->role != OPENHARMONY_WINDOW_PRESENTED ||
         !OPENHARMONY_AMCL_IsPresentedActive()) {
         return NULL;
