@@ -0,0 +1,34 @@
+/* AMCL控制交付的SDK内部回执：不管理owner，仅在原缓存写点与真实Push结果记录事实。
+ * 原SDL调用传NULL，保持公共ABI/政策；受控调用冻结target并在可能重入之后核原ticket。 */
+#ifndef SDL_inputdelivery_c_h_
+#define SDL_inputdelivery_c_h_
+#if defined(__GNUC__)
+#define SDL_AMCL_INPUT_HIDDEN __attribute__((visibility("hidden")))
+#else
+#define SDL_AMCL_INPUT_HIDDEN
+#ifdef SDL_VIDEO_DRIVER_OPENHARMONY
+/* 真实状态getter观测入口，仅计ABI读事实，不声明最终游戏处理。 */
+extern SDL_AMCL_INPUT_HIDDEN void SDL_AMCL_ObserveKeyboardPoll(const bool *states, int count);
+extern SDL_AMCL_INPUT_HIDDEN void SDL_AMCL_ObserveMousePoll(SDL_MouseButtonFlags state);
+#endif
+#endif
+typedef struct SDL_AMCL_InputReceipt {
+    void *context;
+    bool (*current)(void *context);
+    void (*cacheApplied)(void *context);
+    SDL_WindowID target;
+    /* 原目标已退休且无法再发事件时，仅在共享端口认可的old UP上清实际ABI缓存。 */
+    bool cacheOnly, cached, posted;
+} SDL_AMCL_InputReceipt;
+static bool SDL_AMCL_InputCurrent(SDL_AMCL_InputReceipt *receipt) {
+    return !receipt || (receipt->target && receipt->current && receipt->cacheApplied && receipt->current(receipt->context));
+}
+static void SDL_AMCL_InputCacheApplied(SDL_AMCL_InputReceipt *receipt) {
+    if (receipt) { receipt->cached = true; receipt->cacheApplied(receipt->context); }
+}
+#ifdef SDL_VIDEO_DRIVER_OPENHARMONY
+/* 真实状态getter观测入口，仅计ABI读事实，不声明最终游戏处理。 */
