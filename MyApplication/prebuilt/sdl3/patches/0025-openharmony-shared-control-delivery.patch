 // ---------------------------------------------------------------------------
 // Host event ring protocol
 // ---------------------------------------------------------------------------
 // Event types and payload layout mirror the GLFW callback signatures the host
 // was originally built around, so i1..i4 line up with GLFW's callback
 // arguments. Verified against the host's own GLFW3 dispatch:
 //   KEY          -> (key, scancode, action, mods)
 //   CHAR         -> (codepoint, -, -, -)
 //   MOUSE_BUTTON -> (button, action, mods, -)
 //   SCROLL       -> (xoffset, yoffset, -, -)
 //   MENU_POINTER -> (phase, absolute x, absolute y, transaction token)
 //   INPUT_RESET  -> ring overflowed or the window was recreated; drop held state
 //
 // Which read cursor we borrow, and why that is a deliberate compromise
 // --------------------------------------------------------------------
 // The host's ring supports several independent consumers, each with its own
 // read cursor, and currently has two: one for callback-style dispatch and one
 // for poll-style dispatch. We attach to the poll-style cursor rather than
 // adding a third.
 //
 // AMCLSDLV:3 gives SDL a dedicated read cursor and keeps menu-pointer transactions
 // intact until the SDL-specific host adapter has applied its present barrier. In
 // v1 the host folded DOWN into PRESS immediately; because this backend had already
 // sampled the cursor, Minecraft received PRESS(oldX, oldY) and MOTION(newX, newY)
 // one pump later -- the exact reason a menu button required two physical taps.
 //
 // The tradeoff, stated plainly: if a build ever ran the poll-style consumer
 // *and* SDL against the same ring, the two would steal events from each other.
 // That cannot happen today (the poll consumer belongs to a legacy path that is
 // mutually exclusive with the SDL path), but it is a real constraint rather
 // than a theoretical one. If those paths ever need to coexist, the fix is to
 // add a dedicated read cursor on the host side and switch the symbol looked up
 // below; nothing else here changes.
 #define AMCL_EVENT_CHAR         1000
 #define AMCL_EVENT_CHAR_MODS    1001
 #define AMCL_EVENT_KEY          1005
 #define AMCL_EVENT_MOUSE_BUTTON 1006
 #define AMCL_EVENT_SCROLL       1007
 #define AMCL_EVENT_MENU_POINTER 1008
 #define AMCL_EVENT_INPUT_RESET  1009
 #define AMCL_EVENT_CURSOR_POSITION 1010
 #define AMCL_MENU_POINTER_MOVE   0
 #define AMCL_MENU_POINTER_DOWN   1
 #define AMCL_MENU_POINTER_UP     2
 #define AMCL_MENU_POINTER_CANCEL 3
 
