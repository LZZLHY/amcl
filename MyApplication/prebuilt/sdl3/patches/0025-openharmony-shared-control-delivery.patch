 // ---------------------------------------------------------------------------
 // Relative mouse mode has to land on the host's grab state, and nowhere else:
 // the host derives both the look accumulator and its menu-cursor behaviour
 // from that single flag, so a second source of truth would desynchronise them.
 
 static bool OPENHARMONY_SetRelativeMouseMode(bool enabled)
 {
     const Uint32 disable_authority = host_relative_disable_authority;
     if (!enabled) {
         /* Authority is scoped to exactly one core->driver disable attempt,
          * including attempts made while the presented window is disappearing. */
         host_relative_disable_authority = AMCL_RELATIVE_DISABLE_NONE;
     }
     SDL_VideoDevice *video = SDL_GetVideoDevice();
     const bool driver_teardown = video && video->is_quitting;
     const bool message_box = SDL_GetMessageBoxCount() > 0;
     OPENHARMONY_HostBridge *bridge = OPENHARMONY_GetHostBridge();
     SDL_Window *input_window = OPENHARMONY_AMCL_GetInputWindow();
 
     if (!enabled && disable_authority != AMCL_RELATIVE_DISABLE_NONE) {
         /* Focus/capture loss suspends only SDL's derived active bit.  The SDL
          * per-window flag and bridge grabbed value both remain the application's
          * request; the typed CAPTURE tuple independently carries host-active. */
         host_capture_active = false;
         host_baseline_valid = false;
         SDL_Log("openharmony: suspended relative mode for host authority=%u; "
                 "the application request remains active",
                 disable_authority);
         return true;
     }
 
     if (!enabled && driver_teardown) {
         /* QuitMouse can run after the presented window vanished.  There is no
          * request to preserve across driver teardown, so clear the process-wide
          * bridge state whenever its symbol table is still reachable. */
         host_capture_requested = false;
         host_capture_active = false;
         host_baseline_valid = false;
         if (bridge && bridge->SetGrabState) {
             bridge->SetGrabState(0);
         }
         SDL_Log("openharmony: accepted relative-mode release source=driver-teardown");
         return true;
     }
 
     if (!host_presented_active || !input_window) {
         return SDL_SetError("OpenHarmony: relative mouse mode requires an active presented window");
     }
     if (!bridge || !bridge->SetGrabState || !bridge->IsGrabbing) {
         return SDL_Unsupported();
     }
 
     if (!enabled &&
         (input_window->flags & SDL_WINDOW_MOUSE_RELATIVE_MODE) != 0 &&
         !message_box) {
         ++host_unclassified_relative_release_count;
         if (host_unclassified_relative_release_count == 1u ||
             (host_unclassified_relative_release_count &
              (host_unclassified_relative_release_count - 1u)) == 0u) {
             SDL_LogWarn(SDL_LOG_CATEGORY_INPUT,
                         "openharmony: rejected unclassified relative-mode release "
                         "while the presented request remains active count=%" SDL_PRIu64,
                         host_unclassified_relative_release_count);
         }
         return SDL_SetError(
             "OpenHarmony: relative-mode release lacks app or host lifecycle authority");
     }
     if (!enabled) {
         SDL_Log("openharmony: accepted relative-mode release source=%s",
                 message_box ? "message-box" : "application");
         host_capture_requested = false;
         host_capture_active = false;
         bridge->SetGrabState(0);
     } else {
         host_capture_requested = true;
         /* A focus/capture recovery leaves the bridge request set.  Preserve an
          * already granted host result and avoid a duplicate pending request;
          * only a genuine application 0->1 transition starts a fresh capture. */
         if (!bridge->IsGrabbing()) {
             host_capture_active = false;
             bridge->SetGrabState(1);
         }
     }
     // Force a re-baseline: the host switches coordinate spaces on this call.
     host_baseline_valid = false;
     return true;
 }
 
 static bool OPENHARMONY_WarpMouse(SDL_Window *window, float x, float y)
 {
     if (!host_presented_active || !window ||
         !window->internal ||
         window->internal->role != OPENHARMONY_WINDOW_PRESENTED) {
         return SDL_SetError("OpenHarmony: cursor warp is only available for the presented window");
     }
     OPENHARMONY_HostBridge *bridge = OPENHARMONY_GetHostBridge();
     if (!bridge || !bridge->SetLookCursor) {
         return SDL_Unsupported();
     }
     // The host treats this as "the caller's idea of where the cursor is",
     // which is exactly what it needs to keep its own reference point aligned.
     bridge->SetLookCursor((double)x, (double)y);
     host_baseline_valid = false;
     return true;
 }
 
