         SDL_Event event;
         event.type = SDL_EVENT_TEXT_INPUT;
         event.common.timestamp = 0;
         event.text.windowID = keyboard->focus ? keyboard->focus->id : 0;
         event.text.text = SDL_CreateTemporaryString(text);
         if (!event.text.text) {
             return;
