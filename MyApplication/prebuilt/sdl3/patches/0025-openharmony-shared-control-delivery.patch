     host_presented_active = false;
     host_capture_requested = false;
     host_capture_active = false;
     host_relative_disable_authority = AMCL_RELATIVE_DISABLE_NONE;
     host_surface_context_generation = 0u;
     host_unclassified_relative_release_count = 0u;
     SDL_Mouse *mouse = SDL_GetMouse();
     if (!mouse) {
