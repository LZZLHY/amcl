 //
 // Note for anyone looking for SDL_ResetMouse(): it exists in SDL_mouse.c but is
 // wrapped in `#if 0` with an explicit request from upstream to leave it alone
 // until Wayland needs it, so it is unavailable here. Walking the public button
 // mask does the same job for our purposes without touching core SDL.
 static void OPENHARMONY_ReleaseHeldMouseButtons(bool teardown,
                                                  SDL_WindowID requested_id, Uint8 plane_mask)
 {
     SDL_Window *input_window = requested_id
                                    ? SDL_GetWindowFromID(requested_id)
                                    : OPENHARMONY_AMCL_GetInputWindow();
     if (input_window && (!input_window->internal ||
                          input_window->internal->role !=
                              OPENHARMONY_WINDOW_PRESENTED)) {
         input_window = NULL;
     }
     if (!input_window) {
         // 没有合法事件目标时不能回调旧窗口，但已注入的轮询位不能跨代残留。
         SDL_Mouse *mouse = SDL_GetMouse();
         for (int i = 0; mouse && i < mouse->num_sources; ++i) {
             const Uint8 plane = mouse->sources[i].mouseID == SDL_DEFAULT_MOUSE_ID ? 1 : 2;
             if (plane_mask & plane) mouse->sources[i].buttonstate = 0;
         }
         return;
     }
     if (input_window->internal &&
         input_window->internal->surface_state ==
             OPENHARMONY_SURFACE_DESTROYING) {
         /* SDL_DestroyWindow is already in its one-way teardown transaction;
          * dispatching synchronous button-up events here would let a watcher
          * re-enter that same object.  Clear the per-source state directly;
          * the window cannot be observed by the next generation. */
         SDL_Mouse *mouse = SDL_GetMouse();
         if (mouse && mouse->sources) {
             for (int i = 0; i < mouse->num_sources; ++i) {
                 mouse->sources[i].buttonstate = 0;
             }
         }
         return;
     }
     const SDL_WindowID input_window_id = input_window->id;
     typedef struct
     {
         SDL_MouseID mouse_id;
         SDL_MouseButtonFlags held;
     } OPENHARMONY_HeldMouseSource;
 
     SDL_Mouse *mouse = SDL_GetMouse();
     const int source_count = mouse ? mouse->num_sources : 0;
     OPENHARMONY_HeldMouseSource *held_sources = source_count > 0
         ? (OPENHARMONY_HeldMouseSource *)SDL_malloc(
               (size_t)source_count * sizeof(*held_sources))
         : NULL;
     if (source_count > 0 && !held_sources) {
         /* A reset must still make internal polling fail-safe under OOM. Event
          * watchers cannot be called safely without a stable source snapshot. */
         SDL_LogError(SDL_LOG_CATEGORY_INPUT,
                      "openharmony: mouse reset snapshot allocation failed; clearing %d source states",
                      source_count);
         for (int source_index = 0; source_index < source_count; ++source_index) {
             if (plane_mask & (mouse->sources[source_index].mouseID == SDL_DEFAULT_MOUSE_ID ? 1 : 2))
                 mouse->sources[source_index].buttonstate = 0;
         }
         return;
     }
     for (int source_index = 0; source_index < source_count; ++source_index) {
         held_sources[source_index].mouse_id = mouse->sources[source_index].mouseID;
         const Uint8 source_plane = mouse->sources[source_index].mouseID == SDL_DEFAULT_MOUSE_ID ? 1 : 2;
         held_sources[source_index].held = (plane_mask & source_plane)
             ? mouse->sources[source_index].buttonstate : 0;
     }
 
     /* SDL event watchers run synchronously from SDL_SendMouseButton.  Mark
      * this short release transaction as one-way teardown so a watcher cannot
      * recursively free the same SDL_Window while the outer lifecycle edge is
      * still unwinding.  Restore the flag only if the object remains live. */
     const bool was_destroying = input_window->is_destroying;
     if (teardown) {
         input_window->is_destroying = true;
     }
 
     bool window_lost = false;
     for (int source_index = 0; source_index < source_count; ++source_index) {
         for (int button = SDL_BUTTON_LEFT; button <= SDL_BUTTON_X2; ++button) {
             if (!(held_sources[source_index].held & SDL_BUTTON_MASK(button))) {
                 continue;
             }
             input_window = OPENHARMONY_AMCL_GetLiveInputWindowForTeardown(
                 input_window_id);
             if (!input_window) {
                 window_lost = true;
                 break;
             }
             /* A synchronous watcher may remove a source after an earlier UP.
              * Reconfirm this exact id still owns the bit so SDL's compatibility
              * fallback cannot release the same button from a different mouse. */
             bool still_held = false;
             mouse = SDL_GetMouse();
             for (int live_index = 0; mouse && live_index < mouse->num_sources;
                  ++live_index) {
                 if (mouse->sources[live_index].mouseID ==
                         held_sources[source_index].mouse_id &&
                     (mouse->sources[live_index].buttonstate &
                      SDL_BUTTON_MASK(button)) != 0u) {
                     still_held = true;
                     break;
                 }
             }
             if (!still_held) {
                 continue;
             }
             /* During a lifecycle teardown do not hand the retiring window
              * back to SDL's post-release focus machinery. */
             SDL_SendMouseButton(0, teardown ? NULL : input_window,
                                 held_sources[source_index].mouse_id,
                                 (Uint8)button, false);
         }
         if (window_lost) {
             break;
         }
     }
     if (window_lost) {
         mouse = SDL_GetMouse();
         for (int live_index = 0; mouse && live_index < mouse->num_sources;
              ++live_index) {
             mouse->sources[live_index].buttonstate = 0;
         }
     }
     SDL_free(held_sources);
     SDL_Window *live_window = SDL_GetWindowFromID(input_window_id);
     if (teardown && live_window && !was_destroying) {
         live_window->is_destroying = false;
     }
 }
 
