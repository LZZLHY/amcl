+SDL_AMCL_INPUT_PUBLIC Uint32 SDLCALL SDL_AMCL_InputControlProtocolV1(void)
+{
+    return SDL_AMCL_INPUT_CONTROL_PROTOCOL_V1;
+}
+
+/* 仅runtime准备/首个实际pump借port前调用。SDL_internal将版本锚绑定本SDK的
+ * SDL_GetVersion_REAL；marker、锚与此隐藏函数须同映像，其他全局可见copy不能替代它。
+ * requireOwner校验既有唯一Core端口，没有open/claim/Activate，失败保持未准备状态。 */
+bool SDL_AMCL_ValidateInputRuntimeV1(bool requireOwner)
+{
+#ifdef _WIN32
+    HMODULE marker=NULL, anchor=NULL, self=NULL;
+    MEMORY_BASIC_INFORMATION memory;
+    if (!GetModuleHandleExA(GET_MODULE_HANDLE_EX_FLAG_FROM_ADDRESS|GET_MODULE_HANDLE_EX_FLAG_UNCHANGED_REFCOUNT,
+            (LPCSTR)(uintptr_t)SDL_AMCL_InputControlProtocolV1,&marker) ||
+        !GetModuleHandleExA(GET_MODULE_HANDLE_EX_FLAG_FROM_ADDRESS|GET_MODULE_HANDLE_EX_FLAG_UNCHANGED_REFCOUNT,
+            (LPCSTR)(uintptr_t)SDL_GetVersion,&anchor) ||
+        !GetModuleHandleExA(GET_MODULE_HANDLE_EX_FLAG_FROM_ADDRESS|GET_MODULE_HANDLE_EX_FLAG_UNCHANGED_REFCOUNT,
+            (LPCSTR)(uintptr_t)SDL_AMCL_ValidateInputRuntimeV1,&self) || marker!=anchor || marker!=self ||
+        !VirtualQuery((LPCVOID)(uintptr_t)SDL_AMCL_InputControlProtocolV1,&memory,sizeof(memory)))
+        return SDL_SetError("InputContractMismatch:sdl_runtime_image");
+    const DWORD access=memory.Protect&0xff;
+    if (memory.State!=MEM_COMMIT || (memory.Protect&PAGE_GUARD) ||
+        (access!=PAGE_EXECUTE && access!=PAGE_EXECUTE_READ && access!=PAGE_EXECUTE_READWRITE && access!=PAGE_EXECUTE_WRITECOPY))
+        return SDL_SetError("InputContractMismatch:sdl_runtime_marker_executable");
+#else
+    Dl_info marker,anchor,self;
+    if (!dladdr((const void*)(uintptr_t)SDL_AMCL_InputControlProtocolV1,&marker) ||
+        !dladdr((const void*)(uintptr_t)SDL_GetVersion,&anchor) ||
+        !dladdr((const void*)(uintptr_t)SDL_AMCL_ValidateInputRuntimeV1,&self) || !self.dli_fbase ||
+        marker.dli_fbase!=self.dli_fbase || anchor.dli_fbase!=self.dli_fbase ||
+        !amclControlAddressInOwner((uintptr_t)SDL_AMCL_InputControlProtocolV1,(uintptr_t)self.dli_fbase))
+        return SDL_SetError("InputContractMismatch:sdl_runtime_image");
+#endif
+    if (SDL_AMCL_InputControlProtocolV1()!=SDL_AMCL_INPUT_CONTROL_PROTOCOL_V1)
+        return SDL_SetError("InputContractMismatch:sdl_runtime_protocol");
+    if (requireOwner) {
+        if (!SDL_AMCL_HasInternalDynapiV1()) return SDL_SetError("InputContractMismatch:sdl_external_dynapi");
+        const AmclControlDeliveryPortV1* port=NULL;
+        if (amclControlDeliveryResolveV1(&port)<0)
+            return SDL_SetError("InputContractMismatch:sdl_runtime_core_owner");
+    }
+    return true;
+}
+#endif
