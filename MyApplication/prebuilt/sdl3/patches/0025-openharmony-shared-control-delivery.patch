 static bool OPENHARMONY_ApplyTypedFocus(SDL_WindowID window_id, bool focused)
 {
     SDL_Window *window = OPENHARMONY_AMCL_GetLiveInputWindow(window_id);
     if (!window) {
         return false;
     }
     if (focused) {
         SDL_SetKeyboardFocus(window);
         window = OPENHARMONY_AMCL_GetLiveInputWindow(window_id);
         if (!window) {
             return false;
         }
         SDL_SetMouseFocus(window);
         return true;
     }
 
     if (SDL_GetKeyboardFocus() == window) {
         host_relative_disable_authority = AMCL_RELATIVE_DISABLE_FOCUS_LOST;
         SDL_SetKeyboardFocus(NULL);
         host_relative_disable_authority = AMCL_RELATIVE_DISABLE_NONE;
         if (SDL_GetRelativeMouseMode()) {
             OPENHARMONY_DisableRelativeModeForHostLoss(
                 AMCL_RELATIVE_DISABLE_FOCUS_LOST);
         }
     }
     window = OPENHARMONY_AMCL_GetLiveInputWindow(window_id);
     if (!window) {
         return false;
     }
     if (SDL_GetMouseFocus() == window) {
         SDL_SetMouseFocus(NULL);
     }
     return true;
 }
 
 static void OPENHARMONY_ApplyTypedCapture(
     const AMCL_BackendInputEvent *event)
