             "[AMCL-SDL-HOST] phase=event-pump instance=%p tid=%llu main=%llu events=%llu video=%llu",
             (void *)&SDL_amclHostRuntime, (unsigned long long)syscall(SYS_gettid),
             (unsigned long long)SDL_MainThreadID, (unsigned long long)SDL_EventsThreadID,
