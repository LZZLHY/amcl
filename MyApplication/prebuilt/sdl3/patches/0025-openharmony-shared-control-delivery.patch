+AMCL_CONTROL_PUBLIC int32_t amclControlDeliveryBindSessionV1(uint64_t gameSession);
+// module Init早于JVM线程的既有发布点调用；描述符只包含同owner getter地址，重复无写入。
+AMCL_CONTROL_PUBLIC void amclControlDeliveryPublishV1(void);
+#ifdef __cplusplus
+}
+#endif
+#endif
