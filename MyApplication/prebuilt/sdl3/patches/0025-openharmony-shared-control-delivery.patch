+/* AMCL专用冷输入协议：getter只声明本制品common-control版本，不触发SDL/owner准备。
+ * 标准SDL ABI保持；runtime验证用本SDK映像的私有锚，不能借bootstrap另一namespace的copy。 */
+#ifndef SDL_amclinputcontrol_c_h_
+#define SDL_amclinputcontrol_c_h_
+#include "SDL_internal.h"
+#define SDL_AMCL_INPUT_CONTROL_PROTOCOL_V1 1u
+/* SDL_DYNAMIC_API把SDL_DECLSPEC清空以隐藏REAL符号；此私有标识独立导出，不进入dynapi表。 */
+#if defined(_WIN32) && defined(DLL_EXPORT)
+#define SDL_AMCL_INPUT_PUBLIC __declspec(dllexport)
+#elif defined(__GNUC__)
+#define SDL_AMCL_INPUT_PUBLIC __attribute__((visibility("default")))
+#else
+#define SDL_AMCL_INPUT_PUBLIC
+#endif
+extern SDL_AMCL_INPUT_PUBLIC Uint32 SDLCALL SDL_AMCL_InputControlProtocolV1(void);
+#if defined(__GNUC__)
+extern __attribute__((visibility("hidden"))) bool SDL_AMCL_ValidateInputRuntimeV1(bool requireOwner);
+extern __attribute__((visibility("hidden"))) bool SDL_AMCL_HasInternalDynapiV1(void);
+#else
+extern bool SDL_AMCL_ValidateInputRuntimeV1(bool requireOwner);
+extern bool SDL_AMCL_HasInternalDynapiV1(void);
+#endif
+#endif
diff --git a/src/core/openharmony/SDL_amclinputhostpolicy.h b/src/core/openharmony/SDL_amclinputhostpolicy.h
new file mode 100644
--- /dev/null
+++ b/src/core/openharmony/SDL_amclinputhostpolicy.h
@@ -0,0 +1,27 @@
+/* 只用既有严格十进制host协议核调用者身份，供实际SDK/尚无jump-table的dynapi使用。
+ * probe是栈对象，不设置SDK main-ready/初始化状态，不借owner，不把裸环境存在当host。 */
+#ifndef SDL_amclinputhostpolicy_h_
+#define SDL_amclinputhostpolicy_h_
+#include "SDL_amclhostruntime.h"
+#ifdef _WIN32
+#include <windows.h>
+#include <process.h>
+#else
+#include <unistd.h>
+#include <sys/syscall.h>
+#include <stdlib.h>
+#endif
+static inline int AMCL_SdlInputHostIdentityV1(void)
+{
+    AMCL_SdlHostRuntime probe = { 0 };
+#ifdef _WIN32
+    char descriptor[128];
+    const DWORD length=GetEnvironmentVariableA("AMCL_SDL_HOST_RUNTIME",descriptor,sizeof(descriptor));
+    if (!length) return AMCL_SDL_HOST_STANDALONE;
+    if (length>=sizeof(descriptor)) return AMCL_SDL_HOST_MALFORMED;
+    return AMCL_SdlHostPrepare(&probe,descriptor,(uint64_t)_getpid(),(uint64_t)GetCurrentThreadId());
+#else
+    return AMCL_SdlHostPrepare(&probe,getenv("AMCL_SDL_HOST_RUNTIME"),(uint64_t)getpid(),(uint64_t)syscall(SYS_gettid));
+#endif
+}
+#endif
