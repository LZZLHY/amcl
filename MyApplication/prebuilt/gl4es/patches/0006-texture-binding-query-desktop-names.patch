+/* 桌面texture对象名与底层GLES glname是不同身份。查询始终读取当前纹理单元
+ * 的桌面对象名，未绑定时返回0；不修改绑定或触发GLES调用。
+ * int/double入口直接转换这个GLuint，不能先经过GLfloat丢掉大于2^24的名字位。
+ * 同一helper覆盖1D/2D/3D/rectangle/cube；不以底层驱动编号作为桌面状态。
+ */
+int amcl_texture_binding_name(GLenum pname, GLuint *name) {
+    int slot;
+    switch (pname) {
+        case GL_TEXTURE_BINDING_1D: slot=ENABLED_TEX1D; break;
+        case GL_TEXTURE_BINDING_2D: slot=ENABLED_TEX2D; break;
+        case GL_TEXTURE_BINDING_3D: slot=ENABLED_TEX3D; break;
+        case GL_TEXTURE_BINDING_RECTANGLE_ARB: slot=ENABLED_TEXTURE_RECTANGLE; break;
+        case GL_TEXTURE_BINDING_CUBE_MAP: slot=ENABLED_CUBE_MAP; break;
+        default: return 0;
+    }
+    const gltexture_t *texture=glstate->texture.bound[glstate->texture.active][slot];
+    *name=texture?texture->texture:0;
+    return 1;
+}
 
