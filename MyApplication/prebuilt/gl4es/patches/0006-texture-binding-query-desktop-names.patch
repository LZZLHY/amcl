+/* 仅同一DSO的getter实现共享，不作为公开GL或宿主ABI导出。读取当前context纹理
+ * 单元的逻辑名，返回是否识别token；无GLEScall、不改绑定、不读写错误账本。
+ * GCC/Clang是既有AliasExport依赖，hidden避免测试/生产发生跨DSO同名插桩。
+ */
+__attribute__((visibility("hidden"))) int amcl_texture_binding_name(GLenum pname, GLuint *name);
 
