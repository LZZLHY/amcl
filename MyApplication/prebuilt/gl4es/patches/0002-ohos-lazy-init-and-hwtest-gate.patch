diff --git a/src/gl/init.c b/src/gl/init.c
index 9410e66..73fb6c2 100755
--- a/src/gl/init.c
+++ b/src/gl/init.c
@@ -61,6 +61,18 @@ void set_getprocaddress(void *(*new_proc_address)(const char *)) {
     gles_getProcAddress = new_proc_address;
 }
 
+void initialize_gl4es();  // forward decl (defined below with constructor/visibility attrs)
+// OHOS lazy initialization. gl4es is built with NO_INIT_CONSTRUCTOR (a constructor would
+// dlopen the GLES lib nested inside the host loader's dlopen -> musl loader-lock deadlock).
+// On OHOS the GL library can be loaded by the JVM (LWJGL via org.lwjgl.opengl.libname) in a
+// SEPARATE linker namespace, where our explicit initialize_gl4es() call never reached -> that
+// instance stayed uninitialized (gles==NULL) -> LOAD_GLES skipped -> NULL GLES pointer -> crash.
+// Calling this at the top of the first GL entry points initializes whatever instance is being
+// used, from a normal call context (render thread, context current) -> no nested dlopen.
+void gl4es_ensure_init(void) {
+    if(!inited) initialize_gl4es();
+}
+
 #ifdef NO_INIT_CONSTRUCTOR
 __attribute__((visibility("default")))
 #else
@@ -198,7 +210,11 @@ void initialize_gl4es() {
 #endif
 
 #if (defined(NOEGL) && !defined(ANDROID) && !defined(__APPLE__)) || defined(__EMSCRIPTEN__)
-    int gl4es_notest = !gles_getProcAddress;
+    // OHOS: gate the hardware test on having a real GLES library handle (set via LIBGL_GLES),
+    // not on a custom proc-address resolver. With NOEGL we probe on the current context using
+    // gles_* resolved by dlsym(gles), so a real libGLESv3 handle is enough and lets us detect the
+    // real GLSL/NPOT/texture caps required for correct shader conversion.
+    int gl4es_notest = !gles;
 #else
     int gl4es_notest = IsEnvVarTrue("LIBGL_NOTEST");
 #endif
