+/* Draw 生产路径与便宜宿主门禁共用的纯整数规则；不依赖 GL/context/分配器。
+ * 输入使用已确认非负的容量/计数；所有乘加均转为减法/除法或 int64，防止缩窄与 C 溢出。
+ */
+#ifndef AMCL_DRAW_MATH_H
+#define AMCL_DRAW_MATH_H
+#include <stdint.h>
+#include <stddef.h>
+#include <limits.h>
+
+static inline int amcl_index_add(uint32_t raw, int32_t base, uint32_t *value) {
+    int64_t sum=(int64_t)raw+base;
+    if(sum<0) return 0;
+    *value=(uint32_t)sum; /* ARB：非负结果超过 32 位时按 2^32 取模。 */
+    return 1;
+}
+
+static inline int amcl_buffer_fits(size_t size,size_t offset,size_t count,size_t element) {
+    return element && offset<=size && count<=(size-offset)/element;
+}
+
+static inline int amcl_vertex_fits(size_t size,size_t offset,uint32_t last,size_t stride,size_t element) {
+    return stride && offset<=size && element<=size-offset && last<=(size-offset-element)/stride;
+}
+#endif
