diff --git a/src/gl/draw_batch.h b/src/gl/draw_batch.h
new file mode 100644
index 0000000..8038938
--- /dev/null
+++ b/src/gl/draw_batch.h
@@ -0,0 +1,471 @@
+/* AMCL 绘制补丁的私有辅助实现，仅由 drawing.c 在真实 GLES 提交函数之后包含。
+ * 公开入口仍保持原 ABI；本文件集中修复逐批参数、宽索引、范围与资源发布语义。
+ * 显示列表/pending 由 glstate 持有，临时链由调用 scope 持有；不使用会消费全局链的 NewDrawStage。
+ */
+#include <limits.h>
+#include <stdint.h>
+#include "draw_math.h"
+
+typedef struct {
+    renderlist_t *temporary;
+    GLenum error;
+    int old_shim;
+    GLenum old_error;
+    GLenum last_failure;
+    int pending_requested;
+} amcl_draw_scope_t;
+
+typedef struct {
+    const unsigned char *source;
+    GLenum type;
+    GLint base;
+    GLuint first;
+    GLsizei count;
+    GLuint minimum, maximum;
+} amcl_draw_view_t;
+
+/* 分配/范围辅助位于定义之前，先声明统一错误记录器，避免 C 的隐式外部声明。 */
+static void amcl_draw_error(amcl_draw_scope_t *scope, GLenum error);
+
+/* 通用属性的显示列表副本保留全部绑定槽和原始类型；引用数包含当前节点自身。
+ * buffer/real_buffer 清零后指向自有紧凑字节，不能再依赖调用者、VAO 或已删除 VBO 的生命期。
+ */
+struct amcl_draw_arrays_s {
+    unsigned references;
+    glvao_t vao;
+    void *storage[MAX_VATTRIB];
+};
+
+#ifdef AMCL_DRAW_TESTING
+static int amcl_draw_failure = -1;
+/* 仅测试构建导出：第 n 次绘制资源分配失败；生产库没有计数或注入分支。 */
+void amcl_draw_test_fail_after(int count) { amcl_draw_failure = count; }
+#endif
+
+void *amcl_draw_alloc(size_t bytes) {
+#ifdef AMCL_DRAW_TESTING
+    if(amcl_draw_failure == 0) return NULL;
+    if(amcl_draw_failure > 0) --amcl_draw_failure;
+#endif
+    return malloc(bytes);
+}
+
+/* 缓存增长使用临时返回值；失败时旧指针、容量及此前几何仍然有效。 */
+static void *amcl_draw_reserve(amcl_draw_scope_t *scope, size_t bytes) {
+    if(bytes > glstate->draw_indices_capacity) {
+        size_t capacity = glstate->draw_indices_capacity ? glstate->draw_indices_capacity : 256;
+        while(capacity < bytes) {
+            if(capacity > SIZE_MAX/2) { capacity = bytes; break; }
+            capacity *= 2;
+        }
+#ifdef AMCL_DRAW_TESTING
+        if(amcl_draw_failure == 0) { amcl_draw_error(scope,GL_OUT_OF_MEMORY); return NULL; }
+        if(amcl_draw_failure > 0) --amcl_draw_failure;
+#endif
+        void *next = realloc(glstate->draw_indices, capacity);
+        if(!next) { amcl_draw_error(scope,GL_OUT_OF_MEMORY); return NULL; }
+        glstate->draw_indices = next;
+        glstate->draw_indices_capacity = capacity;
+    }
+    return glstate->draw_indices;
+}
+
+void amcl_draw_arrays_retain(struct amcl_draw_arrays_s *arrays) {
+    if(arrays) ++arrays->references;
+}
+
+void amcl_draw_arrays_release(struct amcl_draw_arrays_s *arrays) {
+    if(!arrays || --arrays->references) return;
+    for(int a=0; a<MAX_VATTRIB; ++a) free(arrays->storage[a]);
+    free(arrays);
+}
+
+/* 逐批失败只记录首个错误，但另存本批原因，使 OOM 可停止而无效输入可跳过继续。 */
+static void amcl_draw_error(amcl_draw_scope_t *scope, GLenum error) {
+    if(!scope->error) scope->error=error;
+    scope->last_failure=error;
+}
+
+static amcl_draw_scope_t amcl_draw_begin(void) {
+    amcl_draw_scope_t scope = {NULL, GL_NO_ERROR, glstate->shim_error, glstate->last_error,GL_NO_ERROR,0};
+    return scope;
+}
+
+/* scope 保存旧错误，内部列表/FPE 的 noerrorShim 不得把未读错误抹掉。
+ * shim_error=3 专用于不清驱动错误的 Draw 协议，由 getter 读取一次后回到驱动通道。
+ */
+static void amcl_draw_finish(amcl_draw_scope_t *scope) {
+    if(scope->temporary) {
+        draw_renderlist(scope->temporary);
+        free_renderlist(scope->temporary);
+    }
+    GLenum error = (scope->old_shim && scope->old_error) ? scope->old_error : scope->error;
+    glstate->last_error = error;
+    glstate->shim_error = error ? 3 : 0;
+}
+
+/* 公共状态先校验，包含零批次；OpenGL 2.1 不支持 persistent mapping，当前 mapped 均是普通映射。 */
+static int amcl_draw_validate(amcl_draw_scope_t *scope, GLenum mode, GLenum type, int indexed, GLsizei count) {
+    if(glstate->list.begin) { amcl_draw_error(scope,GL_INVALID_OPERATION); return 0; }
+    if(mode > GL_POLYGON || (indexed && type!=GL_UNSIGNED_BYTE && type!=GL_UNSIGNED_SHORT && type!=GL_UNSIGNED_INT)) {
+        amcl_draw_error(scope,GL_INVALID_ENUM); return 0;
+    }
+    if(count < 0) { amcl_draw_error(scope,GL_INVALID_VALUE); return 0; }
+    for(int a=0; a<hardext.maxvattrib; ++a) {
+        vertexattrib_t *p=&glstate->vao->vertexattrib[a];
+        if(p->enabled && p->buffer && p->buffer->mapped) { amcl_draw_error(scope,GL_INVALID_OPERATION); return 0; }
+    }
+    if(indexed && glstate->vao->elements && glstate->vao->elements->mapped) {
+        amcl_draw_error(scope,GL_INVALID_OPERATION); return 0;
+    }
+    return 1;
+}
+
+/* 只校验将实际访问的最后一个顶点；使用除法/减法避免 offset+index*stride 溢出。
+ * 客户端仅能验证非空与可表示地址，不能据此声称已知道它的真实内存长度。
+ */
+static int amcl_draw_range(amcl_draw_scope_t *scope, GLuint maximum) {
+    for(int a=0; a<hardext.maxvattrib; ++a) {
+        vertexattrib_t *p=&glstate->vao->vertexattrib[a];
+        if(!p->enabled) continue;
+        int width=p->size==GL_BGRA ? 4 : p->size;
+        int size=gl_sizeof(p->type);
+        if(width<1 || width>4 || size<1 || p->stride<0) { amcl_draw_error(scope,GL_INVALID_OPERATION); return 0; }
+        size_t element=(size_t)width*size;
+        size_t stride=p->stride ? (size_t)p->stride : element;
+        uintptr_t offset=(uintptr_t)p->pointer;
+        if(p->buffer) {
+            if(p->buffer->size<0 || !amcl_vertex_fits(p->buffer->size,offset,p->divisor?0:maximum,stride,element) || !p->buffer->data) {
+                amcl_draw_error(scope,GL_INVALID_OPERATION); return 0;
+            }
+        } else if(!p->pointer || offset>UINTPTR_MAX-element || maximum>(UINTPTR_MAX-offset-element)/stride) {
+            amcl_draw_error(scope,GL_INVALID_OPERATION); return 0;
+        }
+    }
+    return 1;
+}
+
+/* memcpy 读取允许非对齐的客户端/EBO 索引；加法在 int64 中完成，正向 32 位溢出按 ARB 取模。 */
+static GLuint amcl_draw_index(const amcl_draw_view_t *view, GLsizei position) {
+    if(!view->source) return view->first+(GLuint)position;
+    GLuint value=0;
+    size_t size=view->type==GL_UNSIGNED_BYTE?1:view->type==GL_UNSIGNED_SHORT?2:4;
+    memcpy(&value, view->source+(size_t)position*size, size);
+    return (GLuint)((int64_t)value+view->base);
+}
+
+static int amcl_draw_indices(amcl_draw_scope_t *scope, amcl_draw_view_t *view, const void *indices) {
+    size_t size=view->type==GL_UNSIGNED_BYTE?1:view->type==GL_UNSIGNED_SHORT?2:4;
+    glbuffer_t *buffer=glstate->vao->elements;
+    if(buffer) {
+        uintptr_t offset=(uintptr_t)indices;
+        if(buffer->size<0 || !amcl_buffer_fits(buffer->size,offset,view->count,size) || !buffer->data) {
+            amcl_draw_error(scope,GL_INVALID_OPERATION); return 0;
+        }
+        view->source=(const unsigned char*)buffer->data+offset;
+    } else {
+        if(!indices || (size_t)view->count>(UINTPTR_MAX-(uintptr_t)indices)/size) {
+            amcl_draw_error(scope,GL_INVALID_OPERATION); return 0;
+        }
+        view->source=indices;
+    }
+    view->minimum=UINT_MAX; view->maximum=0;
+    for(GLsizei j=0; j<view->count; ++j) {
+        GLuint raw=0; memcpy(&raw, view->source+(size_t)j*size, size);
+        GLuint value;
+        if(!amcl_index_add(raw,view->base,&value)) { amcl_draw_error(scope,GL_INVALID_VALUE); return 0; }
+        if(value<view->minimum) view->minimum=value;
+        if(value>view->maximum) view->maximum=value;
+    }
+    return amcl_draw_range(scope, view->maximum);
+}
+
+/* buffer 属性中的 pointer 是 offset；复制时在局部描述中解析，不改写原 VAO/调用者指针。 */
+static vertexattrib_t amcl_draw_pointer(vertexattrib_t original, GLuint first) {
+    size_t width=original.size==GL_BGRA?4:original.size;
+    size_t stride=original.stride?original.stride:width*gl_sizeof(original.type);
+    original.pointer=(const void*)((uintptr_t)original.pointer+(original.buffer?(uintptr_t)original.buffer->data:0)+(size_t)first*stride);
+    original.buffer=NULL; original.real_buffer=0; original.real_pointer=0;
+    return original;
+}
+
+/* 全部属性在成功分配后才移交节点。fixed 路径沿原数组转换规则，shader 路径保留原槽与 normalized。
+ * map 为 NULL 时复制连续区间；否则按完整图元窗口的原始编号逐个复制，绝不截断绝对索引。
+ */
+static int amcl_draw_copy(amcl_draw_scope_t *scope, renderlist_t *node, GLuint first, GLuint count, const GLuint *map) {
+    if(hardext.esversion>1 && glstate->glsl->program) {
+        struct amcl_draw_arrays_s *arrays=amcl_draw_alloc(sizeof(*arrays));
+        if(!arrays) goto oom;
+        memset(arrays,0,sizeof(*arrays)); arrays->references=1; node->draw_arrays=arrays;
+        arrays->vao.maxtex=glstate->vao->maxtex;
+        for(int a=0; a<hardext.maxvattrib; ++a) {
+            vertexattrib_t p=glstate->vao->vertexattrib[a]; arrays->vao.vertexattrib[a]=p;
+            if(!p.enabled) continue;
+            size_t width=p.size==GL_BGRA?4:p.size, element=width*gl_sizeof(p.type);
+            if(count>SIZE_MAX/element) goto oom;
+            int convert=p.size==GL_BGRA || (p.type!=GL_FLOAT && p.type!=GL_BYTE && p.type!=GL_UNSIGNED_BYTE && p.type!=GL_SHORT && p.type!=GL_UNSIGNED_SHORT);
+            size_t output_element=convert?width*sizeof(GLfloat):element;
+            unsigned char *data=amcl_draw_alloc((size_t)node->cap*output_element);
+            if(!data) goto oom;
+            arrays->storage[a]=data;
+            for(GLuint j=0;j<count;++j) {
+                vertexattrib_t src=amcl_draw_pointer(p,p.divisor?0:(map?map[j]:first+j));
+                if(p.size==GL_BGRA) copy_gl_pointer_color_bgra_noalloc(data+j*output_element,src.pointer,src.stride,width,0,1);
+                else if(convert && p.normalized) {
+                    float filler=0;
+                    copy_gl_array_convert(src.pointer,src.type,src.size,src.stride,GL_FLOAT,width,0,1,&filler,data+j*output_element);
+                } else if(convert) copy_gl_pointer_raw_noalloc(data+j*output_element,&src,width,0,1);
+                else memcpy(data+j*output_element,src.pointer,element);
+            }
+            p.pointer=data; p.buffer=NULL; p.real_buffer=0; p.real_pointer=0; p.stride=output_element;
+            if(convert) { p.size=width; p.type=GL_FLOAT; p.normalized=GL_FALSE; }
+            arrays->vao.vertexattrib[a]=p;
+        }
+        return 1;
+    }
+    /* FPE 只复制固定管线实际使用的槽；每个输出数组都是该节点独有资源。 */
+    for(int a=0;a<hardext.maxvattrib;++a) {
+        GLfloat **output=NULL; int width=4, kind=0;
+        if(a==ATT_VERTEX) output=&node->vert;
+        else if(a==ATT_COLOR) { output=&node->color; kind=1; }
+        else if(a==ATT_SECONDARY) { output=&node->secondary; kind=2; }
+        else if(a==ATT_NORMAL) { output=&node->normal; width=3; kind=3; }
+        else if(a==ATT_FOGCOORD) { output=&node->fogcoord; width=1; kind=3; }
+        else if(a>=ATT_MULTITEXCOORD0 && a<ATT_MULTITEXCOORD0+hardext.maxtex) {
+            output=&node->tex[a-ATT_MULTITEXCOORD0]; node->maxtex=a-ATT_MULTITEXCOORD0+1;
+        }
+        vertexattrib_t p=glstate->vao->vertexattrib[a];
+        if(!output || !p.enabled) continue;
+        *output=amcl_draw_alloc((size_t)node->cap*width*sizeof(GLfloat));
+        if(!*output) goto oom;
+        for(GLuint j=0;j<count;++j) {
+            vertexattrib_t src=amcl_draw_pointer(p,p.divisor?0:(map?map[j]:first+j));
+            GLfloat *dst=*output+(size_t)j*width;
+            if(p.size==GL_BGRA) copy_gl_pointer_color_bgra_noalloc(dst,src.pointer,src.stride,width,0,1);
+            else if(kind==1) copy_gl_pointer_color_noalloc(dst,&src,width,0,1);
+            else if(kind==2) copy_gl_pointer_noalloc(dst,&src,width,0,1);
+            else if(kind==3) copy_gl_pointer_raw_noalloc(dst,&src,width,0,1);
+            else copy_gl_pointer_tex_noalloc(dst,&src,width,0,1);
+        }
+    }
+    return 1;
+oom:
+    amcl_draw_error(scope,GL_OUT_OF_MEMORY); return 0;
+}
+
+/* 真实生产列表中的通用属性节点在现有 listdraw 的状态命令之后执行，不另建命令框架。
+ * 此处只临时切换取数 VAO，调用后恢复公开 VAO/EBO；FPE 会在下一次提交同步硬件缓存。
+ */
+int amcl_draw_render_node(renderlist_t *node) {
+    if(!node->draw_arrays) return 0;
+    glvao_t *saved=glstate->vao;
+    glstate->vao=&node->draw_arrays->vao;
+    glDrawElementsCommon(node->mode,0,node->ilen,node->len,node->indices,NULL,1);
+    glstate->vao=saved;
+    return 1;
+}
+
+/* 只合并本补丁建立的纯独占节点，容量和属性布局均相符；准备全部新资源后才替换旧节点。
+ * 分配失败可保留两节点顺序提交，不必把可完成的绘制变成失败或丢失旧资源。
+ */
+static renderlist_t *amcl_draw_merge(renderlist_t *old, renderlist_t *node) {
+    if(!globals4es.mergelist || !old || !old->amcl_draw_owned || old->draw_arrays || node->draw_arrays ||
+       old->mode!=node->mode || old->mode_init!=node->mode_init ||
+       (old->mode!=GL_POINTS && old->mode!=GL_LINES && old->mode!=GL_TRIANGLES) ||
+       old->len+node->len>60000 || old->ilen+node->ilen>60000 || !islistscompatible_renderlist(old,node)) return NULL;
+    /* 预留容量内的追加不会分配，也不会触及前批；所有输入已由新节点的构造验证。 */
+    if(old->cap>=old->len+node->len && old->indice_cap>=old->ilen+node->ilen) {
+        #define AMCL_APPEND(field,width) if(old->field) memcpy(old->field+old->len*(width),node->field,node->len*(width)*sizeof(GLfloat))
+        AMCL_APPEND(vert,4); AMCL_APPEND(normal,3); AMCL_APPEND(color,4); AMCL_APPEND(secondary,4); AMCL_APPEND(fogcoord,1);
+        for(int t=0;t<old->maxtex;++t) { AMCL_APPEND(tex[t],4); }
+        #undef AMCL_APPEND
+        for(unsigned long j=0;j<node->ilen;++j) old->indices[old->ilen+j]=node->indices[j]+old->len;
+        old->len+=node->len; old->ilen+=node->ilen;
+        return old;
+    }
+    renderlist_t *merged=alloc_renderlist();
+    if(!merged) return NULL;
+    merged->mode=old->mode; merged->mode_init=old->mode_init;
+    merged->mode_dimension=old->mode_dimension; merged->amcl_draw_owned=1;
+    merged->len=old->len+node->len; merged->cap=old->cap;
+    while(merged->cap<merged->len) merged->cap*=2;
+    merged->ilen=old->ilen+node->ilen; merged->indice_cap=old->indice_cap;
+    while(merged->indice_cap<merged->ilen) merged->indice_cap*=2;
+    merged->maxtex=old->maxtex;
+    merged->indices=amcl_draw_alloc(merged->indice_cap*sizeof(GLushort));
+    if(!merged->indices) goto fail;
+    memcpy(merged->indices,old->indices,old->ilen*sizeof(GLushort));
+    for(unsigned long j=0;j<node->ilen;++j) merged->indices[old->ilen+j]=node->indices[j]+old->len;
+    #define AMCL_COPY(field,width) \
+        if(old->field) { \
+            merged->field=amcl_draw_alloc(merged->cap*(width)*sizeof(GLfloat)); \
+            if(!merged->field) goto fail; \
+            memcpy(merged->field,old->field,old->len*(width)*sizeof(GLfloat)); \
+            memcpy(merged->field+old->len*(width),node->field,node->len*(width)*sizeof(GLfloat)); \
+        }
+    AMCL_COPY(vert,4); AMCL_COPY(normal,3); AMCL_COPY(color,4); AMCL_COPY(secondary,4); AMCL_COPY(fogcoord,1);
+    for(int t=0;t<merged->maxtex;++t) { AMCL_COPY(tex[t],4); }
+    #undef AMCL_COPY
+    merged->stage=STAGE_POSTDRAW;
+    return merged;
+fail:
+    free_renderlist(merged); return NULL;
+}
+
+static void amcl_draw_publish(amcl_draw_scope_t *scope, renderlist_t *node) {
+    /* 首个有效节点构造成功才发布 pending；失败的准备不能留下空的全局 active。 */
+    renderlist_t **owner=glstate->list.active?&glstate->list.active:&scope->temporary;
+    if(scope->pending_requested && !glstate->list.active) {
+        owner=&glstate->list.active;
+        glstate->list.pending=1;
+        scope->pending_requested=0;
+    }
+    renderlist_t *old=*owner;
+    renderlist_t *merged=amcl_draw_merge(old,node);
+    if(merged==old && old) {
+        free_renderlist(node);
+    } else if(merged) {
+        merged->prev=old->prev;
+        if(merged->prev) merged->prev->next=merged;
+        old->prev=NULL; free_renderlist(old); free_renderlist(node); *owner=merged;
+    } else {
+        if(old) { old->next=node; node->prev=old; }
+        *owner=node;
+    }
+}
+
+/* 创建有界顶点窗口并自有化索引。QUADS 在发布前完成可失败的三角化，end_renderlist 不再分配。
+ * GLenum mode_init 保留原图元信息，线框另用完整边界生成的 GL_LINES，不引入三角对角线。
+ */
+static int amcl_draw_node(amcl_draw_scope_t *scope, const amcl_draw_view_t *view, GLenum mode, GLuint first,
+                          GLuint vertices, const GLuint *map, GLsizei offset, GLsizei count) {
+    renderlist_t *node=alloc_renderlist();
+    if(!node) { amcl_draw_error(scope,GL_OUT_OF_MEMORY); return 0; }
+    node->mode=node->mode_init=mode; node->mode_dimension=rendermode_dimensions(mode);
+    node->len=vertices; node->cap=128;
+    while(node->cap<vertices) node->cap*=2;
+    node->amcl_draw_owned=1;
+    GLsizei indices=mode==GL_QUADS?(count/4)*6:count;
+    node->indice_cap=128;
+    while(node->indice_cap<(unsigned)indices) node->indice_cap*=2;
+    node->indices=amcl_draw_alloc((size_t)node->indice_cap*sizeof(GLushort));
+    if(!node->indices) { amcl_draw_error(scope,GL_OUT_OF_MEMORY); goto fail; }
+    node->ilen=indices;
+    if(mode==GL_QUADS) {
+        const int quad[6]={0,1,2,0,2,3};
+        for(GLsizei j=0;j<count/4;++j) for(int k=0;k<6;++k)
+            node->indices[j*6+k]=map?j*4+quad[k]:amcl_draw_index(view,offset+j*4+quad[k])-first;
+        node->mode=GL_TRIANGLES;
+    } else for(GLsizei j=0;j<count;++j)
+        node->indices[j]=map?j:amcl_draw_index(view,offset+j)-first;
+    if(!amcl_draw_copy(scope,node,first,vertices,map)) goto fail;
+    node->stage=STAGE_POSTDRAW;
+    amcl_draw_publish(scope,node);
+    return 1;
+fail:
+    free_renderlist(node); return 0;
+}
+
+/* 大跨度只在转译路径展开完整图元。strip 的奇偶交换、fan 中心及 loop 闭合显式保留。
+ * 窗口最多 60000 个局部顶点；原始编号仍用 GLuint，复制所有实际使用属性后才用 ushort。
+ */
+static int amcl_draw_windows(amcl_draw_scope_t *scope, const amcl_draw_view_t *view, GLenum mode) {
+    if(view->maximum-view->minimum<60000 && glstate->polygon_mode!=GL_LINE)
+        return amcl_draw_node(scope,view,mode,view->minimum,view->maximum-view->minimum+1,NULL,0,view->count);
+    GLuint *map=amcl_draw_alloc(60000*sizeof(GLuint));
+    if(!map) { amcl_draw_error(scope,GL_OUT_OF_MEMORY); return 0; }
+    int width=1; GLuint primitives=view->count; GLenum output=GL_POINTS;
+    int wire=glstate->polygon_mode==GL_LINE && mode>=GL_TRIANGLES;
+    switch(mode) {
+        case GL_LINES: width=2; primitives=view->count/2; output=GL_LINES; break;
+        case GL_LINE_STRIP: case GL_LINE_LOOP: width=2; primitives=view->count>1?view->count-(mode==GL_LINE_STRIP):0; output=GL_LINES; break;
+        case GL_TRIANGLES: width=3; primitives=view->count/3; output=GL_TRIANGLES; break;
+        case GL_TRIANGLE_STRIP: case GL_TRIANGLE_FAN: case GL_POLYGON: width=3; primitives=view->count>2?view->count-2:0; output=GL_TRIANGLES; break;
+        case GL_QUADS: width=4; primitives=view->count/4; output=GL_QUADS; break;
+        case GL_QUAD_STRIP:
+            if(wire) { width=4; primitives=view->count>3?(view->count-2)/2:0; output=GL_QUADS; }
+            else { width=3; primitives=view->count>3?view->count-2:0; output=GL_TRIANGLES; }
+            break;
+    }
+    /* Polygon 线框只包含外边界，不能把 fan 三角化的内部辐射边也画出来。 */
+    if(wire && mode==GL_POLYGON) { width=2; primitives=view->count>2?view->count:0; output=GL_LINES; wire=0; }
+    GLuint used=0; int success=1;
+    for(GLuint p=0;p<primitives;++p) {
+        GLuint local[4];
+        for(int k=0;k<width;++k) local[k]=p*width+k;
+        if(mode==GL_LINE_STRIP || mode==GL_LINE_LOOP) { local[0]=p; local[1]=(p+1)%view->count; }
+        if(mode==GL_TRIANGLE_STRIP || (mode==GL_QUAD_STRIP && !wire)) { local[0]=p+(p&1); local[1]=p+1-(p&1); local[2]=p+2; }
+        if(mode==GL_TRIANGLE_FAN || (mode==GL_POLYGON && width==3)) { local[0]=0; local[1]=p+1; local[2]=p+2; }
+        if(mode==GL_POLYGON && width==2) { local[0]=p; local[1]=(p+1)%view->count; }
+        if(mode==GL_QUAD_STRIP && wire) { local[0]=p*2; local[1]=p*2+1; local[2]=p*2+3; local[3]=p*2+2; }
+        GLuint contribution=wire?width*2:width;
+        if(used+contribution>60000) {
+            if(!amcl_draw_node(scope,view,wire?GL_LINES:output,0,used,map,0,used)) { success=0; break; }
+            used=0;
+        }
+        if(wire) for(int k=0;k<width;++k) {
+            map[used++]=amcl_draw_index(view,local[k]); map[used++]=amcl_draw_index(view,local[(k+1)%width]);
+        } else for(int k=0;k<width;++k) map[used++]=amcl_draw_index(view,local[k]);
+    }
+    if(success && used) success=amcl_draw_node(scope,view,wire?GL_LINES:output,0,used,map,0,used);
+    free(map); return success;
+}
+
+/* 直接 GLES 的索引保留绝对编号，32 位能力存在时不为大索引新建 ushort 副本。
+ * 非零 base 与 QUADS 转换复用 context 自有缓存，没有逐批 malloc 或驱动 error query。
+ */
+static int amcl_draw_direct(amcl_draw_scope_t *scope, const amcl_draw_view_t *view, GLenum mode) {
+    if(!view->source && mode!=GL_QUADS) {
+        glDrawElementsCommon(mode,view->first,view->count,view->count,NULL,NULL,1); return 1;
+    }
+    if(view->source && !view->base && mode!=GL_QUADS && view->type==GL_UNSIGNED_INT && hardext.elementuint) {
+        glDrawElementsCommon(mode,0,view->count,0,NULL,(const GLuint*)view->source,1); return 1;
+    }
+    if(view->source && !view->base && mode!=GL_QUADS && view->type==GL_UNSIGNED_SHORT) {
+        glDrawElementsCommon(mode,0,view->count,0,(const GLushort*)view->source,NULL,1); return 1;
+    }
+    int wide=view->maximum>65535;
+    if(wide && !hardext.elementuint) return amcl_draw_windows(scope,view,mode);
+    GLsizei count=mode==GL_QUADS?(view->count/4)*6:view->count;
+    void *buffer=amcl_draw_reserve(scope,(size_t)count*(wide?4:2));
+    if(!buffer) return 0;
+    const int quad[6]={0,1,2,0,2,3};
+    for(GLsizei j=0;j<count;++j) {
+        GLsizei source=mode==GL_QUADS?(j/6)*4+quad[j%6]:j;
+        GLuint value=amcl_draw_index(view,source);
+        if(wide) ((GLuint*)buffer)[j]=value; else ((GLushort*)buffer)[j]=value;
+    }
+    glDrawElementsCommon(mode==GL_QUADS?GL_TRIANGLES:mode,0,count,0,wide?NULL:buffer,wide?buffer:NULL,1);
+    return 1;
+}
+
+static int amcl_draw_submit(amcl_draw_scope_t *scope, amcl_draw_view_t *view, GLenum mode) {
+    int intercept=should_intercept_render(mode);
+    /* flush 后必须重读 active；不能保留已被 flush 释放的 compiling/list 别名。 */
+    if(glstate->list.pending && !glstate->list.compiling && !intercept && view->count>MAX_BATCH) gl4es_flush();
+    if(!glstate->list.active && globals4es.maxbatch &&
+       (intercept || (view->count>=MIN_BATCH && view->count<=MAX_BATCH))) {
+        scope->pending_requested=1;
+    }
+    if(glstate->polygon_mode==GL_POINT && mode>=GL_TRIANGLES) mode=GL_POINTS;
+    if(glstate->list.active || scope->pending_requested || intercept) return amcl_draw_windows(scope,view,mode);
+    return amcl_draw_direct(scope,view,mode);
+}
+
+static int amcl_draw_array(amcl_draw_scope_t *scope, GLenum mode, GLint first, GLsizei count) {
+    if(first<0 || (uint64_t)(GLuint)first+(GLuint)count>INT_MAX || count>INT_MAX/6) { amcl_draw_error(scope,GL_INVALID_VALUE); return 0; }
+    count=adjust_vertices(mode,count);
+    if(!count) return 1;
+    amcl_draw_view_t view={NULL,0,0,first,count,first,(GLuint)first+count-1};
+    if(!amcl_draw_range(scope,view.maximum)) return 0;
+    return amcl_draw_submit(scope,&view,mode);
+}
+
+static int amcl_draw_element(amcl_draw_scope_t *scope, GLenum mode, GLsizei count, GLenum type, const void *indices, GLint base) {
+    if(count>INT_MAX/6) { amcl_draw_error(scope,GL_OUT_OF_MEMORY); return 0; }
+    count=adjust_vertices(mode,count);
+    if(!count) return 1;
+    amcl_draw_view_t view={NULL,type,base,0,count,0,0};
+    if(!amcl_draw_indices(scope,&view,indices)) return 0;
+    return amcl_draw_submit(scope,&view,mode);
+}
