--- /dev/null
+++ b/src/hotspot/os/linux/ohos_temp_directory.hpp
@@ -0,0 +1,63 @@
+/*
+ * AMCL 的 OHOS 原生临时根候选，仅用于后续受控 OpenJDK source patch。
+ * 该状态在 os::init 起点从启动 TMPDIR 冻结；getter 不读环境、不分配、不做文件IO。
+ * Java 的 -Djava.io.tmpdir 不参与工具发现协议，应用可保留其原有 Java 文件语义。
+ * /tmp 只是与上游一致的无配置值，不代表当前 OHOS token 已证明它可写。
+ */
+#ifndef AMCL_OHOS_TEMP_DIRECTORY_HPP
+#define AMCL_OHOS_TEMP_DIRECTORY_HPP
+
+#include <errno.h>
+#include <stddef.h>
+#include <string.h>
+#ifdef _MSC_VER
+#include <intrin.h>
+#endif
+
+// 固定缓冲避免崩溃报告路径依赖分配器；显式过长输入拒绝，绝不截断为另一目录。
+enum { AMCL_OHOS_TEMP_PATH_CAPACITY = 4096 };
+struct AmclOhosTempDirectory {
+  char storage[AMCL_OHOS_TEMP_PATH_CAPACITY];
+  void* volatile published;
+  int error;
+  bool frozen;
+};
+#define AMCL_OHOS_TEMP_INITIALIZER {{0}, NULL, 0, false}
+
+// 调用者在允许读启动环境的唯一初始化点传入 getenv("TMPDIR") 的值。
+// 此函数不创建目录或猜测缓存根，目录所有权/可用性由真实消费者和宿主准备阶段验证。
+inline int amcl_freeze_ohos_temp_directory(AmclOhosTempDirectory* state, const char* startup_tmpdir) {
+  if (state->frozen) return state->error;
+  state->frozen = true;
+  if (startup_tmpdir == NULL || startup_tmpdir[0] == '\0') return 0;
+  if (startup_tmpdir[0] != '/') return state->error = EINVAL;
+  size_t length = 0;
+  while (length < sizeof(state->storage) && startup_tmpdir[length] != '\0') ++length;
+  if (length == sizeof(state->storage)) return state->error = ENAMETOOLONG;
+  // 原生协议保留一个根分隔符，去掉其它尾分隔符；不解析符号链接或改变目录身份。
+  while (length > 1 && startup_tmpdir[length - 1] == '/') --length;
+  memcpy(state->storage, startup_tmpdir, length);
+  state->storage[length] = '\0';
+  // 完整正文与NUL准备好以后才发布指针；初始化中发生fatal也只会读到旧常量，
+  // 不会看到正在复制的半条路径。OHOS的指针原子读写无需额外库或锁。
+#ifdef _MSC_VER
+  _InterlockedExchangePointer(&state->published, state->storage);
+#else
+  __atomic_store_n(&state->published, static_cast<void*>(state->storage), __ATOMIC_RELEASE);
+#endif
+  return 0;
+}
+
+// 初始化前与配置无效时均保留常量fallback；配置错误必须由创建VM的返回值通路拒绝，
+// 不能因getter有fallback就把显式错误输入算作初始化成功。fatal路径不再次读TMPDIR。
+inline const char* amcl_ohos_temp_directory(AmclOhosTempDirectory* state) {
+#ifdef _MSC_VER
+  const char* path = static_cast<const char*>(_InterlockedCompareExchangePointer(
+      &state->published, NULL, NULL));
+#else
+  const char* path = static_cast<const char*>(__atomic_load_n(&state->published, __ATOMIC_ACQUIRE));
+#endif
+  return path != NULL ? path : "/tmp";
+}
+
+#endif
