+#ifdef __OHOS__
+void AttachListener::vm_shutdown() {
+  OhosAttachLifecycleLock guard;
+  ohos_attach_stopping = true; // 与init同锁：已开始的发布先完成；此后发布/重启都拒绝。
+  if (LinuxAttachListener::has_path()) {
+    char owned_path[UNIX_PATH_MAX];
+    strcpy(owned_path, LinuxAttachListener::path());
+    LinuxAttachListener::set_path(NULL); // 先撤销路径归属，后续atexit不再重复unlink或误删同名新对象。
+    int result;
+    RESTARTABLE(::unlink(owned_path), result); // 只重试EINTR，绝不把其他删除错误当成功。
+    if (result != 0 && errno != ENOENT) {
+      const int cleanup_error = errno;
+      // 此入口只在正常VM终结，tty尚未释放；fatal abort仍沿自己的无新增日志路径。
+      warning("OHOS Attach socket cleanup failed (errno=%d): %s", cleanup_error, owned_path);
+    }
+  }
+  // 不shutdown/close或重置_listener：在途native accept仍可借用该FD。
+  // 保留HotSpot原有一次VM到进程退出边界；普通atexit仍full cleanup，NCP quick_exit由OS回收FD。
+}
+#endif
