+  OhosAttachLifecycleLock(const OhosAttachLifecycleLock&);
+  OhosAttachLifecycleLock& operator=(const OhosAttachLifecycleLock&);
+ public:
+  explicit OhosAttachLifecycleLock(bool fatal = false) {
+    int result = fatal ? pthread_mutex_trylock(&ohos_attach_lifecycle_mutex)
+                       : pthread_mutex_lock(&ohos_attach_lifecycle_mutex);
+    _locked = result == 0;
+    guarantee(fatal || _locked, "OHOS attach lifecycle mutex lock failed");
+  }
+  ~OhosAttachLifecycleLock() {
+    if (_locked) pthread_mutex_unlock(&ohos_attach_lifecycle_mutex);
+  }
+  bool locked() const { return _locked; }
+};
+static bool ohos_attach_is_stopping() {
+  OhosAttachLifecycleLock guard;
+  return ohos_attach_stopping;
+}
