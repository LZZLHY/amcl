 static void invalidateJavaScaler(JNIEnv *env,
                                  jobject scaler,
                                  FTScalerInfo* scalerInfo) {
+    jthrowable original = (*env)->ExceptionOccurred(env);
+    if (original != NULL) (*env)->ExceptionClear(env);
     freeNativeResources(env, scalerInfo);
     (*env)->CallVoidMethod(env, scaler, invalidateScalerMID);
+    if (original != NULL) {
+        /* invalidateScaler 先清 native 指针再抛自己的异常，不能覆盖先前读失败。 */
+        if ((*env)->ExceptionCheck(env)) (*env)->ExceptionClear(env);
+        (*env)->Throw(env, original);
+        (*env)->DeleteLocalRef(env, original);
+    } else {
+        (void)(*env)->ExceptionCheck(env); /* 保留 invalidateScaler 的原异常并满足 JNI 检查。 */
+    }
