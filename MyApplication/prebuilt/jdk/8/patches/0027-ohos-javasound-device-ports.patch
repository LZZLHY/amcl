+JNIEXPORT void JNICALL Java_com_sun_media_sound_PortMixer_nClose(JNIEnv *env, jclass cls, jlong handle)
+{
+    (void)env; (void)cls; if (handle) (void)amcl_ports_close((uint64_t)handle);
+}
