 JavaVM *jvm;
 
+/* AMCL：只缓存完整成功的布尔结果，绝不缓存线程私有JNIEnv或半初始化状态。
+ * 原子load是成功后的唯一开销；冷初始化可并发，各自使用当前线程env，不持锁跨Java。
+ */
+static jint awtHeadlessState = -1;
+
+static jboolean AWTHeadlessFailure(JNIEnv *env, const char *message) {
+    if (env != NULL && !(*env)->ExceptionCheck(env)) {
+        JNU_ThrowInternalError(env, message);
+    }
+    return JNI_FALSE;
+}
+
+/* 返回值表示查询是否完整成功；value才是headless值，合法false不能和失败混淆。 */
+static jboolean AWTGetHeadless(JNIEnv *env, jboolean *value) {
+    jint cached = __atomic_load_n(&awtHeadlessState, __ATOMIC_ACQUIRE);
+    jclass graphicsEnvClass;
+    jmethodID headlessFn;
+    jboolean result;
+    jint expected;
+    if (cached >= 0) {
+        *value = (jboolean)cached;
+        return JNI_TRUE;
+    }
+    if (env == NULL) {
+        if (jvm == NULL) return JNI_FALSE;
+        env = (JNIEnv *)JNU_GetEnv(jvm, JNI_VERSION_1_2);
+    }
+    if (env == NULL || (*env)->ExceptionCheck(env)) return JNI_FALSE;
+    graphicsEnvClass = (*env)->FindClass(env, "java/awt/GraphicsEnvironment");
+    if (graphicsEnvClass == NULL || (*env)->ExceptionCheck(env)) {
+        if (graphicsEnvClass != NULL) (*env)->DeleteLocalRef(env, graphicsEnvClass);
+        return AWTHeadlessFailure(env, "GraphicsEnvironment lookup returned no usable class");
+    }
+    headlessFn = (*env)->GetStaticMethodID(env, graphicsEnvClass, "isHeadless", "()Z");
+    if (headlessFn == NULL || (*env)->ExceptionCheck(env)) {
+        (*env)->DeleteLocalRef(env, graphicsEnvClass);
+        return AWTHeadlessFailure(env, "GraphicsEnvironment.isHeadless lookup failed");
+    }
+    result = (*env)->CallStaticBooleanMethod(env, graphicsEnvClass, headlessFn);
+    if ((*env)->ExceptionCheck(env)) {
+        (*env)->DeleteLocalRef(env, graphicsEnvClass);
+        return JNI_FALSE;
+    }
+    (*env)->DeleteLocalRef(env, graphicsEnvClass);
+    expected = -1;
+    /* Java自身拥有headless决策；并发成功者只发布第一个完整结果，不覆盖失败或半成品。 */
+    __atomic_compare_exchange_n(&awtHeadlessState, &expected, result ? 1 : 0,
+                                0, __ATOMIC_RELEASE, __ATOMIC_RELAXED);
+    *value = (jboolean)__atomic_load_n(&awtHeadlessState, __ATOMIC_ACQUIRE);
+    return JNI_TRUE;
+}
