+// 只在真正嵌入 AMCL 的进程采用注入路径。独立 CLI 在 exec 后没有此入口，
+// 即使继承 JAVA_HOME/SUN_BOOT_LIBRARY_PATH，也必须保留上游定位与重执行行为。
+static bool amcl_uses_embedded_runtime() {
+#if defined(__OHOS__)
+  typedef int (*amcl_embedded_query_t)(void);
+  amcl_embedded_query_t query = (amcl_embedded_query_t)dlsym(RTLD_DEFAULT, "amcl_jvm_is_embedded");
+  return query != NULL && query() == 1;
+#else
+  return false;
+#endif
+}
