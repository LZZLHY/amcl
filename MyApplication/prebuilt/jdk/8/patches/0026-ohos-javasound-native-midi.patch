+        if ((*env)->ExceptionCheck(env)) break; /* 原用户异常原样传播，不能带pending异常继续JNI。 */
+    }
+    (*env)->PopLocalFrame(env, NULL);
+release:
+    amcl_midi_read_end(use); amcl_midi_release(use); dlclose(codeLease);
+}
