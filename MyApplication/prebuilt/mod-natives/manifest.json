      "bundledPath": "entry/libs/arm64-v8a/libsdl2gdx.so",
      "loadMechanism": "verified game-classloader JNI, SDL2",
      "triggeredBy": ["Controllable 0.11.2 for Minecraft 1.12.2"],
      "artifactLock": "prebuilt/mod-natives/sdl2/artifacts.json",
      "buildScript": "scripts/build-sdl2-gamepads.py"
    },
    {
      "name": "jamepad",
      "artifact": "libjamepad.so",
      "distribution": "bundled",
      "bundledPath": "entry/libs/arm64-v8a/libjamepad.so",
      "loadMechanism": "verified game-classloader JNI, SDL2",
      "triggeredBy": ["Controllable 0.2.0 for Minecraft 1.12.2"],
      "artifactLock": "prebuilt/mod-natives/sdl2/artifacts.json",
      "buildScript": "scripts/build-sdl2-gamepads.py"
    },
    {
      "name": "sherpa-onnx-jni",
      "artifact": "libsherpa-onnx-jni.so",
      "distribution": "bundled",
      "bundledPath": "entry/libs/arm64-v8a/libsherpa-onnx-jni.so",
      "loadMechanism": "verified-sherpa-native-path",
      "loadMechanismNote": "完整235类身份唯一命中后，在模组初始化前使用Sherpa公开库路径；未知绑定不强行选库。",
      "sourceDir": "prebuilt/mod-natives/sherpa-onnx",
      "artifactLock": "prebuilt/mod-natives/sherpa-onnx/artifacts.json",
      "buildScript": "scripts/build-sherpa-ohos.py",
      "status": "target-built; host inference verified; OHOS device qualification pending"
    },
    {
      "name": "sherpa-onnx-runtime",
      "artifact": "libonnxruntime.so",
      "distribution": "bundled",
      "bundledPath": "entry/libs/arm64-v8a/libonnxruntime.so",
      "loadMechanism": "needed-by-verified-sherpa-jni",
      "artifactLock": "prebuilt/mod-natives/sherpa-onnx/artifacts.json",
      "status": "target-built; CPU model host verification passed; device qualification pending"
    },
    {
      "name": "imgui-java",
      "artifact": "libimgui-java64.so",
      "distribution": "bundled",
      "bundledPath": "entry/libs/arm64-v8a/libimgui-java64.so",
      "loadMechanism": "loadLibrary",
      "loadMechanismNote": "imgui-java ImGui.<clinit> 先 System.loadLibrary(\"imgui-java64\")，命中 java.library.path(=hapNativeDir) 即用我们的库；失败才解压自带 x86 .so。AMCL 已把 hapNativeDir 放进 java.library.path，故无需额外接线。",
      "systemProperties": {},
      "imguiVersion": "1.86",
      "upstream": "https://github.com/SpaiR/imgui-java",
      "includedExtensions": ["core", "implot", "imnodes", "imguizmo", "knobs", "ImCurveEdit", "ImZoomSlider", "memory_editor"],
      "excludedExtensions": ["TextEditor", "ImGuiFileDialog", "node-editor(thedmd/crude_json)"],
      "excludedReason": "依赖 libc++ <locale> 的 glibc 专属 *_l 函数（strtoll_l 等），OHOS musl 无；且 CorgiLib/游戏类 mod 不用。",
      "triggeredBy": ["CorgiLib (corgilib)"],
      "sourceDir": "prebuilt/mod-natives/imgui-java/jni",
      "buildScript": "prebuilt/mod-natives/imgui-java/build-ohos.sh",
