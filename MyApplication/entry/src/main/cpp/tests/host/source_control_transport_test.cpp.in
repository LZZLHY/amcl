        AmclLookPolicyV1 policy{sizeof(AmclLookPolicyV1),0,1.0,0.5,0.0};
        CHECK(look->applyPolicy(1,&policy)==0);
        AmclLookStreamV1 touch{};touch.size=sizeof(touch);touch.source=1;
        touch.kind=AMCL_LOOK_TOUCH_DELTA;touch.clock=AMCL_LOOK_OWNER_MONOTONIC;
