            sourceResolveCalls=0;
#endif
            CHECK(inputBridge_submitLookV1(touchStream,20,0,now(),0)==1);pump(window);
#ifdef AMCL_SOURCE_RESOLVE_COUNT_TEST
            // 首个look可做冷握手；第二次真实look必须走原连接，不重扫Core发现运输。
            if(down==1)CHECK(sourceResolveCalls==0);
            sourceResolveCalls=0;
#endif
            const double cursorBefore=window.cursorX;delivery.clear();
            const unsigned notificationsBefore=notified.load();
            for(int repeat=0;repeat<16;++repeat) {
                const auto duplicate=transaction(source,producer,sprint);
                CHECK(duplicate.accepted&&duplicate.transportAccepted&&duplicate.finalEdges==0);
                // 也经过真实平台适配器，避免仅直调owner通过而实际摇杆入口仍逐笔重握手。
                const auto platformDuplicate=SourceTransaction(sprint);
                CHECK(platformDuplicate.accepted&&platformDuplicate.transportAccepted&&platformDuplicate.finalEdges==0);
                pump(window);
            }
            CHECK(notified.load()==notificationsBefore);
#ifdef AMCL_SOURCE_RESOLVE_COUNT_TEST
            CHECK(sourceResolveCalls==0);
#endif
            // 共有零边沿运输入口也必须守住同一合同，覆盖合法共持账本变化等没有
            // 命中Source幂等快路径的调用者，避免仅在摇杆侧缓存把桥层缺陷藏起来。
            CHECK(inputBridge_beginSourceActionV1(0)==1);inputBridge_endLookActionV1();pump(window);
            std::printf("NO_EDGE_LOOK action=%d before=%.9f after=%.9f callbacks=%zu\n",
                down,cursorBefore,window.cursorX,delivery.size());std::fflush(stdout);
            CHECK(window.cursorX==cursorBefore&&delivery.empty());
