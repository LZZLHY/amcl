    CHECK(transaction(source,producer,anonymous).accepted);anonymous.action=0;CHECK(transaction(source,producer,anonymous).accepted);pump(window);CHECK(glfwGetKey(&window,67)==0);
    // 六码必须全预算：真8槽已有2条时，prefix+6无法提交，source/token/look均不得半变。
    inputBridge_setGrabState(1);AmclLookResourceV1 resource{};CHECK(inputBridge_getLookResourceV1(&resource)==1);
    const auto* look=amclLookExecutionGetPortV1();
    {
        // 复现双手输入：视角已发出平滑的前段，摇杆重复提交同一疾跑键状态。
        // 没有实际按键边沿时，另一手的剩余视角必须留给下一次真实视角采样，不能被
