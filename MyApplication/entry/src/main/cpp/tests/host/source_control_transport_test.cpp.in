void Java_org_lwjgl_glfw_CallbackBridge_nativeSendMouseButton(void*,void*,int,int,int);
std::vector<int> delivery;double actionCursor=0;
std::vector<int> ownedKeyEdges;
std::vector<int> ownedBoundary;
bool observingOwnedBoundary=false;
const AmclSourceControlPortV1* notifyOwner=nullptr;uint64_t notifyProducer=0;
std::atomic<unsigned> notified{0};
/** 实际 bridge 的通知出口只做跨线程读取探针，验证它到达时已释放 source/order/push。
 * 不是把回调结果当成交付；窗口 cache/poll 仍在下面真正 production consumer 执行。 */
extern "C" void amclDesktopNotifyInput(){
    if(!notifyOwner)return;
    std::atomic<bool> queried{false};
    std::thread probe([&]{AmclSourceSnapshotV1 snapshot{};
        if(notifyOwner->query(notifyProducer,0,nullptr,&snapshot)==0)queried.store(true,std::memory_order_release);});
    const auto deadline=std::chrono::steady_clock::now()+std::chrono::milliseconds(500);
    while(!queried.load(std::memory_order_acquire)&&std::chrono::steady_clock::now()<deadline)std::this_thread::yield();
    if(!queried.load(std::memory_order_acquire)){probe.detach();CHECK(false);}
    probe.join();notified.fetch_add(1,std::memory_order_relaxed);
}
void moved(GLFWwindow* window,double x,double){CHECK(window->cursorX==x);delivery.push_back(1);}
void deliveredKey(GLFWwindow* window,int code,int,int action,int){if(code==259){ownedKeyEdges.push_back(action);if(observingOwnedBoundary)ownedBoundary.push_back(action==1?1:2);}if(action==1){actionCursor=window->cursorX;delivery.push_back(2);}}
void deliveredChar(void*,unsigned int code){if(observingOwnedBoundary&&(code=='o'||code=='n'))ownedBoundary.push_back(code=='o'?3:4);}
void deliveredButton(GLFWwindow*,int,int,int){}
void rawKey(void* window,int code,int scan,int action,int mods){
    GlfwAggregateSink sink{window,dispatchAggregateKey,dispatchAggregateButton};
    g_sourcePlaneAggregate.SubmitKey(GlfwSourcePlane::kLegacy,code,scan,static_cast<GlfwAggregateAction>(action),mods,sink);
}
void rawButton(void* window,int button,int action,int mods){
    GlfwAggregateSink sink{window,dispatchAggregateKey,dispatchAggregateButton};
    g_sourcePlaneAggregate.SubmitButton(GlfwSourcePlane::kLegacy,button,static_cast<GlfwAggregateAction>(action),mods,sink);
}
uint64_t now(){return static_cast<uint64_t>(std::chrono::duration_cast<std::chrono::nanoseconds>(std::chrono::steady_clock::now().time_since_epoch()).count());}
// UI/haptic 仅为观测出口；触发器、整组 dispatch、outputDown/toggle 判断均提取实际生产函数。
unsigned buttonFeedback=0,hapticFeedback=0;
void amcl_fire_button_pressed(const char*,int){++buttonFeedback;}
void schemaFireHaptic(int,const char*){++hapticFeedback;}
long long schemaNowNs(){return static_cast<long long>(now());}
constexpr long long SCHEMA_DOUBLETAP_NS=300000000LL,SCHEMA_LONGPRESS_NS=200000000LL;
OwnerToken nextOwnerToken(){return SourceNextNativeOwner();}
void schemaWakeDeadlineWorker(){}
@NATIVE_BUTTON@
void pump(GLFWwindow& window){inputBridgeStartPumping();inputBridgePumpEvents(&window);inputBridgeStopPumping();}
AmclSourceResultV1 transaction(const AmclSourceControlPortV1* port,uint64_t producer,AmclSourceRequestV1 request){
    request.size=sizeof(request);AmclSourceResultV1 result{};port->transact(producer,&request,&result);return result;
}
AmclSourceRequestV1 acquire(int source,const char* control,const std::vector<int>& codes){
    AmclSourceRequestV1 request{};request.operation=AMCL_SOURCE_ACQUIRE;request.source=source;
    std::strcpy(request.control,control);request.count=static_cast<uint32_t>(codes.size());
    for(uint32_t i=0;i<request.count;++i)request.outputs[i]={codes[i]>=0?0u:1u,codes[i]>=0?codes[i]:-codes[i]-1};return request;
}
AmclSourceResultV1 release(const AmclSourceControlPortV1* port,uint64_t producer,uint64_t owner){
    AmclSourceRequestV1 request{};request.operation=AMCL_SOURCE_RELEASE;request.owner=owner;return transaction(port,producer,request);
}
int main(){
    const auto* core=amclInputGetHostApiV1();CHECK(amclInputHostDescriptorPublishV1(core)==0);
    // 当前生产callback解析早期公布的唯一owner，夹具也必须执行实际预线程发布，不能借本地getter绕过。
    amclControlDeliveryPublishV1();amclLookExecutionPublishV1();
    const AmclLookExecutionPortV1* publishedLook=nullptr;CHECK(amclLookExecutionResolveV1(&publishedLook)==0);
    // 冷缺 source 明确未准入；随后仅预线程 publish，prepare 不加载 Java/game 类。
    CHECK(amclSourceControlPrepareV1()==0);amclSourceControlPublishV1();CHECK(amclSourceControlPrepareV1()==1);
    const AmclSourceControlPortV1* source=nullptr;CHECK(amclSourceControlResolveV1(&source)==0);
    uint64_t producer=0;CHECK(source->openProducer(AMCL_SOURCE_ENTRY,&producer)==0&&producer);
    // 冷连接完整核Core，成功后只复用进程pin的原表，不把发现运输当成运行资源。
    // Clear的公开合同不撤销已借指针；它必须阻断新的握手，但不能令原连接每事件读盘。
#ifdef AMCL_SOURCE_RESOLVE_COUNT_TEST
    sourceResolveCalls=0;
#endif
    const auto firstNative=SourceNextNativeOwner();CHECK(firstNative);
#ifdef AMCL_SOURCE_RESOLVE_COUNT_TEST
    CHECK(sourceResolveCalls==1);sourceResolveCalls=0;
#endif
    (void)SourceSnapshot();
#ifdef AMCL_SOURCE_RESOLVE_COUNT_TEST
    CHECK(sourceResolveCalls==0);sourceResolveCalls=0;
#endif
    CHECK(amclInputHostDescriptorClearV1()==0);
    const AmclSourceControlPortV1* coldSource=nullptr;
    CHECK(amclSourceControlResolveV1(&coldSource)<0&&!coldSource);
    AmclSourceRequestV1 coldRequest{};coldRequest.size=sizeof(coldRequest);coldRequest.operation=AMCL_SOURCE_ISSUE_NATIVE;
    AmclSourceResultV1 coldResult{};
    CHECK(amclSourceControlTransactPreparedV1(AMCL_SOURCE_ENTRY,&coldRequest,&coldResult)<0&&!coldResult.accepted);
    CHECK(SourceNextNativeOwner()==firstNative+1);
    CHECK(amclInputHostDescriptorPublishV1(core)==0);CHECK(SourceNextNativeOwner()==firstNative+2);
#ifndef _WIN32
    // 已连接父进程的表/句柄不能在fork子进程复用。alarm界定失败，不能让继承锁死等。
    const pid_t child=fork();CHECK(child>=0);
    if(child==0){alarm(2);_exit(SourceNextNativeOwner()==0?0:1);}
    int childStatus=0;CHECK(waitpid(child,&childStatus,0)==child&&WIFEXITED(childStatus)&&WEXITSTATUS(childStatus)==0);
#endif
    std::puts("SOURCE connection PASS: cold Core proof, warm query/transaction without re-resolution, cold withdrawal rejection, pinned borrow and fork fence");
    notifyOwner=source;notifyProducer=producer;
    uint64_t epoch=0;CHECK(core->beginSession(&epoch)==0&&core->publishFocus(1)==0);
    AmclInputSurfacePayload surface{};surface.active=1;surface.widthPx=1280;surface.heightPx=720;surface.density=1;
    surface.validFields=AMCL_INPUT_SURFACE_FIELD_ALL;surface.publicationGeneration=1;CHECK(core->publishSurface(&surface)==0);
    AmclInputEvent context{};context.header.abiVersion=1;context.header.structSize=sizeof(context);
    context.header.eventType=AMCL_INPUT_EVENT_SURFACE_CONTEXT_CHANGED;context.header.source=AMCL_INPUT_SOURCE_SYNTHETIC;
    context.payload.surfaceContext.generation=1;context.payload.surfaceContext.windowId=42;context.payload.surfaceContext.displayId=1;
    context.payload.surfaceContext.widthPx=1280;context.payload.surfaceContext.heightPx=720;context.payload.surfaceContext.density=1;
    context.payload.surfaceContext.validFields=AMCL_INPUT_SURFACE_CONTEXT_FIELD_WINDOW|AMCL_INPUT_SURFACE_CONTEXT_FIELD_DISPLAY|
        AMCL_INPUT_SURFACE_CONTEXT_FIELD_RECT|AMCL_INPUT_SURFACE_CONTEXT_FIELD_DENSITY|AMCL_INPUT_SURFACE_CONTEXT_FIELD_TRANSFORM;
    CHECK(core->submitEvent(&context)==0);CHECK(inputBridge_configureMenuCursorConsumerV1(1,1)==1);inputBridge_setInputReady(1);
    GLFWwindow window;window.cursorPosCb=moved;window.keyCb=deliveredKey;window.mouseButtonCb=deliveredButton;g_currentWindow=&window;
    inputBridge_glfwSetTargetV1(reinterpret_cast<uint64_t>(&window),1,42);inputBridge_glfwSetActive(&window,1);
    inputBridge_setKeyCallback(rawKey);inputBridge_setMouseButtonCallback(rawButton);
    inputBridge_setLookPrefixCallbackV1(bridgeLookPrefixCallback);g_sourcePlaneAggregate.BindTarget(42);
    // 实际text-only Core adapter登记Ready，不用host stub/表方法存在代替文字资格。
    GlfwInputAdapter textAdapter;GlfwInputSink textSink{};
    textSink.textCommit=typedTextCommitSink;(void)inputBridge_replaceCharCallback(reinterpret_cast<void*>(deliveredChar));
    CHECK(textAdapter.Open(core,GlfwOhosInputMapper(),textSink)==GlfwAdapterStatus::kOk);
    const auto pumpOwned=[&]{inputBridgeStartPumping();inputBridge_pumpOrdered(&window,
        [](void* c,uint64_t ceiling){return static_cast<GlfwInputAdapter*>(c)->Pump(0u,ceiling).status==GlfwAdapterStatus::kOk?1:0;},
        &textAdapter,UINT64_MAX);inputBridgeStopPumping();(void)glfwGetKey(&window,259);};
    const auto changeText=[&](uint64_t id,uint32_t change){AmclInputEvent event{};event.header.abiVersion=1;
        event.header.structSize=sizeof(event);event.header.eventType=AMCL_INPUT_EVENT_TEXT_SESSION_CHANGED;event.header.source=AMCL_INPUT_SOURCE_IME;
        AmclInputSnapshotV1 snapshot{};snapshot.abiVersion=1;snapshot.structSize=sizeof(snapshot);CHECK(core->getSnapshot(&snapshot)==0);
        event.header.sessionEpoch=snapshot.sessionEpoch;event.header.focusEpoch=snapshot.focusEpoch;event.header.surfaceEpoch=snapshot.surfaceEpoch;
        event.payload.textSession.textSessionId=id;event.payload.textSession.change=change;event.payload.textSession.reason=AMCL_INPUT_TEXT_SESSION_REASON_EXPLICIT;
        CHECK(core->submitEvent(&event)==0);};
    for(unsigned i=0;i<64;++i){const auto baseline=textAdapter.Pump();CHECK(baseline.status==GlfwAdapterStatus::kOk);if(!baseline.eventsDrained)break;}
    AmclInputEvent textStart{};textStart.header.abiVersion=1;textStart.header.structSize=sizeof(textStart);
    textStart.header.eventType=AMCL_INPUT_EVENT_TEXT_SESSION_CHANGED;textStart.header.source=AMCL_INPUT_SOURCE_IME;
    textStart.payload.textSession.change=AMCL_INPUT_TEXT_SESSION_STARTED;textStart.payload.textSession.textSessionId=700;
    textStart.payload.textSession.reason=AMCL_INPUT_TEXT_SESSION_REASON_EXPLICIT;
    AmclInputSnapshotV1 textSnapshot{};textSnapshot.abiVersion=1;textSnapshot.structSize=sizeof(textSnapshot);
    CHECK(core->getSnapshot(&textSnapshot)==0);textStart.header.sessionEpoch=textSnapshot.sessionEpoch;
    textStart.header.focusEpoch=textSnapshot.focusEpoch;textStart.header.surfaceEpoch=textSnapshot.surfaceEpoch;
    CHECK(core->submitEvent(&textStart)==0);AmclInputTextCoreResourceV1 textResource{};
    CHECK(amclInputOwnerReadTextResourceV1(&textResource)==1);AmclSourceResultV1 textTap{};
    source->ownedTextKeyTap(producer,700,textResource.scope,259,&textTap);
    CHECK(textTap.accepted&&textTap.transportAccepted&&textTap.finalEdges==2);
    for(int i=0;i<4;++i){pump(window);(void)glfwGetKey(&window,259);}
    CHECK((ownedKeyEdges==std::vector<int>{1,0})&&glfwGetKey(&window,259)==0);
    textStart.payload.textSession.change=AMCL_INPUT_TEXT_SESSION_ENDED;CHECK(core->submitEvent(&textStart)==0);
    source->ownedTextKeyTap(producer,700,textResource.scope,259,&textTap);CHECK(!textTap.accepted);
    pump(window);CHECK(ownedKeyEdges.size()==2&&glfwGetKey(&window,259)==0);delivery.clear();
    // 原pair在END之前已整批接入；共同生产pumpOrdered将真实text adapter与ring合并。
    // 只观察实际char callback/key cache，不把producer current改绑已接受的命令。
    textStart.payload.textSession.change=AMCL_INPUT_TEXT_SESSION_STARTED;CHECK(core->submitEvent(&textStart)==0);
    CHECK(amclInputOwnerReadTextResourceV1(&textResource)==1);source->ownedTextKeyTap(producer,700,textResource.scope,259,&textTap);
    CHECK(textTap.accepted);AmclInputEvent commit{};commit.header=textStart.header;commit.header.eventType=AMCL_INPUT_EVENT_TEXT_COMMIT;
    commit.payload.textCommit.textSessionId=700;const uint8_t oldText[]={'o'},newText[]={'n'};
    CHECK(core->submitTextPacket(&commit,oldText,1)==0);
    textStart.payload.textSession.change=AMCL_INPUT_TEXT_SESSION_ENDED;CHECK(core->submitEvent(&textStart)==0);
    textStart.payload.textSession.change=AMCL_INPUT_TEXT_SESSION_STARTED;textStart.payload.textSession.textSessionId=701;CHECK(core->submitEvent(&textStart)==0);
    commit.payload.textCommit.textSessionId=701;CHECK(core->submitTextPacket(&commit,newText,1)==0);
    observingOwnedBoundary=true;for(int i=0;i<4;++i)pumpOwned();observingOwnedBoundary=false;
    CHECK((ownedBoundary==std::vector<int>{1,2,3,4})&&glfwGetKey(&window,259)==0);
    source->ownedTextKeyTap(producer,700,textResource.scope,259,&textTap);CHECK(!textTap.accepted);
    std::puts("PASS GLFW accepted owned pair/old commit/END/newscope through real ordered pump+char callback");delivery.clear();
    changeText(701,AMCL_INPUT_TEXT_SESSION_ENDED);
    for(uint32_t boundary:{AMCL_INPUT_TEXT_SESSION_ABORTED,AMCL_INPUT_TEXT_SESSION_ENDED}){
        changeText(702,AMCL_INPUT_TEXT_SESSION_STARTED);CHECK(amclInputOwnerReadTextResourceV1(&textResource)==1);
        source->ownedTextKeyTap(producer,702,textResource.scope,259,&textTap);CHECK(textTap.accepted);ownedKeyEdges.clear();
        if(boundary==AMCL_INPUT_TEXT_SESSION_ABORTED)changeText(702,boundary);else CHECK(core->publishFocus(0)==0);
        for(int i=0;i<4;++i)pumpOwned();CHECK((ownedKeyEdges==std::vector<int>{1,0})&&glfwGetKey(&window,259)==0);
        source->ownedTextKeyTap(producer,702,textResource.scope,259,&textTap);CHECK(!textTap.accepted);
        if(boundary==AMCL_INPUT_TEXT_SESSION_ENDED){CHECK(core->publishFocus(1)==0);pumpOwned();}
    }
    std::puts("PASS GLFW accepted before actual ABORT/focus late callback/poll final UP and old scope refusal");delivery.clear();
    // 原公开 JNI 函数通过完整生产 bridge TU 调用，触控/手柄 cohold 不被 compat UP 盖掉。
    for(int code:{65,-1}){
        const auto touch=transaction(source,producer,acquire(1,"touch",{code}));CHECK(touch.accepted&&touch.owner);pump(window);
        const auto gamepad=transaction(source,producer,acquire(2,"gamepad",{code}));CHECK(gamepad.accepted&&gamepad.finalEdges==0);
        if(code>=0){Java_org_lwjgl_glfw_CallbackBridge_nativeSendKey(nullptr,nullptr,code,123,1,0);
            Java_org_lwjgl_glfw_CallbackBridge_nativeSendKey(nullptr,nullptr,code,123,0,0);}
        else {Java_org_lwjgl_glfw_CallbackBridge_nativeSendMouseButton(nullptr,nullptr,0,1,0);
            Java_org_lwjgl_glfw_CallbackBridge_nativeSendMouseButton(nullptr,nullptr,0,0,0);}
        pump(window);CHECK(code>=0?glfwGetKey(&window,code)==1:glfwGetMouseButton(&window,0)==1);
        CHECK(release(source,producer,touch.owner).accepted);pump(window);CHECK(code>=0?glfwGetKey(&window,code)==1:glfwGetMouseButton(&window,0)==1);
        CHECK(release(source,producer,gamepad.owner).accepted);pump(window);CHECK(code>=0?glfwGetKey(&window,code)==0:glfwGetMouseButton(&window,0)==0);
    }
    // 无配对 UP/REPEAT 不借别人 token；兼容0重复 DOWN 与 NAPI0模拟端口共用同一份。
    const auto held=transaction(source,producer,acquire(1,"held",{66}));CHECK(held.accepted);pump(window);
    Java_org_lwjgl_glfw_CallbackBridge_nativeSendKey(nullptr,nullptr,66,0,0,0);
