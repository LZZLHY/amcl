// 渲染设备与资源管理器为系统边界替身；@PRODUCTION@位置插入完整生产函数正文。
// 本实验只证明呈现结果沿Vulkan→BackendObject→EGL→序列传播，不冒充GPU渲染测试。
#include "@ROOT@/prebuilt/mobilegl/src/MobileGL/MG_Backend/PresentationResult.h"
#include <cstdint>
#include <map>
#include <mutex>
#include <string>
#include <vector>
#include <iostream>
#include <stdexcept>
#include <optional>
#include <algorithm>
#include <span>
#define MGLOG_D(...) ((void)0)
#define MGLOG_E(...) ((void)0)
#define MGLOG_E_ONCE(...) ((void)0)
#define MGLOG_I(...) ((void)0)
#define VK_VERIFY(value, ...) do { if((value)!=VK_SUCCESS) throw std::runtime_error("driver rejected"); } while(0)
#define MOBILEGL_ASSERT(value, ...) do { if (!(value)) throw std::runtime_error("renderer invariant"); } while (0)
#define CHECK(value) do { if (!(value)) throw std::runtime_error(#value); } while (0)
using Bool=bool; using Uint64=uint64_t; using VkResult=int32_t;
using Int=int;using Uint32=uint32_t;using NativeWindowType=uintptr_t;using VkBool32=uint32_t;using VkPresentModeKHR=int;
using RuntimeError=std::runtime_error;
template<class T>using Vector=std::vector<T>;
template<class T>using Optional=std::optional<T>;
constexpr auto Nullopt=std::nullopt;
constexpr int VK_PRESENT_MODE_IMMEDIATE_KHR=0,VK_PRESENT_MODE_MAILBOX_KHR=1,VK_PRESENT_MODE_FIFO_KHR=2,VK_PRESENT_MODE_FIFO_RELAXED_KHR=3;
constexpr int VK_FALSE=0,VK_STRUCTURE_TYPE_SEMAPHORE_CREATE_INFO=1,VK_STRUCTURE_TYPE_FENCE_CREATE_INFO=2,VK_FENCE_CREATE_SIGNALED_BIT=1;
struct VkSemaphoreCreateInfo {int type;};struct VkFenceCreateInfo {int type,flags=0;};
using EGLDisplay=uintptr_t; using EGLSurface=uintptr_t; using EGLContext=uintptr_t; using EGLBoolean=int;
constexpr auto EGL_NO_SURFACE=0u,EGL_NO_CONTEXT=0u;
constexpr auto EGL_FALSE=0,EGL_TRUE=1,EGL_SUCCESS=0x3000,EGL_BAD_SURFACE=0x300d,EGL_CONTEXT_LOST=0x300e;
constexpr auto VK_NULL_HANDLE=0,VK_SUCCESS=0,VK_SUBOPTIMAL_KHR=1000001003,VK_ERROR_OUT_OF_DATE_KHR=-1000001004;
constexpr auto VK_ERROR_SURFACE_LOST_KHR=-1000000000,VK_ERROR_DEVICE_LOST=-4,VK_IMAGE_LAYOUT_PRESENT_SRC_KHR=1000001002;
namespace driver {
VkResult submit=VK_SUCCESS,present=VK_SUCCESS,acquire=VK_SUCCESS;
bool recreate=true, resize=false;
unsigned submissions=0,presents=0;
bool surfaceSupported=true;
}
VkResult vkQueueSubmit(int,int,const int*,int){++driver::submissions;return driver::submit;}
VkResult vkQueuePresentKHR(int,const int*){++driver::presents;return driver::present;}
// 下列仅替换GPU/窗口边界，完整切换与模式决策始终来自生产函数。
VkResult vkDeviceWaitIdle(int){return 0;}
VkResult vkGetPhysicalDeviceSurfaceSupportKHR(int,Uint32,int,VkBool32* value){*value=driver::surfaceSupported;return 0;}
void vkDestroySurfaceKHR(int,int,void*){}void vkDestroySemaphore(int,int,void*){}void vkDestroyFence(int,int,void*){}
VkResult vkCreateSemaphore(int,const VkSemaphoreCreateInfo*,void*,int* value){*value=1;return 0;}
VkResult vkCreateFence(int,const VkFenceCreateInfo*,void*,int* value){*value=1;return 0;}
namespace MobileGL::MG_Backend::DirectVulkan {
struct SwapchainObject {
    @RANKING@
    static VkPresentModeKHR ChooseSwapchainPresentMode(const Vector<VkPresentModeKHR>&,Optional<Int>);
};
@CHOOSE_MODE@
struct Frame { bool isCommandRecording=true,hasCommandBufferRecorded=false,hasPreCommandBufferRecorded=false;
    int commandBuffer=1,imageInFlightFence=2,imageAvailableSemaphore=1;uint64_t lastSubmitIndex=0; };
struct Frames {
    Frame frame;
    struct Submit {int submitInfo=0;};struct Present {int presentInfo=0;};
    Frame& GetCurrent(){return frame;}
    void EndCommandRecording(){} void AbandonPreCommandRecording(){} void EndPreCommandRecordingIfOpen(){}
    VkResult WaitAndAcquireNextImage(int,int,unsigned&){return driver::acquire;}
    void TransitionToPresent(int,int){}
    Submit GetSubmitInfo(bool,unsigned){return {};}
    Present GetPresentInfo(int,unsigned){return {};}
    void AdvanceToNext(){} unsigned GetCurrentFrameIndex(){return 0;}
};
struct Swapchain {
    int handle=1;
    VkPresentModeKHR mode=VK_PRESENT_MODE_MAILBOX_KHR;
    Vector<VkPresentModeKHR> modes{0,1,2,3};
    const auto& GetSupportedPresentModes()const{return modes;}
    VkPresentModeKHR GetPresentMode()const{return mode;}
    int GetHandle() const{return handle;}unsigned GetImageCount() const{return 1;}
    int GetImageLayout(unsigned){return 0;}int GetImage(unsigned){return 1;}
    void SetImageLayout(unsigned,int){}void SetImageContentDefined(unsigned,bool){}void SetAllDepthStencilContentUndefined(){}
};
struct VkRenderPassManager {
    static VkRenderPassManager* GetActiveRenderPass(){return nullptr;}
    static void EndRenderPass(int){}void OnPresent(){}
};
struct Factory {int OnFrameBoundary(){return 0;}void FlushPendingUploads(){}void BeginFrame(unsigned){};};
struct {bool graphicsPipelineValid=false;} g_dynamicStateShadow;
class VulkanRenderer {
public:
    Swapchain m_swapchainObject;Frames m_frameContext;
    bool m_presentSuspended=false,m_swapchainResizeRequested=false;
    bool m_presentsToAppWindow=true;unsigned rebuilds=0;
    Optional<Int> m_swapchainSwapInterval;
    struct {Optional<Int> SwapInterval;Uint32 SurfaceWidth=1,SurfaceHeight=1;} m_config;
    NativeWindowType m_window=10;int m_surface=10,m_instance=1;
    struct {int handle=1;struct {int presentFamily=0;} queueFamilies;} m_physicalDevice;
    unsigned m_imageIndexAcquired=0;
    int m_device=1,m_graphicsQueue=2,m_presentQueue=3,m_drainsSinceLastPresent=0;
    uint64_t m_submitCounter=0;
    VkRenderPassManager renderPass;
    Factory factory,m_bufferManager;
    VkRenderPassManager* m_renderPassManager=&renderPass;
    Factory *m_programFactory=&factory,*m_pipelineFactory=&factory,*m_vertexInputStateFactory=&factory,
        *m_samplerManager=&factory,*m_textureManager=&factory,*m_uniformManager=&factory;
    std::vector<int> m_convertedVertexStreams;
    bool RecreateSwapchain(){++rebuilds;if(driver::recreate){m_swapchainObject.handle=1;
        m_swapchainObject.mode=SwapchainObject::ChooseSwapchainPresentMode(m_swapchainObject.modes,m_config.SwapInterval);
        m_swapchainSwapInterval=m_config.SwapInterval;}return driver::recreate;}
    void FlushPendingCommands(){}void CreateSurface(){m_surface=20;if(!m_window)m_window=500;}
    void ShutdownSwapchain(){m_swapchainObject.handle=0;}
    void RequestSwapchainResize(Uint32,Uint32){m_swapchainResizeRequested=true;}
    bool SwapchainIsOutOfDate(){return driver::resize;}
    void InvalidatePipelineMemo(){}void InvalidateSetupDrawSnapshots(){}void TryDrainFrameTransients(){}
    void RegisterSubmit(int,bool){++m_submitCounter;}
    void OnSubmitsCompletedUpTo(uint64_t){}void CollectDeferredDepthMipmapCleanup(unsigned){}
    PresentationResult Present();
    void SetSwapInterval(Int);
    Bool RetargetOhosSurface(NativeWindowType,Uint32,Uint32,Optional<Int>);
};
@VULKAN_PRESENT@
@RENDERER_INTERVAL@
@RETARGET@
VulkanRenderer* active=nullptr;
auto& pVulkanRenderer=active;
Optional<Int> g_requestedSwapInterval;
@DIRECT_INTERVAL@
PresentationResult actualPresent(){return active->Present();}
}
namespace MobileGL::MG_Backend {
int CurrentThreadKey(){return 1;}
struct Functions {PresentationResult(*Present)()=&DirectVulkan::actualPresent;void(*SetSwapInterval)(Int)=&DirectVulkan::SetSwapInterval;};
class BackendObject {
    std::recursive_mutex m_eglStateMutex;
    bool m_eglDisplayInitialized=true,m_eglSurfaceInitialized=true;
    EGLDisplay m_eglDisplay=1;EGLSurface m_eglSurface=1;
    struct Current {EGLDisplay Display;EGLSurface DrawSurface;EGLContext Context;};
    std::map<int,Current> m_eglCurrentThreads{{1,{1,1,1}}};
    Functions functions;
public:
    const Functions& GetBackendFunctions(){return functions;}
    PresentationResult SwapEGLBuffers(EGLDisplay,EGLSurface);
    void SetEGLSwapInterval(Int);
};
@BACKEND_SWAP@
@BACKEND_INTERVAL@
}
namespace MobileGL::MG_Impl::EGLImpl {
thread_local std::uint64_t presentedSequence=0;
struct State {int error=EGL_SUCCESS;bool ValidateSurfaceOnDisplay(EGLDisplay,EGLSurface){return true;}void SetError(int value){error=value;}} state;
State* GetState(){return &state;}
MG_Backend::BackendObject backend;
MG_Backend::BackendObject* GetBackendObject(State*){return &backend;}
std::recursive_mutex& EGLOperationMutex(){static std::recursive_mutex value;return value;}
@EGL_SWAP@
@SEQUENCE@
}
int main() try {
    using namespace MobileGL::MG_Backend::DirectVulkan;
    using namespace MobileGL::MG_Impl::EGLImpl;
    struct Case {const char* name;bool initial, recreate, resize;VkResult submit,present,acquire;bool success,actual;int error;};
    const Case cases[]={
        {"presented",true,true,false,0,0,0,true,true,EGL_SUCCESS},
        {"zero-area",false,false,false,0,0,0,true,false,EGL_SUCCESS},
        {"outdated-suspended",true,false,false,0,VK_ERROR_OUT_OF_DATE_KHR,0,true,false,EGL_SUCCESS},
        {"outdated-rebuilt",true,true,false,0,VK_ERROR_OUT_OF_DATE_KHR,0,true,false,EGL_SUCCESS},
        {"surface-lost",true,true,false,0,VK_ERROR_SURFACE_LOST_KHR,0,false,false,EGL_BAD_SURFACE},
        {"device-lost",true,true,false,0,VK_ERROR_DEVICE_LOST,0,false,false,EGL_CONTEXT_LOST},
        {"submit-failed",true,true,false,VK_ERROR_DEVICE_LOST,0,0,false,false,EGL_CONTEXT_LOST},
        {"suboptimal",true,true,false,0,VK_SUBOPTIMAL_KHR,0,true,true,EGL_SUCCESS},
        {"next-acquire-failed",true,true,false,0,0,VK_ERROR_DEVICE_LOST,false,true,EGL_CONTEXT_LOST},
        {"present-then-suspend",true,false,true,0,0,0,true,true,EGL_SUCCESS}
    };
    for(const auto& test:cases){
        VulkanRenderer renderer;active=&renderer;renderer.m_swapchainObject.handle=test.initial?1:0;
        driver::recreate=test.recreate;driver::resize=test.resize;driver::submit=test.submit;
        driver::present=test.present;driver::acquire=test.acquire;driver::submissions=driver::presents=0;
        state.error=EGL_SUCCESS;const auto before=PresentedSequence();
        CHECK((SwapBuffers(1,1)==EGL_TRUE)==test.success);
        CHECK((PresentedSequence()>before)==test.actual);CHECK(state.error==test.error);
        std::cout<<test.name<<": egl="<<test.success<<" actual="<<test.actual<<" error="<<state.error<<'\n';
    }
    // 真实上游选择策略、后端请求转发和完整Present只在实际模式变化时重建。
    driver::recreate=true;driver::resize=false;driver::submit=driver::present=driver::acquire=0;
    CHECK(SwapchainObject::ChooseSwapchainPresentMode({0,1,2,3},Nullopt)==1);
    CHECK(SwapchainObject::ChooseSwapchainPresentMode({0,1,2,3},0)==0);
    CHECK(SwapchainObject::ChooseSwapchainPresentMode({1,2},0)==1);
    CHECK(SwapchainObject::ChooseSwapchainPresentMode({2},0)==2);
    CHECK(SwapchainObject::ChooseSwapchainPresentMode({0,1,2,3},-1)==3);
    CHECK(SwapchainObject::ChooseSwapchainPresentMode({1,2},-1)==2);
    VulkanRenderer renderer;active=&renderer;
    backend.SetEGLSwapInterval(1);CHECK(g_requestedSwapInterval==1);
    CHECK(renderer.rebuilds==0);CHECK(SwapBuffers(1,1));CHECK(renderer.m_swapchainObject.mode==2&&renderer.rebuilds==1);
    backend.SetEGLSwapInterval(2);CHECK(SwapBuffers(1,1));CHECK(renderer.rebuilds==1);
    backend.SetEGLSwapInterval(0);CHECK(SwapBuffers(1,1));CHECK(renderer.m_swapchainObject.mode==0&&renderer.rebuilds==2);
    CHECK(SwapBuffers(1,1));CHECK(renderer.rebuilds==2);
    // OHOS真实retarget方法：fallback窗口指针非空也不能成为应用窗口，后台请求保留至恢复。
    CHECK(renderer.RetargetOhosSurface(0,1,1,Nullopt));
    CHECK(!renderer.m_presentsToAppWindow&&!renderer.m_config.SwapInterval);
    backend.SetEGLSwapInterval(1);CHECK(g_requestedSwapInterval==1&&!renderer.m_config.SwapInterval);
    CHECK(renderer.RetargetOhosSurface(11,1280,720,g_requestedSwapInterval));
    CHECK(renderer.m_presentsToAppWindow&&renderer.m_config.SwapInterval==1&&renderer.m_swapchainObject.mode==2);
    driver::surfaceSupported=false;bool rejected=false;
    try{renderer.RetargetOhosSurface(0,1,1,Nullopt);}catch(const std::exception&){rejected=true;}
    CHECK(rejected&&renderer.m_window==11&&renderer.m_presentsToAppWindow&&renderer.m_config.SwapInterval==1);
    std::cout<<"PASS upstream present-mode selection, deferred/equivalent-mode rebuilds and OHOS park/restore/failure\n";
    std::cout<<"MobileGL actual-present propagation PASS: production renderer/backend/EGL/sequence\n";
    return 0;
}catch(const std::exception& e){std::cerr<<e.what()<<'\n';return 1;}
